-- =========================================================
-- KEYBINDS
-- =========================================================

local function RegisterKeybind(label, key, holder)
    table.insert(Keybinds, { label = label, key = key, holder = holder })
end

RegisterKeybind("Hitbox Expand",  Enum.KeyCode.H, hbHolder)
RegisterKeybind("ESP",            Enum.KeyCode.E, espHolder)
RegisterKeybind("Auto Hit",       Enum.KeyCode.G, autoHitHolder)
RegisterKeybind("Aimbot",         Enum.KeyCode.F, aimHolder)
RegisterKeybind("Speed",          Enum.KeyCode.X, speedHolder)
RegisterKeybind("Infinite Jump",  Enum.KeyCode.J, infJumpHolder)
RegisterKeybind("Anti Ragdoll",   Enum.KeyCode.R, antiRagdollHolder)

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    for _, bind in ipairs(Keybinds) do
        if input.KeyCode == bind.key then
            local h = bind.holder
            if h and h.toggle then
                h.toggle.Set(not h.toggle.Get())
            end
            break
        end
    end
end)

