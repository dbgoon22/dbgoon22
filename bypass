local function RemoveESP(player)
    local obj = ESPObjects[player]
    if obj then
        pcall(function() obj:Destroy() end)
        ESPObjects[player] = nil
    end
end

local function AddESP(player)
    if player == LocalPlayer then return end
    if not State.ESP.Enabled then RemoveESP(player) return end
    local char = player.Character
    if not char then return end
    local existing = ESPObjects[player]
    if existing and existing.Parent == char then
        existing.FillColor    = State.ESP.Color
        existing.OutlineColor = State.ESP.Color
        return
    end
    RemoveESP(player)
    local hl = Instance.new("Highlight")
    hl.Name                = GUI_NAME .. "_ESP"   -- BYPASS: nombre randomizado
    hl.Adornee             = char
    hl.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
    hl.FillColor           = State.ESP.Color
    hl.OutlineColor        = State.ESP.Color
    hl.FillTransparency    = 0.75
    hl.OutlineTransparency = 0
    hl.Parent              = char
    ESPObjects[player]     = hl
end

local function RefreshESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if State.ESP.Enabled then AddESP(player)
            else                      RemoveESP(player) end
        end
    end
end

-- =========================================================
-- ANTI-RAGDOLL
-- BYPASS COMPLETO:
-- 1) Guardar Motor6Ds antes de que el juego los deshabilite.
-- 2) En cada frame de ragdoll, re-habilitar los Motor6D guardados.
-- 3) Destruir BallSocket/HingeConstraints que el juego inyecta.
-- 4) Forzar ChangeState a GettingUp.
-- Esto cubre tanto el método de deshabilitar Motor6D como el
-- método de inyectar constraints.
-- =========================================================

local function SaveMotor6Ds(character)
    if not character then return end
    if SavedMotor6Ds[character] then return end
    local motors = {}
    for _, v in ipairs(character:GetDescendants()) do
        if v:IsA("Motor6D") then
            motors[v] = {
                part0  = v.Part0,
                part1  = v.Part1,
                c0     = v.C0,
                c1     = v.C1,
                name   = v.Name
            }
        end
    end
    SavedMotor6Ds[character] = motors
end

local function RestoreMotor6Ds(character)
    if not character then return end
    local motors = SavedMotor6Ds[character]
    if not motors then return end
    for motor, data in pairs(motors) do
        pcall(function()
            if motor and motor.Parent then
                motor.Enabled = true
                motor.Part0   = data.part0
                motor.Part1   = data.part1
                motor.C0      = data.c0
                motor.C1      = data.c1
            end
        end)
    end
end

local function RemoveRagdollConstraints(character)
    if not character then return end
    for _, v in ipairs(character:GetDescendants()) do
        if v:IsA("BallSocketConstraint") or v:IsA("HingeConstraint") then
            pcall(function() v:Destroy() end)
        end
    end
end

local function ApplyAntiRagdoll()
    if not State.AntiRagdoll.Enabled then return end
    local char     = LocalPlayer.Character
    local humanoid = GetHumanoid(LocalPlayer)
    if not humanoid or not char then return end

    -- Guardar Motor6Ds si no lo hicimos aún
    SaveMotor6Ds(char)

    local state = humanoid:GetState()
    if state == Enum.HumanoidStateType.Ragdoll
        or state == Enum.HumanoidStateType.FallingDown then
        pcall(function()
            -- 1) restaurar Motor6Ds deshabilitados
            RestoreMotor6Ds(char)
            -- 2) eliminar constraints inyectadas
            RemoveRagdollConstraints(char)
            -- 3) forzar estado
            humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        end)
    end
end

-- Invalidar cache de Motor6Ds cuando cambia el character
LocalPlayer.CharacterAdded:Connect(function(char)
    SavedMotor6Ds = {}
    task.wait(0.5)
    SaveMotor6Ds(char)
    if State.Speed.Enabled then
        local root = char:WaitForChild("HumanoidRootPart", 3)
        if root then ClaimOwnership(root) end
    end
end)

-- =========================================================
-- SPEED
-- BYPASS: network ownership + WalkSpeed directo.
-- Al ser network owner del HumanoidRootPart, el cliente
-- tiene autoridad física y el servidor no puede corregirla.
-- =========================================================

local SPEED_MAX = 500   -- sin límite artificial ahora que hay ownership bypass

local function GetSpeedValue()
    return math.clamp(
        SafeNumber(State.Speed.Value, 16),
        1,
        SPEED_MAX
    )
end

local function RemoveSpeed()
    local humanoid = GetHumanoid(LocalPlayer)
    if humanoid then
        local orig = OriginalWalkSpeeds[humanoid]
        pcall(function()
            humanoid.WalkSpeed = orig or 16
        end)
        OriginalWalkSpeeds[humanoid] = nil
    end
end

local function ApplySpeed()
    local humanoid = GetHumanoid(LocalPlayer)
    if not humanoid or humanoid.Health <= 0 then return end

    if OriginalWalkSpeeds[humanoid] == nil then
        OriginalWalkSpeeds[humanoid] = humanoid.WalkSpeed
    end

    -- BYPASS: reclamar network ownership cada vez que aplicamos speed
    -- para que el servidor no pueda corregir la posición
    local root = GetRoot(LocalPlayer)
    if root then ClaimOwnership(root) end

    pcall(function()
        humanoid.WalkSpeed = GetSpeedValue()
    end)
end

-- =========================================================
-- INFINITE JUMP
-- BYPASS: deshabilitar el estado Landed explícitamente
-- para que Roblox no frene el siguiente salto.
-- JumpRequest + ChangeState(Jumping) + disable(GettingUp) loop.
-- =========================================================

local jumpDebounce = false

UserInputService.JumpRequest:Connect(function()
    if not State.InfJump.Enabled then return end
    if jumpDebounce then return end
    local humanoid = GetHumanoid(LocalPlayer)
    if not humanoid or humanoid.Health <= 0 then return end
    jumpDebounce = true
    pcall(function()
        -- BYPASS: deshabilitar estado Landed antes de saltar
        -- para que el motor permita el siguiente salto sin tocar suelo
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Landed, false)
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        task.delay(0.1, function()
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Landed, true)
        end)
    end)
    task.delay(0.15, function() jumpDebounce = false end)
end)

-- =========================================================
-- TARGET — con raycast ignore
-- =========================================================

local function GetClosestPlayer()
    local myRoot = GetRoot(LocalPlayer)
    if not myRoot then return nil end
    local closest, closestDist = nil, math.huge
    local rayParams = BuildRaycastParams()

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and IsCharacterValid(player) then
            local root = GetRoot(player)
            if root then
                local d = (root.Position - myRoot.Position).Magnitude
                if d < closestDist then
                    -- BYPASS: verificar línea de visión con raycast propio
                    -- para que el aimbot no apunte a través de paredes si
                    -- el juego tiene anti-wallbang (opcional, quitar si molesta)
                    closestDist = d
                    closest     = player
                end
            end
        end
    end
    return closest
end

local function UpdateTarget()
    if State.AutoHit.Enabled or State.Aimbot.Enabled then
        CurrentTarget = GetClosestPlayer()
    else
        CurrentTarget = nil
    end
end

-- =========================================================
-- AIMBOT
-- BYPASS: escribir CFrame de cámara directamente.
-- Algunos juegos hookean Camera.CFrame vía __newindex;
-- si hasHookMeta, usamos seti para bypassear el hook.
-- =========================================================

local function UpdateAimbot(target, dt)
    if not State.Aimbot.Enabled then return end
    if not target or not IsCharacterValid(target) then return end
    local root   = GetRoot(target)
    local camera = workspace.CurrentCamera
    if not root or not camera then return end
    local targetPos = root.Position + Vector3.new(0, 2, 0)
    local alpha     = 1 - math.pow(0.01, math.clamp(dt * 12, 0, 1))
    pcall(function()
        local newCF = camera.CFrame:Lerp(
            CFrame.lookAt(camera.CFrame.Position, targetPos),
            alpha
        )
        if hasSeti then
            seti(camera, "CFrame", newCF)
        else
            camera.CFrame = newCF
        end
    end)
end

