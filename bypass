-- =========================================================
-- UTILITIES
-- =========================================================

local function GetCharacter(player)
    return player and player.Character
end

local function GetRoot(player)
    local char = GetCharacter(player)
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function GetHumanoid(player)
    local char = GetCharacter(player)
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function IsCharacterValid(player)
    if not player or not player.Parent then return false end
    local humanoid = GetHumanoid(player)
    local root     = GetRoot(player)
    return humanoid ~= nil
        and root    ~= nil
        and humanoid.Health > 0
end

local function SafeNumber(value, fallback)
    local n = tonumber(value)
    if not n or n ~= n or math.abs(n) == math.huge then
        return fallback
    end
    return n
end

-- =========================================================
-- BYPASS: RAYCAST IGNORE LIST
-- Agrega el propio character al RaycastParams.FilterDescendantsInstances
-- para que el raycast del finder no levante flags de "hit self".
-- También excluye a otros exploiters conocidos con hitbox inflada.
-- =========================================================

local function BuildRaycastParams()
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local ignore = {}
    -- ignorar propio character
    if LocalPlayer.Character then
        table.insert(ignore, LocalPlayer.Character)
    end
    -- ignorar hitboxes infladas (si el character de otro player tiene Size > 5 en root)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local r = p.Character:FindFirstChild("HumanoidRootPart")
            if r and r.Size.X > 5 then
                -- es hitbox de cheat, no obstaculizar nuestro raycast
                table.insert(ignore, p.Character)
            end
        end
    end
    params.FilterDescendantsInstances = ignore
    return params
end

-- =========================================================
-- HITBOX
-- BYPASS: modificamos Size solo localmente vía pcall.
-- No llamamos a ningún RemoteEvent. El servidor ve el HRP
-- normal; nosotros localmente detectamos hits en un volumen mayor.
-- =========================================================

local function GetHitboxSize()
    return math.clamp(SafeNumber(State.Hitbox.Size, 10), 1, 100)
end

local function SaveOriginalSize(player)
    if player == LocalPlayer then return end
    local root = GetRoot(player)
    if root and OriginalSizes[player] == nil then
        OriginalSizes[player] = root.Size
    end
end

local function ApplyHitbox(player)
    if player == LocalPlayer then return end
    local root = GetRoot(player)
    if not root then return end
    SaveOriginalSize(player)
    pcall(function()
        local s = GetHitboxSize()
        -- BYPASS: usar seti si disponible para evitar __newindex hooks del juego
        if hasSeti then
            seti(root, "Size", Vector3.new(s, s, s))
        else
            root.Size = Vector3.new(s, s, s)
        end
        root.CanCollide = false
    end)
end

local function RestoreHitbox(player)
    if player == LocalPlayer then return end
    local root     = GetRoot(player)
    local original = OriginalSizes[player]
    if root and original then
        pcall(function()
            if hasSeti then
                seti(root, "Size", original)
            else
                root.Size = original
            end
        end)
    end
    OriginalSizes[player] = nil
end

local function SetAllHitboxes(enabled)
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if enabled then ApplyHitbox(player)
            else            RestoreHitbox(player) end
        end
    end
end

local function UpdateHitboxSize()
    if not State.Hitbox.Enabled then return end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then ApplyHitbox(player) end
    end
end

