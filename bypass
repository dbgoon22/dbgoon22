local Pages = Instance.new("Frame", Main)
Pages.Size               = UDim2.new(1, -20, 1, -122)
Pages.Position           = UDim2.new(0, 10, 0, 118)
Pages.BackgroundTransparency = 1
Pages.ZIndex             = 2
Pages.ClipsDescendants   = true

local TabButtons = {}
local PageFrames = {}

local function CreatePage(name)
    local scroll = Instance.new("ScrollingFrame", Pages)
    scroll.Name                 = name .. "Page"
    scroll.Size                 = UDim2.fromScale(1, 1)
    scroll.BackgroundTransparency = 1
    scroll.BorderSizePixel      = 0
    scroll.ScrollBarThickness   = 3
    scroll.ScrollBarImageColor3 = Color3.fromRGB(120, 80, 255)
    scroll.AutomaticCanvasSize  = Enum.AutomaticSize.Y
    scroll.CanvasSize           = UDim2.new(0, 0, 0, 0)
    scroll.Visible              = false
    scroll.ZIndex               = 3
    local layout = Instance.new("UIListLayout", scroll)
    layout.Padding   = UDim.new(0, 8)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    local pad = Instance.new("UIPadding", scroll)
    pad.PaddingTop    = UDim.new(0, 6)
    pad.PaddingLeft   = UDim.new(0, 4)
    pad.PaddingRight  = UDim.new(0, 4)
    pad.PaddingBottom = UDim.new(0, 8)
    PageFrames[name] = scroll
    return scroll
end

local function SetTab(name)
    for pName, page in pairs(PageFrames) do
        page.Visible = pName == name
    end
    for tName, btn in pairs(TabButtons) do
        local active = tName == name
        btn.BackgroundColor3 = active
            and Color3.fromRGB(120, 60, 255)
            or  Color3.fromRGB(28,  24, 50)
        btn.TextColor3 = active
            and Color3.fromRGB(255, 255, 255)
            or  Color3.fromRGB(160, 140, 200)
    end
end

local function MakeTab(name, icon)
    local btn = Instance.new("TextButton", TabBar)
    btn.Size             = UDim2.new(0, 115, 0, 28)
    btn.BackgroundColor3 = Color3.fromRGB(28, 24, 50)
    btn.BorderSizePixel  = 0
    btn.Text             = icon .. " " .. name
    btn.Font             = Enum.Font.GothamBold
    btn.TextSize         = 13
    btn.TextColor3       = Color3.fromRGB(160, 140, 200)
    btn.ZIndex           = 4
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    TabButtons[name] = btn
    btn.MouseButton1Click:Connect(function() SetTab(name) end)
end

