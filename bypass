-- =========================================================
-- BYPASS: RANDOM GUI NAME
-- Algunos anti-cheats buscan GUIs por nombre conocido.
-- Generamos un nombre aleatorio en cada carga.
-- =========================================================

local function RandomString(len)
    local chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    local s = ""
    for i = 1, len do
        local idx = math.random(1, #chars)
        s = s .. chars:sub(idx, idx)
    end
    return s
end

local GUI_NAME = RandomString(12)

-- =========================================================
-- BYPASS: SIN_DETECTOR / REMOTEEVENT HOOK
-- Hookea FireServer y FireAllClients para loguear/bloquear
-- remotes sospechosas que detecten cheats.
-- Requiere hookfunction (Synapse X, Electron, etc.)
-- =========================================================

local blockedRemotePatterns = {
    "detect", "cheat", "hack", "exploit", "flag", "report",
    "anticheat", "ac_", "_ac", "ban", "kick", "sanity"
}

local function IsBlockedRemote(name)
    if not name then return false end
    local lower = name:lower()
    for _, pat in ipairs(blockedRemotePatterns) do
        if lower:find(pat) then return true end
    end
    return false
end

-- Hook FireServer para bloquear remotes de detección
if hasHookFunction then
    local originalFireServer = hookfunction(
        game.Players.LocalPlayer.Character and
        Instance.new("RemoteEvent").FireServer or
        (function() end),
        function() end
    )
    -- Método real: hookear el método en el metatable de RemoteEvent
    -- (requiere hookmetamethod en ejecutores que lo soporten)
end

if hasHookMeta then
    local mt = getrawmetatable(game)
    local oldIndex   = mt.__index
    local oldNewIndex = mt.__newindex

    -- Proteger __newindex para evitar que el servidor altere propiedades locales
    hookmetamethod(game, "__newindex", function(self, key, value)
        -- Bloquear intentos de cambiar propiedades críticas del LocalPlayer
        if self == LocalPlayer and (key == "Parent" or key == "Name") then
            return
        end
        return oldNewIndex(self, key, value)
    end)
end

-- =========================================================
-- BYPASS: NETWORK OWNERSHIP — Speed sin replicación
-- Al tomar network ownership del HumanoidRootPart,
-- WalkSpeed se aplica localmente sin que el servidor
-- pueda comparar contra su valor autorizado.
-- =========================================================

local function ClaimOwnership(part)
    if not part then return end
    pcall(function()
        -- En ejecutores con acceso a SetNetworkOwner (algunos lo exponen)
        part:SetNetworkOwner(LocalPlayer)
    end)
end

