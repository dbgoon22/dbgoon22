searchButton.LayoutOrder      = 14
searchButton.ZIndex           = 5
Instance.new("UICorner", searchButton).CornerRadius = UDim.new(0, 10)

searchButton.MouseButton1Click:Connect(function()
    if FinderBusy then return end
    local minP, maxP = ValidateFinderRange()
    FinderBusy = true
    searchButton.Text = "⏳ Escaneando..."
    ClearFoundServers()
    finderLog.Text = "Escaneando servidores...\n"
    local placeId   = game.PlaceId
    task.spawn(function()
        local cursor     = ""
        local retryDelay = 0.35
        for attempt = 1, 20 do
            local url = string.format(
                "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100%s",
                placeId,
                cursor ~= "" and ("&cursor=" .. HttpService:UrlEncode(cursor)) or ""
            )
            local ok, result = pcall(function()
                return HttpService:JSONDecode(game:HttpGet(url))
            end)
            if not ok or typeof(result) ~= "table" or typeof(result.data) ~= "table" then
                finderLog.Text = finderLog.Text
                    .. string.format("⚠ Error intento %d — retry en %.1fs\n", attempt, retryDelay)
                task.wait(retryDelay)
                retryDelay = math.min(retryDelay * 1.5, 3)
            else
                retryDelay = 0.35
                for _, server in ipairs(result.data) do
                    if typeof(server) == "table" then
                        local playing  = tonumber(server.playing)
                        local maxPlSrv = tonumber(server.maxPlayers)
                        local id       = server.id
                        if playing and playing >= minP and playing <= maxP
                            and AddUniqueServer(id) then
                            finderLog.Text = finderLog.Text .. string.format(
                                "✅ %s... | %d%s jugadores\n",
                                tostring(id):sub(1, 16),
                                playing,
                                maxPlSrv and ("/" .. maxPlSrv) or ""
                            )
                        end
                    end
                end
                cursor = typeof(result.nextPageCursor) == "string"
                    and result.nextPageCursor or ""
                if cursor == "" then break end
                task.wait(retryDelay)
            end
        end
        finderLog.Text = finderLog.Text .. (
            foundCount > 0
            and string.format("\n✅ %d servidor(es) encontrados.", foundCount)
            or  string.format("\n❌ Ninguno con %d-%d jugadores.", minP, maxP)
        )
        searchButton.Text = "⚡ BUSCAR SERVIDORES"
        FinderBusy = false
    end)
end)

