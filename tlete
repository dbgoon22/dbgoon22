-- =========================================================
-- EXECUTOR COMPAT
-- =========================================================

local function SafeGetHui()
    if typeof(gethui) == "function" then
        local ok, r = pcall(gethui)
        if ok and r then return r end
    end
    local ok, cg = pcall(function() return game:GetService("CoreGui") end)
    return (ok and cg) or LocalPlayer:WaitForChild("PlayerGui")
end

-- Remote hook seguro: solo usa hookmetamethod si está disponible,
-- con pcall total para que un error no rompa el script.
local function SafeHookNamecall(callback)
    if typeof(hookmetamethod) ~= "function" then return end
    pcall(function()
        hookmetamethod(game, "__namecall", function(self, ...)
            local ok, method = pcall(getnamecallmethod)
            if not ok then return (select('#', ...) > 0) and self[method](self, ...) or nil end
            local result = callback(self, method, ...)
            if result ~= nil then return result end
            -- llama al original de forma segura
            local fn = rawget(getrawmetatable(self) or {}, "__namecall")
            if fn then return fn(self, ...) end
        end)
    end)
end

