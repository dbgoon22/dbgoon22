local foundServers = {}
local foundCount   = 0

local function ClearFoundServers() table.clear(foundServers); foundCount = 0 end
local function AddUniqueServer(id)
    if typeof(id) ~= "string" or id == "" or foundServers[id] then return false end
    foundServers[id] = true; foundCount += 1; return true
end
local function ValidateFinderRange()
    local mn = math.clamp(math.floor(SafeNumber(State.Finder.MinPlayers, 0)), 0, 100)
    local mx = math.clamp(math.floor(SafeNumber(State.Finder.MaxPlayers, 100)), 0, 100)
    if mn > mx then mn, mx = mx, mn end
    State.Finder.MinPlayers = mn; State.Finder.MaxPlayers = mx
    return mn, mx
end

local searchButton = Instance.new("TextButton", FinderPage)
searchButton.Size             = UDim2.new(1, 0, 0, 38)
searchButton.BackgroundColor3 = Color3.fromRGB(100, 50, 220)
searchButton.BorderSizePixel  = 0
searchButton.Text             = "⚡ BUSCAR SERVIDORES"
searchButton.Font             = Enum.Font.GothamBold
