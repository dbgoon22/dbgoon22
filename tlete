-- =========================================================
-- UTILITIES
-- =========================================================

local function GetCharacter(p) return p and p.Character end
local function GetRoot(p)
    local c = GetCharacter(p)
    return c and c:FindFirstChild("HumanoidRootPart")
end
local function GetHumanoid(p)
    local c = GetCharacter(p)
    return c and c:FindFirstChildOfClass("Humanoid")
end
local function IsCharacterValid(p)
    if not p or not p.Parent then return false end
    local h = GetHumanoid(p)
    local r = GetRoot(p)
    return h ~= nil and r ~= nil and h.Health > 0
end
local function SafeNumber(v, fb)
    local n = tonumber(v)
    if not n or n ~= n or math.abs(n) == math.huge then return fb end
    return n
end

-- =========================================================
-- REMOTE HOOK — silencia anti-cheat remotes
-- =========================================================
-- Lista de patrones de nombres que usan anti-cheats comunes.
-- El hook es seguro: pcall total, fallback al original si falla.

local BLOCKED_PATTERNS = {
    "anticheat", "reportcheat", "cheatdetect", "speedcheck",
    "jumpcheck", "ragdollcheck", "sanitychek", "flagplayer",
    "serverlog", "detecthack", "hackdetect", "exploitdetect",
}

local function IsBlockedRemote(name)
    local lower = name:lower()
    for _, p in ipairs(BLOCKED_PATTERNS) do
        if lower:find(p, 1, true) then return true end
    end
    return false
end

SafeHookNamecall(function(self, method, ...)
    if (method == "FireServer" or method == "InvokeServer") then
        local ok, isRemote = pcall(function() return self:IsA("RemoteEvent") or self:IsA("RemoteFunction") end)
        if ok and isRemote then
            local nameOk, name = pcall(function() return self.Name end)
            if nameOk and IsBlockedRemote(name) then
                return nil  -- silencia
            end
        end
    end
    return nil  -- deja pasar al original
end)

-- =========================================================
-- HITBOX BYPASS
-- =========================================================
-- Loop espaciado a 0.5s. Solo escribe Size si el valor actual
-- difiere del target — evita writes redundantes que el server detecta.

local function GetHitboxSize()
    return math.clamp(SafeNumber(State.Hitbox.Size, 10), 1, 100)
end

local function SaveOriginalSize(player)
    if player == LocalPlayer then return end
    local root = GetRoot(player)
    if root and OriginalSizes[player] == nil then
        OriginalSizes[player] = root.Size
    end
end

local function ApplyHitbox(player)
    if player == LocalPlayer then return end
    local root = GetRoot(player)
    if not root then return end
    SaveOriginalSize(player)
    pcall(function()
        local s       = GetHitboxSize()
        local target  = Vector3.new(s, s, s)
        -- solo escribe si difiere: evita writes redundantes
        if (root.Size - target).Magnitude > 0.01 then
            root.Size = target
        end
        root.CanCollide = false
        root.LocalTransparencyModifier = 1
    end)
end

local function RestoreHitbox(player)
    if player == LocalPlayer then return end
    local root     = GetRoot(player)
    local original = OriginalSizes[player]
    if root and original then
        pcall(function()
            root.Size = original
            root.LocalTransparencyModifier = 0
        end)
    end
    OriginalSizes[player] = nil
end

local function SetAllHitboxes(enabled)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            if enabled then ApplyHitbox(p) else RestoreHitbox(p) end
        end
    end
end

local function UpdateHitboxSize()
    if not State.Hitbox.Enabled then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then ApplyHitbox(p) end
    end
end

-- Loop 0.5s — espaciado suficiente para no generar ruido server-side
task.spawn(function()
    while true do
        task.wait(0.5)
        if State.Hitbox.Enabled then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and IsCharacterValid(p) then
                    ApplyHitbox(p)
                end
            end
        end
    end
end)

-- =========================================================
-- ESP BYPASS
-- =========================================================
-- Highlight vive en CoreGui/gethui — invisible para scripts
-- que escaneen PlayerGui o Character.DescendantAdded.

local ESPFolder      = Instance.new("Folder")
ESPFolder.Name       = "dbgoon22_ESP"
ESPFolder.Parent     = SafeGetHui()

local function RemoveESP(player)
    local obj = ESPObjects[player]
    if obj then pcall(function() obj:Destroy() end) end
    ESPObjects[player] = nil
end

local function AddESP(player)
    if player == LocalPlayer then return end
    if not State.ESP.Enabled then RemoveESP(player) return end
    local char = player.Character
    if not char then return end
    local existing = ESPObjects[player]
    if existing and existing.Parent then
        existing.FillColor    = State.ESP.Color
        existing.OutlineColor = State.ESP.Color
        return
    end
    RemoveESP(player)
    local hl = Instance.new("Highlight")
    hl.Name                = "ESP_" .. player.Name
    hl.Adornee             = char
    hl.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
    hl.FillColor           = State.ESP.Color
    hl.OutlineColor        = State.ESP.Color
    hl.FillTransparency    = 0.75
    hl.OutlineTransparency = 0
    hl.Parent              = ESPFolder
    ESPObjects[player]     = hl
end

local function RefreshESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            if State.ESP.Enabled then AddESP(p) else RemoveESP(p) end
        end
    end
end

-- =========================================================
-- ANTI-RAGDOLL BYPASS
-- =========================================================
-- DescendantAdded con task.defer + validación de Parent.
-- Sin defer, Destroy() en el mismo frame que la instancia
-- se crea genera un error en el stack del juego → detectable.

local function CleanRagdollConnections()
    for k, c in pairs(RagdollConnections) do
        pcall(function() c:Disconnect() end)
        RagdollConnections[k] = nil
    end
end

local function HookAntiRagdoll(character)
    if not character then return end
    CleanRagdollConnections()

    -- limpia los que ya existen
    for _, v in ipairs(character:GetDescendants()) do
        if v:IsA("BallSocketConstraint") or v:IsA("HingeConstraint") then
            pcall(function() v:Destroy() end)
        end
    end

    -- destruye los que se añadan — defer + validación de Parent
    RagdollConnections.desc = character.DescendantAdded:Connect(function(v)
        if not State.AntiRagdoll.Enabled then return end
        if v:IsA("BallSocketConstraint") or v:IsA("HingeConstraint") then
            task.defer(function()
                -- valida que el objeto siga existiendo y tenga Parent
                if v and v.Parent then
                    pcall(function() v:Destroy() end)
                end
            end)
        end
    end)

    -- StateChanged: bloquea Ragdoll / FallingDown
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        RagdollConnections.state = humanoid.StateChanged:Connect(function(_, new)
            if not State.AntiRagdoll.Enabled then return end
            if new == Enum.HumanoidStateType.Ragdoll
            or new == Enum.HumanoidStateType.FallingDown then
                task.defer(function()
                    pcall(function()
                        humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
                    end)
                end)
            end
        end)
    end
end

local function ApplyAntiRagdollFrame()
    if not State.AntiRagdoll.Enabled then return end
    local h = GetHumanoid(LocalPlayer)
    if not h then return end
    local s = h:GetState()
    if s == Enum.HumanoidStateType.Ragdoll
    or s == Enum.HumanoidStateType.FallingDown then
        pcall(function() h:ChangeState(Enum.HumanoidStateType.GettingUp) end)
    end
end

-- =========================================================
-- SPEED BYPASS — VectorForce (no kickea a 65)
-- =========================================================
--
-- Por qué BodyVelocity kickea a velocidades altas:
--   MaxForce 1e5 + velocidad alta → el HRP se mueve tan rápido
--   que el server-side position check ve una discrepancia imposible
--   y kickea con "you were kicked due to unexpected client behavior".
--
-- Fix: VectorForce dentro de un Attachment en el HRP.
--   VectorForce no tiene MaxForce como límite duro — aplica una
--   fuerza continua que el motor de física integra suavemente.
--   El movimiento resultante es indistinguible de un humanoid
--   con WalkSpeed alto para el servidor, porque el desplazamiento
--   ocurre frame a frame en vez de ser un teleport de velocidad.
--
--   WalkSpeed se mantiene en 16 (el server lo espera bajo).
--   La fuerza se escala con la masa del HRP para que la aceleración
--   sea consistente independientemente del personaje.
--
-- Cap: 65. A 65 la fuerza necesaria está dentro del rango normal
-- de física de Roblox sin disparar el anti-cheat nativo.

local FORCE_SCALE = 3500   -- base de fuerza por unidad de velocidad
local SPEED_DAMP  = 0.85   -- damping para suavizar el inicio/parada

local SpeedAttachment = nil
local SpeedVectorForce = nil
local CurrentVelocityDir = Vector3.zero

local function GetSpeedValue()
    return math.clamp(SafeNumber(State.Speed.Value, 16), 1, SPEED_MAX)
end

local function RemoveSpeedBypass()
    if SpeedVectorForce then
        pcall(function() SpeedVectorForce:Destroy() end)
        SpeedVectorForce = nil
    end
    if SpeedAttachment then
        pcall(function() SpeedAttachment:Destroy() end)
        SpeedAttachment = nil
    end
    CurrentVelocityDir = Vector3.zero
    local h = GetHumanoid(LocalPlayer)
    if h then
        local orig = OriginalWalkSpeeds[h]
        pcall(function() h.WalkSpeed = orig or 16 end)
        OriginalWalkSpeeds[h] = nil
    end
end

local function ApplySpeedBypass()
    local h    = GetHumanoid(LocalPlayer)
    local root = GetRoot(LocalPlayer)
    if not h or not root or h.Health <= 0 then return end

    -- guarda WalkSpeed original una vez
    if OriginalWalkSpeeds[h] == nil then
        OriginalWalkSpeeds[h] = h.WalkSpeed
    end

    -- mantiene WalkSpeed bajo — el server espera 16
    pcall(function() h.WalkSpeed = 16 end)

    local speed = GetSpeedValue()

    -- crea Attachment + VectorForce si no existen
    local att = root:FindFirstChild("dbgoon22_SpeedAtt")
    if not att then
        att      = Instance.new("Attachment")
        att.Name = "dbgoon22_SpeedAtt"
        att.Parent = root
        SpeedAttachment = att
    end

    local vf = att:FindFirstChild("dbgoon22_VF")
    if not vf then
        vf              = Instance.new("VectorForce")
        vf.Name         = "dbgoon22_VF"
        vf.Attachment0  = att
        vf.RelativeTo   = Enum.ActuatorRelativeTo.World
        vf.ApplyAtCenterOfMass = true
        vf.Parent       = att
        SpeedVectorForce = vf
    end

    local dir = h.MoveDirection
    if dir.Magnitude > 0.1 then
        -- suaviza la dirección con lerp para evitar aceleración instantánea
        CurrentVelocityDir = CurrentVelocityDir:Lerp(dir, SPEED_DAMP)
        -- fuerza = masa * velocidad_deseada * escala
        -- masa aproximada del HRP: root.AssemblyMass si está disponible
        local mass = 1
        pcall(function() mass = root.AssemblyMass end)
        vf.Force = CurrentVelocityDir * speed * FORCE_SCALE * mass
    else
        CurrentVelocityDir = Vector3.zero
        vf.Force = Vector3.zero
    end
end

-- =========================================================
-- INFINITE JUMP BYPASS
-- =========================================================
-- Solo JumpRequest + ChangeState. Sin StateChanged hook.
-- El StateChanged hook de v2.4 generaba transiciones Jumping
-- fuera del ciclo normal → sanity check del engine → kick.
-- Debounce subido a 0.2s para más margen.

UserInputService.JumpRequest:Connect(function()
    if not State.InfJump.Enabled then return end
    if jumpDebounce then return end
    local h = GetHumanoid(LocalPlayer)
    if not h or h.Health <= 0 then return end
    jumpDebounce = true
    pcall(function()
        h:ChangeState(Enum.HumanoidStateType.Jumping)
    end)
    task.delay(0.2, function() jumpDebounce = false end)
end)

-- =========================================================
-- TARGET
-- =========================================================

local function GetClosestPlayer()
    local myRoot = GetRoot(LocalPlayer)
    if not myRoot then return nil end
    local closest, closestDist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and IsCharacterValid(p) then
            local r = GetRoot(p)
            if r then
                local d = (r.Position - myRoot.Position).Magnitude
                if d < closestDist then closestDist = d; closest = p end
            end
        end
    end
    return closest
end

local function UpdateTarget()
    if State.AutoHit.Enabled or State.Aimbot.Enabled then
        CurrentTarget = GetClosestPlayer()
    else
        CurrentTarget = nil
    end
end

-- =========================================================
-- AIMBOT — RenderStepped directo, sin metatable hook
-- =========================================================
-- Camera __newindex hook con getrawmetatable → Byfron detecta
-- el setreadonly como memory patch. Eliminado.
-- RenderStepped directo es silencioso y suficiente.

local function UpdateAimbot(target, dt)
    if not State.Aimbot.Enabled then return end
    if not target or not IsCharacterValid(target) then return end
    local root   = GetRoot(target)
    local camera = workspace.CurrentCamera
    if not root or not camera then return end
    local targetPos = root.Position + Vector3.new(0, 2, 0)
    local alpha     = 1 - math.pow(0.01, math.clamp(dt * 12, 0, 1))
    pcall(function()
        camera.CFrame = camera.CFrame:Lerp(
            CFrame.lookAt(camera.CFrame.Position, targetPos),
            alpha
        )
    end)
end

-- =========================================================
-- AUTO HIT
-- =========================================================

local function TryAutoHit(target)
    if not State.AutoHit.Enabled then return end
    if not target or not IsCharacterValid(target) then return end
    local myRoot     = GetRoot(LocalPlayer)
    local targetRoot = GetRoot(target)
    if not myRoot or not targetRoot then return end
    if (targetRoot.Position - myRoot.Position).Magnitude > 8 then return end
    -- integra aquí el remote/tool del sistema de combate del juego
end

-- =========================================================
-- HEARTBEAT
-- =========================================================

RunService.Heartbeat:Connect(function(dt)
    if State.Speed.Enabled then ApplySpeedBypass() end
    ApplyAntiRagdollFrame()

    TargetAccumulator += dt
    if TargetAccumulator >= TARGET_UPDATE_RATE then
        TargetAccumulator = 0
        UpdateTarget()
    end

    if State.Aimbot.Enabled  and CurrentTarget then UpdateAimbot(CurrentTarget, dt) end
    if State.AutoHit.Enabled and CurrentTarget then TryAutoHit(CurrentTarget) end
end)

-- =========================================================
-- CHARACTER EVENTS
-- =========================================================

local function OnCharacterAdded(player)
    OriginalSizes[player] = nil
    task.delay(0.5, function()
        if not player or not player.Parent or not player.Character then return end
        if State.Hitbox.Enabled then ApplyHitbox(player) end
        if State.ESP.Enabled    then AddESP(player)      end
    end)
    if player == LocalPlayer then
        task.delay(0.5, function()
            if State.AntiRagdoll.Enabled then
                HookAntiRagdoll(LocalPlayer.Character)
            end
        end)
    end
end

local function SetupPlayer(player)
    if player == LocalPlayer then return end
    if PlayerConnections[player] then return end
    local conns = {}
    PlayerConnections[player] = conns
    conns.CharacterAdded = player.CharacterAdded:Connect(function()
        OnCharacterAdded(player)
    end)
    conns.CharacterRemoving = player.CharacterRemoving:Connect(function(char)
        local esp = ESPObjects[player]
        if esp and esp.Adornee == char then RemoveESP(player) end
        OriginalSizes[player] = nil
    end)
    if player.Character then task.defer(function() OnCharacterAdded(player) end) end
end

local function CleanupPlayer(player)
    RemoveESP(player)
    local root = GetRoot(player)
    if root and OriginalSizes[player] then
        pcall(function() root.Size = OriginalSizes[player] end)
    end
    OriginalSizes[player] = nil
    local conns = PlayerConnections[player]
    if conns then
        for _, c in pairs(conns) do pcall(function() c:Disconnect() end) end
    end
    PlayerConnections[player] = nil
    if CurrentTarget == player then CurrentTarget = nil end
end

for _, p in ipairs(Players:GetPlayers()) do SetupPlayer(p) end
Players.PlayerAdded:Connect(SetupPlayer)
Players.PlayerRemoving:Connect(CleanupPlayer)

LocalPlayer.CharacterAdded:Connect(function()
    SpeedVectorForce = nil
    SpeedAttachment  = nil
    CurrentVelocityDir = Vector3.zero
    task.wait(0.5)
    if State.Speed.Enabled      then ApplySpeedBypass() end
    if State.AntiRagdoll.Enabled then HookAntiRagdoll(LocalPlayer.Character) end
end)

task.defer(function()
    if State.AntiRagdoll.Enabled and LocalPlayer.Character then
        HookAntiRagdoll(LocalPlayer.Character)
    end
end)

