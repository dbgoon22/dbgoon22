local function getBrainrotNameFromInstance(inst)
    -- SAB usa modelos con StringValue "Name" o el propio .Name del modelo
    -- Busca en varias capas
    if inst:FindFirstChild("BreedName") then
        return inst.BreedName.Value
    end
    if inst:FindFirstChild("BrainrotName") then
        return inst.BrainrotName.Value
    end
    if inst:FindFirstChild("Name") and inst:FindFirstChild("Name"):IsA("StringValue") then
        return inst:FindFirstChild("Name").Value
    end
    return inst.Name
end

local function getBrainrotValueFromInstance(inst)
    -- SAB almacena el valor en IntValue/NumberValue dentro del modelo
    local candidates = {"Value", "Worth", "Coins", "Price", "SellValue", "BreedValue"}
    for _, key in ipairs(candidates) do
        local v = inst:FindFirstChild(key, true)
        if v and (v:IsA("IntValue") or v:IsA("NumberValue")) then
            return v.Value
        end
    end
    -- Fallback: buscar en el mapa por nombre
    local name = getBrainrotNameFromInstance(inst)
    return BRAINROT_VALUE_MAP[name] or 0
end

local function scanCurrentServer()
    -- Escanea workspace en busca de modelos de brainrot activos
    local found = {}
    local containers = {
        workspace,
        ReplicatedStorage,
    }
    -- SAB suele guardar las mascotas/brainrots bajo carpetas específicas
    local folderNames = {
        "Brainrots", "Pets", "OwnedPets", "ActivePets",
        "SpawnedBreeds", "Breeds", "PlayerBreeds"
    }
    for _, container in ipairs(containers) do
        for _, folderName in ipairs(folderNames) do
            local folder = container:FindFirstChild(folderName, true)
            if folder then
                for _, inst in ipairs(folder:GetDescendants()) do
                    if inst:IsA("Model") or inst:IsA("Folder") then
                        local val = getBrainrotValueFromInstance(inst)
                        local name = getBrainrotNameFromInstance(inst)
                        if val >= MIN_VALUE then
                            table.insert(found, {name = name, value = val})
                        end
                    end
                end
            end
        end
    end
    -- Ordenar por valor descendente
    table.sort(found, function(a, b) return a.value > b.value end)
    return found
end

local function getBestBrainrotInServer()
    local results = scanCurrentServer()
    if #results > 0 then
        return results[1].name, results[1].value
    end
    -- Si no encuentra por instancias, intenta via RemoteFunction
    local rf = ReplicatedStorage:FindFirstChild("GetBrainrots", true)
        or ReplicatedStorage:FindFirstChild("GetPets", true)
        or ReplicatedStorage:FindFirstChild("GetBreeds", true)
    if rf and rf:IsA("RemoteFunction") then
        local ok, data = pcall(function() return rf:InvokeServer() end)
        if ok and type(data) == "table" then
            local best = {name = "Desconocido", value = 0}
            for _, entry in ipairs(data) do
                local val = entry.value or entry.worth or entry.coins or 0
                if val > best.value then
                    best.name = entry.name or entry.breed or "?"
                    best.value = val
                end
            end
            if best.value >= MIN_VALUE then
                return best.name, best.value
            end
        end
    end
    return nil, 0
end

