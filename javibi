local player = game.Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()

-- Módulo 1: Salto mejorado
local jumpModule = {
    enabled = false,
    power = 50 -- Ajusta este valor para saltar más alto
}

-- Módulo 2: Velocidad mejorada
local speedModule = {
    enabled = false,
    speed = 50 -- Ajusta este valor para correr más rápido
}

-- Función para activar/desactivar el salto mejorado
function toggleJump()
    jumpModule.enabled = not jumpModule.enabled
    if jumpModule.enabled then
        character.Humanoid.JumpPower = jumpModule.power
        print("Salto mejorado activado")
    else
        character.Humanoid.JumpPower = 50 -- Valor predeterminado
        print("Salto mejorado desactivado")
    end
end

-- Función para activar/desactivar la velocidad mejorada
function toggleSpeed()
    speedModule.enabled = not speedModule.enabled
    if speedModule.enabled then
        character.Humanoid.WalkSpeed = speedModule.speed
        print("Velocidad mejorada activada")
    else
        character.Humanoid.WalkSpeed = 16 -- Valor predeterminado
        print("Velocidad mejorada desactivada")
    end
end

