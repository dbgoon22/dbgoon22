-- Función para activar/desactivar super salto
local function toggleJump()
    jumpEnabled = not jumpEnabled
    if jumpEnabled then
        jumpButton.Text = "Desactivar Super Salto"
        jumpButton.BackgroundColor3 = Color3.fromRGB(85, 170, 85)
        
        -- Aumentar la altura del salto
        if player.Character and player.Character:FindFirstChild("Humanoid") then
            player.Character.Humanoid.JumpPower = 100
        end
    else
        jumpButton.Text = "Activar Super Salto"
        jumpButton.BackgroundColor3 = Color3.fromRGB(75, 75, 75)
        
        -- Restaurar salto normal
        if player.Character and player.Character:FindFirstChild("Humanoid") then
            player.Character.Humanoid.JumpPower = 50
        end
    end
end

-- Función para activar/desactivar super velocidad
local function toggleSpeed()
    speedEnabled = not speedEnabled
    if speedEnabled then
        speedButton.Text = "Desactivar Super Velocidad"
        speedButton.BackgroundColor3 = Color3.fromRGB(85, 170, 85)
        
        -- Aumentar la velocidad
        if player.Character and player.Character:FindFirstChild("Humanoid") then
            player.Character.Humanoid.WalkSpeed = 50
        end
    else
        speedButton.Text = "Activar Super Velocidad"
        speedButton.BackgroundColor3 = Color3.fromRGB(75, 75, 75)
        
        -- Restaurar velocidad normal
        if player.Character and player.Character:FindFirstChild("Humanoid") then
            player.Character.Humanoid.WalkSpeed = 16
        end
    end
end

