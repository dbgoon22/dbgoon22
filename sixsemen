local function hasGlobal(name)
    return typeof(rawget(_G, name)) == "function"
end

local hasGetHui     = hasGlobal("gethui")
local hasProtectGui = hasGlobal("protect_gui")
local hasGetRMeta   = hasGlobal("getrawmetatable")
local hasHookMeta   = hasGlobal("hookmetamethod")
local hasSeti       = hasGlobal("seti")
local hasCloneRef   = hasGlobal("cloneref")
local hasFTI        = hasGlobal("firetouchinterest")

local function SafeClone(svc)
    if hasCloneRef then
        local ok, r = pcall(cloneref, svc)
        if ok and r then return r end
    end
    return svc
end

local function SafeUnit(v)
    if typeof(v) ~= "Vector3" or v.Magnitude < 1e-4 then
        return Vector3.zero
    end
    return v.Unit
end

local function SafeNum(v, fb)
    local n = tonumber(v)
    if not n or n ~= n or math.abs(n) == math.huge then return fb end
    return n
end

local function SafeIPairs(t)
    return ipairs(t or {})
end

local Players          = SafeClone(game:GetService("Players"))
local RunService       = SafeClone(game:GetService("RunService"))
local UserInputService = SafeClone(game:GetService("UserInputService"))
local TweenService     = SafeClone(game:GetService("TweenService"))
local Workspace        = SafeClone(game:GetService("Workspace"))

