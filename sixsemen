local Camera      = Workspace.CurrentCamera

local function RandStr(n)
    local c = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    local s = ""
    for _ = 1, n do
        local i = math.random(1, #c)
        s = s .. c:sub(i, i)
    end
    return s
end
local GUI_NAME = RandStr(12)

if hasHookMeta and hasGetRMeta then
    pcall(function()
        local mt = getrawmetatable(game)
        local oldNI = mt.__newindex
        hookmetamethod(game, "__newindex", function(self, k, v)
            if self == LocalPlayer and (k == "Parent" or k == "Name") then return end
            return oldNI(self, k, v)
        end)
    end)
end

