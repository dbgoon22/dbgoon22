local function GetChar(p) return p and p.Character end
local function GetRoot(p)
    local c = GetChar(p)
    return c and c:FindFirstChild("HumanoidRootPart")
end
local function GetHum(p)
    local c = GetChar(p)
    return c and c:FindFirstChildOfClass("Humanoid")
end
local function ValidChar(p)
    if not p or not p.Parent then return false end
    local h, r = GetHum(p), GetRoot(p)
    return h ~= nil and r ~= nil and h.Health > 0
end

-- =========================================================
-- SPEED — limpio, sin tirón atrás
-- =========================================================

local function RemoveSpeedBV()
    if SpeedBV then
        pcall(function() SpeedBV:Destroy() end)
        SpeedBV = nil
    end
    local hum = GetHum(LocalPlayer)
    if hum then
        local orig = OriginalWalkSpeeds[hum]
        pcall(function() hum.WalkSpeed = orig or 16 end)
        OriginalWalkSpeeds[hum] = nil
    end
end

local function ApplySpeedBV()
    if not State.Speed.Enabled or State.Fly.Enabled then return end

    local root = GetRoot(LocalPlayer)
    local hum  = GetHum(LocalPlayer)
    if not root or not hum or hum.Health <= 0 then return end

    if OriginalWalkSpeeds[hum] == nil then
        OriginalWalkSpeeds[hum] = hum.WalkSpeed
    end
    pcall(function()
        hum.WalkSpeed = 16
        hum.JumpPower = math.max(hum.JumpPower, 50)
    end)

    local existing = root:FindFirstChild("__dbBV")
    if not existing then
        local bv = Instance.new("BodyVelocity")
        bv.Name     = "__dbBV"
        bv.MaxForce = Vector3.new(1e5, 0, 1e5) -- solo horizontal
        bv.P        = 2e4
        bv.Velocity = Vector3.zero
        bv.Parent   = root
        SpeedBV     = bv
    else
        SpeedBV = existing
    end

    local UIS = UserInputService
    local fwd = (UIS:IsKeyDown(Enum.KeyCode.W) or UIS:IsKeyDown(Enum.KeyCode.Up))    and 1 or 0
    local bwd = (UIS:IsKeyDown(Enum.KeyCode.S) or UIS:IsKeyDown(Enum.KeyCode.Down))  and 1 or 0
    local lft = (UIS:IsKeyDown(Enum.KeyCode.A) or UIS:IsKeyDown(Enum.KeyCode.Left))  and 1 or 0
    local rgt = (UIS:IsKeyDown(Enum.KeyCode.D) or UIS:IsKeyDown(Enum.KeyCode.Right)) and 1 or 0

    local speed = SafeNum(State.Speed.Value, 55)
    local move  = Vector3.zero

    if fwd + bwd + lft + rgt > 0 then
        local camCF   = Camera.CFrame
        local flatFwd = SafeUnit(Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z))
        local flatRgt = SafeUnit(Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z))
        move = SafeUnit(flatFwd * (fwd - bwd) + flatRgt * (rgt - lft)) * speed
    end

    -- anular velocidad residual del character para que no tire atrás
    pcall(function()
        if SpeedBV and SpeedBV.Parent then
            SpeedBV.Velocity = move
        end
        -- limpia AssemblyLinearVelocity horizontal si existe (evita lucha física)
        if root.AssemblyLinearVelocity then
            local v = root.AssemblyLinearVelocity
            root.AssemblyLinearVelocity = Vector3.new(move.X, v.Y, move.Z)
        end
    end)
end

-- =========================================================
-- FLY — sin tirón al activar / con brainrot
-- =========================================================

local function RemoveFly()
    if FlyBG then pcall(function() FlyBG:Destroy() end); FlyBG = nil end
    if FlyBV then pcall(function() FlyBV:Destroy() end); FlyBV = nil end
    local hum = GetHum(LocalPlayer)
    if hum then
        pcall(function()
            hum.PlatformStand = false
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end)
    end
    local root = GetRoot(LocalPlayer)
    if root then
        pcall(function()
            root.AssemblyLinearVelocity = Vector3.zero
        end)
    end
end

local function SetupFly()
    local root = GetRoot(LocalPlayer)
    local hum  = GetHum(LocalPlayer)
    if not root then return end
    RemoveFly()

    -- cero la velocidad actual para que no haya tirón al entrar
    pcall(function()
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end)

    if hum then
        pcall(function()
            hum.PlatformStand = true
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        end)
    end

    local bg = Instance.new("BodyGyro")
    bg.Name      = "__dbBG"
    bg.MaxTorque = Vector3.new(9e5, 9e5, 9e5)
    bg.P         = 5e4
    bg.D         = 800
    bg.CFrame    = root.CFrame
    bg.Parent    = root
    FlyBG        = bg

    local bv = Instance.new("BodyVelocity")
    bv.Name     = "__dbFV"
    bv.MaxForce = Vector3.new(9e5, 9e5, 9e5)
    bv.P        = 2e4
    bv.Velocity = Vector3.zero
    bv.Parent   = root
    FlyBV       = bv
end

local function ApplyFly()
    if not State.Fly.Enabled then return end
    local root = GetRoot(LocalPlayer)
    local hum  = GetHum(LocalPlayer)
    if not root then return end

    if not FlyBV or not FlyBV.Parent or not FlyBG or not FlyBG.Parent then
        SetupFly()
    end

    if hum then
        pcall(function() hum.PlatformStand = true end)
    end

    local UIS   = UserInputService
    local speed = SafeNum(State.Fly.Speed, 65)

    local fwd = (UIS:IsKeyDown(Enum.KeyCode.W) or UIS:IsKeyDown(Enum.KeyCode.Up))    and 1 or 0
    local bwd = (UIS:IsKeyDown(Enum.KeyCode.S) or UIS:IsKeyDown(Enum.KeyCode.Down))  and 1 or 0
    local lft = (UIS:IsKeyDown(Enum.KeyCode.A) or UIS:IsKeyDown(Enum.KeyCode.Left))  and 1 or 0
    local rgt = (UIS:IsKeyDown(Enum.KeyCode.D) or UIS:IsKeyDown(Enum.KeyCode.Right)) and 1 or 0
    local up  = UIS:IsKeyDown(Enum.KeyCode.Space) and 1 or 0
    local dn  = UIS:IsKeyDown(Enum.KeyCode.LeftControl) and 1 or 0

    local dir = Camera.CFrame.LookVector * (fwd - bwd)
              + Camera.CFrame.RightVector * (rgt - lft)
              + Vector3.new(0, 1, 0) * (up - dn)

    local vel = dir.Magnitude > 1e-3 and SafeUnit(dir) * speed or Vector3.zero

    pcall(function()
        if FlyBV and FlyBV.Parent then
            FlyBV.Velocity = vel
        end
        if FlyBG and FlyBG.Parent then
            FlyBG.CFrame = Camera.CFrame
        end
        -- fuerza la velocidad del assembly para matar residual del brainrot / physics
        root.AssemblyLinearVelocity = vel
        root.AssemblyAngularVelocity = Vector3.zero
    end)
end

-- =========================================================
-- AUTO STEAL
-- =========================================================

local function GetEnemyBrainrots()
    local found = {}
    local ok, descendants = pcall(function() return Workspace:GetDescendants() end)
    if not ok or type(descendants) ~= "table" then return found end

    for _, obj in SafeIPairs(descendants) do
        if obj and (obj:IsA("Model") or obj:IsA("BasePart")) then
            local lname = string.lower(tostring(obj.Name or ""))
            if lname:find("brainrot") or lname:find("pet") or lname:find("steal") then
                local owner = nil
                local p = obj.Parent
                for _ = 1, 8 do
                    if not p then break end
                    for _, plr in SafeIPairs(Players:GetPlayers()) do
                        if plr and plr ~= LocalPlayer then
                            local pname = tostring(plr.Name or "")
                            if p.Name == pname or string.find(tostring(p.Name), pname, 1, true) then
                                owner = plr
                                break
                            end
                        end
                    end
                    if owner then break end
                    p = p.Parent
                end
                if owner then
                    local posPart = obj:IsA("BasePart") and obj
                        or obj:FindFirstChild("HumanoidRootPart")
                        or obj.PrimaryPart
                        or obj:FindFirstChildWhichIsA("BasePart", true)
                    if posPart then
                        table.insert(found, { part = posPart, owner = owner, obj = obj })
                    end
                end
            end
        end
    end
    return found
end

local function TryAutoSteal(dt)
    if not State.AutoSteal.Enabled then return end
    stealCooldown = stealCooldown - dt
    if stealCooldown > 0 then return end

    local myRoot = GetRoot(LocalPlayer)
    if not myRoot then return end

    local targets = GetEnemyBrainrots()
    if type(targets) ~= "table" or #targets == 0 then return end

    table.sort(targets, function(a, b)
        local pa = a.part and a.part.Position or Vector3.zero
        local pb = b.part and b.part.Position or Vector3.zero
        return (pa - myRoot.Position).Magnitude < (pb - myRoot.Position).Magnitude
    end)

    local target = targets[1]
    if not target or not target.part or not target.part.Parent then return end
    local tPos = target.part.Position

    pcall(function()
        myRoot.CFrame = CFrame.new(tPos + Vector3.new(0, 2.6, 0))
        task.wait(0.03)
        if hasFTI then
            local touchPart = target.part
            if not touchPart:IsA("BasePart") then
                touchPart = target.obj and target.obj:FindFirstChildWhichIsA("BasePart", true)
            end
            if touchPart then
                firetouchinterest(myRoot, touchPart, 0)
                task.wait(0.012)
                firetouchinterest(myRoot, touchPart, 1)
            end
        end
    end)

    stealCooldown = SafeNum(State.AutoSteal.Cooldown, 0.35)
end

-- =========================================================
-- HITBOX / ESP
-- =========================================================

local function GetHitboxSize()
    return math.clamp(SafeNum(State.Hitbox.Size, 14), 1, 100)
end

local function SaveOrigSize(player)
    if player == LocalPlayer then return end
    local r = GetRoot(player)
    if r and OriginalSizes[player] == nil then OriginalSizes[player] = r.Size end
end

local function ApplyHitbox(player)
    if player == LocalPlayer then return end
    local r = GetRoot(player)
    if not r then return end
    SaveOrigSize(player)
    local s = GetHitboxSize()
    pcall(function()
        if hasSeti then seti(r, "Size", Vector3.new(s, s, s)) else r.Size = Vector3.new(s, s, s) end
        r.CanCollide = false
        r.Massless = true
    end)
end

local function RestoreHitbox(player)
    if player == LocalPlayer then return end
    local r = GetRoot(player)
    local o = OriginalSizes[player]
    if r and o then
        pcall(function()
            if hasSeti then seti(r, "Size", o) else r.Size = o end
            r.CanCollide = true
            r.Massless = false
        end)
    end
    OriginalSizes[player] = nil
end

local function SetAllHitboxes(en)
    for _, p in SafeIPairs(Players:GetPlayers()) do
        if p and p ~= LocalPlayer then
            if en then ApplyHitbox(p) else RestoreHitbox(p) end
        end
    end
end

local function UpdateHitboxSize()
    if not State.Hitbox.Enabled then return end
    for _, p in SafeIPairs(Players:GetPlayers()) do
        if p and p ~= LocalPlayer then ApplyHitbox(p) end
    end
end

local function RemoveESP(player)
    local o = ESPObjects[player]
    if o then pcall(function() o:Destroy() end); ESPObjects[player] = nil end
end

local function AddESP(player)
    if player == LocalPlayer then return end
    if not State.ESP.Enabled then RemoveESP(player) return end
    local char = player.Character
    if not char then return end
    local ex = ESPObjects[player]
    if ex and ex.Parent == char then
        ex.FillColor = State.ESP.Color
        ex.OutlineColor = State.ESP.Color
        return
    end
    RemoveESP(player)
    local hl = Instance.new("Highlight")
    hl.Name = GUI_NAME .. "_E"
    hl.Adornee = char
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.FillColor = State.ESP.Color
    hl.OutlineColor = State.ESP.Color
    hl.FillTransparency = 0.55
    hl.OutlineTransparency = 0
    hl.Parent = char
    ESPObjects[player] = hl
end

local function RefreshESP()
    for _, p in SafeIPairs(Players:GetPlayers()) do
        if p and p ~= LocalPlayer then
            if State.ESP.Enabled then AddESP(p) else RemoveESP(p) end
        end
    end
end

-- =========================================================
-- ANTI RAGDOLL + MEDUSA STONE RECOVERY
-- =========================================================

local function SaveMotors(char)
    if not char or SavedMotor6Ds[char] then return end
    local m = {}
    local ok, list = pcall(function() return char:GetDescendants() end)
    if not ok or type(list) ~= "table" then return end
    for _, v in SafeIPairs(list) do
        if v and v:IsA("Motor6D") then
            m[v] = { part0 = v.Part0, part1 = v.Part1, c0 = v.C0, c1 = v.C1 }
        end
    end
    SavedMotor6Ds[char] = m
end

local function RestoreMotors(char)
    if not char then return end
    local m = SavedMotor6Ds[char]
    if type(m) ~= "table" then return end
    for motor, d in pairs(m) do
        pcall(function()
            if motor and motor.Parent then
                motor.Enabled = true
                motor.Part0 = d.part0
                motor.Part1 = d.part1
                motor.C0 = d.c0
                motor.C1 = d.c1
            end
        end)
    end
end

local function KillConstraints(char)
    if not char then return end
    local ok, list = pcall(function() return char:GetDescendants() end)
    if not ok or type(list) ~= "table" then return end
    for _, v in SafeIPairs(list) do
        if v and (v:IsA("BallSocketConstraint") or v:IsA("HingeConstraint") or v:IsA("WeldConstraint")) then
            pcall(function() v:Destroy() end)
        end
    end
end

local function ForceUnfreeze(char, hum, root)
    if not char or not hum or not root then return end
    pcall(function()
        -- desanclar partes si la medusa las ancló localmente
        for _, part in SafeIPairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.Anchored and part.Name ~= "HumanoidRootPart" then
                part.Anchored = false
            end
        end
        root.Anchored = false
        RestoreMotors(char)
        KillConstraints(char)
        hum.PlatformStand = false
        hum.Sit = false
        hum.WalkSpeed = math.max(hum.WalkSpeed, 16)
        hum.JumpPower = math.max(hum.JumpPower, 50)
        hum:SetStateEnabled(Enum.HumanoidStateType.Running, true)
        hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
        hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        task.defer(function()
            if hum and hum.Parent then
                hum:ChangeState(Enum.HumanoidStateType.Running)
            end
        end)
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    end)
end

local function ApplyAntiRagdoll()
    if not State.AntiRagdoll.Enabled then return end
    local char = LocalPlayer.Character
    local hum  = GetHum(LocalPlayer)
    local root = GetRoot(LocalPlayer)
    if not hum or not char or not root then return end

    SaveMotors(char)

    local st = hum:GetState()
    local isDown = st == Enum.HumanoidStateType.Ragdoll
                or st == Enum.HumanoidStateType.FallingDown
                or st == Enum.HumanoidStateType.Physics

    -- detección simple de "piedra" / frozen (medusa)
    local frozen = false
    if root.Anchored then frozen = true end
    if hum.WalkSpeed < 0.5 and hum.JumpPower < 1 then frozen = true end
    pcall(function()
        for _, v in SafeIPairs(char:GetDescendants()) do
            if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" and v.Anchored then
                frozen = true
                break
            end
        end
    end)

    if isDown or frozen then
        lastStoneTime = tick()
        ForceUnfreeze(char, hum, root)
    else
        -- si acabamos de salir de piedra y estamos en el suelo, forzar movimiento usable
        if tick() - lastStoneTime < 2.5 then
            pcall(function()
                if hum:GetState() == Enum.HumanoidStateType.Freefall
                or hum:GetState() == Enum.HumanoidStateType.GettingUp then
                    hum:ChangeState(Enum.HumanoidStateType.Running)
                end
                hum.PlatformStand = false
                hum.WalkSpeed = math.max(hum.WalkSpeed, 16)
            end)
        end
    end
end

-- =========================================================
-- TARGET / AIMBOT / AUTO HIT (vuela hasta el hitbox)
-- =========================================================

local function GetClosest()
    local myRoot = GetRoot(LocalPlayer)
    if not myRoot then return nil end
    local best, bestD = nil, math.huge
    for _, p in SafeIPairs(Players:GetPlayers()) do
        if p and p ~= LocalPlayer and ValidChar(p) then
            local r = GetRoot(p)
            if r then
                local d = (r.Position - myRoot.Position).Magnitude
                if d < bestD then bestD = d; best = p end
            end
        end
    end
    return best
end

local function UpdateTarget()
    if State.AutoHit.Enabled or State.Aimbot.Enabled then
        CurrentTarget = GetClosest()
    else
        CurrentTarget = nil
    end
end

local function UpdateAimbot(target, dt)
    if not State.Aimbot.Enabled or not target or not ValidChar(target) then return end
    local r = GetRoot(target)
    if not r or not Camera then return end
    local tp = r.Position + Vector3.new(0, 1.5, 0)
    local alpha = 1 - math.pow(0.01, math.clamp(dt * 18, 0, 1))
    pcall(function()
        local nCF = Camera.CFrame:Lerp(CFrame.lookAt(Camera.CFrame.Position, tp), alpha)
        if hasSeti then seti(Camera, "CFrame", nCF) else Camera.CFrame = nCF end
    end)
end

local function TryAutoHit(target, dt)
    if not State.AutoHit.Enabled or not target or not ValidChar(target) then return end

    local myRoot = GetRoot(LocalPlayer)
    local tRoot  = GetRoot(target)
    local hum    = GetHum(LocalPlayer)
    if not myRoot or not tRoot then return end

    local dist = (tRoot.Position - myRoot.Position).Magnitude
    local hitRadius = 9 -- distancia a la que considera "dentro del hitbox"

    -- vuelo continuo hacia el jugador (estilo fly suave)
    local goal = tRoot.Position + Vector3.new(0, 1.2, 0)
    local dir  = goal - myRoot.Position
    local speed = 85

    pcall(function()
        if dist > hitRadius then
            local step = SafeUnit(dir) * math.min(speed * dt * 60, dist)
            myRoot.CFrame = CFrame.new(myRoot.Position + step)
            if myRoot.AssemblyLinearVelocity then
                myRoot.AssemblyLinearVelocity = SafeUnit(dir) * speed
            end
        else
            -- ya dentro del hitbox → pegar
            myRoot.CFrame = CFrame.new(goal)
            if hasFTI then
                firetouchinterest(myRoot, tRoot, 0)
                task.wait(0.01)
                firetouchinterest(myRoot, tRoot, 1)
            end
            local char = LocalPlayer.Character
            if char then
                local tool = char:FindFirstChildOfClass("Tool")
                if tool then
                    pcall(function()
                        tool:Activate()
                    end)
                    local remote = tool:FindFirstChildOfClass("RemoteEvent")
                              or tool:FindFirstChildOfClass("RemoteFunction")
                    if remote and remote:IsA("RemoteEvent") then
                        pcall(function() remote:FireServer(tRoot.Position) end)
                    end
                end
            end
        end
    end)
end

-- =========================================================
-- INFINITE JUMP — impulso (sin SetStateEnabled → menos ban)
-- =========================================================

UserInputService.JumpRequest:Connect(function()
    if not State.InfJump.Enabled or jumpDb then return end
    local hum  = GetHum(LocalPlayer)
    local root = GetRoot(LocalPlayer)
    if not hum or not root or hum.Health <= 0 then return end
    if State.Fly.Enabled then return end

    jumpDb = true
    pcall(function()
        -- impulso vertical limpio, no toca states detectables
        local v = root.AssemblyLinearVelocity
        root.AssemblyLinearVelocity = Vector3.new(v.X, 55, v.Z)
        -- fallback BodyVelocity corto
        local bv = Instance.new("BodyVelocity")
        bv.Name = "__dbJump"
        bv.MaxForce = Vector3.new(0, 1e5, 0)
        bv.Velocity = Vector3.new(0, 55, 0)
        bv.Parent = root
        task.delay(0.12, function()
            if bv and bv.Parent then bv:Destroy() end
        end)
    end)
    task.delay(0.18, function() jumpDb = false end)
end)

-- =========================================================
-- HEARTBEAT
-- =========================================================

RunService.Heartbeat:Connect(function(dt)
    if State.Speed.Enabled and not State.Fly.Enabled then
        ApplySpeedBV()
    elseif not State.Speed.Enabled and SpeedBV then
        RemoveSpeedBV()
    end

    if State.Fly.Enabled then
        ApplyFly()
    elseif FlyBV then
        RemoveFly()
    end

    ApplyAntiRagdoll()
    TryAutoSteal(dt)

    TargetAccumulator = TargetAccumulator + dt
    if TargetAccumulator >= TARGET_UPDATE_RATE then
        TargetAccumulator = 0
        UpdateTarget()
    end

    if State.Aimbot.Enabled and CurrentTarget then
        UpdateAimbot(CurrentTarget, dt)
    end
    if State.AutoHit.Enabled and CurrentTarget then
        TryAutoHit(CurrentTarget, dt)
    end
end)

