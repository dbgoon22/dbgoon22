local function addHit(jobId, maxVal, brainrotName, players)
    if maxVal < MIN_VALUE then return end
    for _, s in ipairs(getgenv().SAB_Finder.Found) do
        if s.jobId == jobId then
            if maxVal > s.maxVal then
                s.maxVal = maxVal
                s.brainrotName = brainrotName or s.brainrotName
                s.players = players or s.players
                refreshUI()
            end
            return
        end
    end
    table.insert(getgenv().SAB_Finder.Found, {
        jobId = jobId,
        maxVal = maxVal,
        brainrotName = brainrotName or "Unknown",
        players = players or #Players:GetPlayers()
    })
    table.sort(getgenv().SAB_Finder.Found, function(a, b) return a.maxVal > b.maxVal end)
    refreshUI()
end

----------------------------------------------------------------------
-- AutoJoin loop
----------------------------------------------------------------------
local cache, idx = {}, 1

autoBtn.MouseButton1Click:Connect(function()
    getgenv().SAB_Finder.AutoJoin = not getgenv().SAB_Finder.AutoJoin
    autoBtn.Text = "Finder AutoJoin: " .. (getgenv().SAB_Finder.AutoJoin and "ON" or "OFF")
    autoBtn.BackgroundColor3 = getgenv().SAB_Finder.AutoJoin
        and Color3.fromRGB(30, 100, 50) or Color3.fromRGB(40, 40, 58)

    if not getgenv().SAB_Finder.AutoJoin then
        status.Text = "AutoJoin off"
        return
    end

    status.Text = "buscando (≥" .. MIN_PLAYERS .. " players + 100M+)..."
    task.spawn(function()
        while getgenv().SAB_Finder.AutoJoin do
            task.wait(2.8) -- esperar carga

            local pc = #Players:GetPlayers()
            if pc < MIN_PLAYERS then
                status.Text = "pocos players (" .. pc .. ") → hop"
            else
                local maxV, name = scanServer()
                if maxV >= MIN_VALUE then
                    status.Text = "HIT  " .. name .. "  " .. formatVal(maxV) .. "/s"
                    addHit(game.JobId, maxV, name, pc)
                    task.wait(5) -- se queda en el bueno
                else
                    status.Text = "sin 100M+ (" .. pc .. "p) → hop"
                end
            end

            if not getgenv().SAB_Finder.AutoJoin then break end

            local stillGood = select(1, scanServer()) >= MIN_VALUE and #Players:GetPlayers() >= MIN_PLAYERS
            if not stillGood then
                if #cache == 0 or idx > #cache then
                    status.Text = "actualizando lista pública..."
                    cache = fetchServers()
                    idx = 1
                    if #cache == 0 then
                        status.Text = "sin servers ≥" .. MIN_PLAYERS .. "p, reintento..."
                        task.wait(4)
                    end
                end
                if cache[idx] then
                    local t = cache[idx]
                    idx += 1
                    if t.id ~= game.JobId then
                        status.Text = "hop → " .. t.players .. " players"
                        pcall(function() TS:TeleportToPlaceInstance(PLACE_ID, t.id, LP) end)
                        task.wait(7)
                    end
                else
                    task.wait(2)
                end
            else
                task.wait(3)
            end
        end
    end)
end)

