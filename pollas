----------------------------------------------------------------------
-- helpers
----------------------------------------------------------------------
local function formatVal(n)
    if n >= 1e9 then return string.format("%.2fB", n/1e9) end
    if n >= 1e6 then return string.format("%.1fM", n/1e6) end
    if n >= 1e3 then return string.format("%.0fK", n/1e3) end
    return tostring(math.floor(n))
end

local function parseGen(str)
    if not str or typeof(str) ~= "string" then return 0 end
    local s = str:lower():gsub(",", ""):gsub("%$", ""):gsub("%s+", "")
    -- captura 1.2m/s  213.7m  1b/s  etc
    local num, unit = s:match("([%d%.]+)([kmb]?)")
    if not num then return 0 end
    local n = tonumber(num) or 0
    if unit == "b" then n = n * 1e9
    elseif unit == "m" then n = n * 1e6
    elseif unit == "k" then n = n * 1e3
    end
    return n
end

local function isJunkName(t)
    if not t or #t < 2 then return true end
    local l = t:lower()
    if l:match("^[%d%.%s%$%/skmb,]+$") then return true end
    if l:find("plot") or l:find("podium") or l:find("base") or l:find("spawn") then return true end
    return false
end

----------------------------------------------------------------------
-- SCAN: Plots → AnimalPodiums + Billboards / NumberValues
----------------------------------------------------------------------
local function scanServer()
    local bestVal, bestName = 0, "Unknown"
    local hits = {}

    local plots = workspace:FindFirstChild("Plots")
    if not plots then
        -- fallback genérico
        for _, c in ipairs(workspace:GetChildren()) do
            if c:IsA("Folder") and (c.Name:lower():find("plot") or c:FindFirstChild("AnimalPodiums")) then
                plots = c
                break
            end
        end
    end
    if not plots then return 0, "Unknown", hits end

    for _, plot in ipairs(plots:GetChildren()) do
        local pods = plot:FindFirstChild("AnimalPodiums") or plot:FindFirstChild("Podiums")
        local searchRoot = pods or plot

        for _, pod in ipairs(searchRoot:GetChildren()) do
            local val = 0
            local name = pod.Name

            -- 1) NumberValue / IntValue directos
            for _, d in ipairs(pod:GetDescendants()) do
                if d:IsA("NumberValue") or d:IsA("IntValue") then
                    if d.Value > val then val = d.Value end
                end
            end

            -- 2) Textos de Billboard / SurfaceGui (lo más fiable para /s)
            for _, d in ipairs(pod:GetDescendants()) do
                if d:IsA("TextLabel") or d:IsA("TextButton") then
                    local txt = d.Text or ""
                    local parsed = parseGen(txt)
                    if parsed > val then val = parsed end
                    -- nombre: texto que no sea solo número
                    if not isJunkName(txt) and #txt > 2 and #txt < 60 then
                        if not txt:lower():find("/s") and not txt:lower():find("%$") then
                            name = txt:match("^%s*(.-)%s*$") or name
                        end
                    end
                end
            end

            -- 3) ProximityPrompt ObjectText
            for _, d in ipairs(pod:GetDescendants()) do
                if d:IsA("ProximityPrompt") and d.ObjectText and not isJunkName(d.ObjectText) then
                    name = d.ObjectText
                end
            end

            -- 4) atributos
            for _, attr in ipairs({"Income", "Generation", "Gen", "Value", "MoneyPerSecond", "CashPerSecond"}) do
                local a = pod:GetAttribute(attr)
                if a then
                    local n = typeof(a) == "number" and a or parseGen(tostring(a))
                    if n > val then val = n end
                end
            end

            if val >= MIN_VALUE then
                if val > bestVal then
                    bestVal = val
                    bestName = name
                end
                table.insert(hits, {val = val, name = name, plot = plot.Name})
            end
        end
    end

    table.sort(hits, function(a, b) return a.val > b.val end)
    return bestVal, bestName, hits
end

----------------------------------------------------------------------
-- public servers (solo ≥ MIN_PLAYERS)
----------------------------------------------------------------------
local function fetchServers()
    local list, cursor, pages = {}, "", 0
    while pages < 5 do
        local url = ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100"):format(PLACE_ID)
        if cursor ~= "" then url = url .. "&cursor=" .. cursor end
        local ok, body = pcall(function() return game:HttpGet(url) end)
        if not ok or not body then break end
        local data = HS:JSONDecode(body)
        if not data or not data.data then break end
        for _, s in ipairs(data.data) do
            local p = s.playing or 0
            local m = s.maxPlayers or 8
            if s.id ~= game.JobId and p >= MIN_PLAYERS and p < m then
                table.insert(list, {id = s.id, players = p, maxPlayers = m, ping = s.ping or 999})
            end
        end
        cursor = data.nextPageCursor
        if not cursor or cursor == "" then break end
        pages += 1
        task.wait(0.1)
    end
    table.sort(list, function(a, b)
        if a.players ~= b.players then return a.players > b.players end
        return (a.ping or 999) < (b.ping or 999)
    end)
    return list
end

