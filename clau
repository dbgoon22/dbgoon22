-- ===== Float =====
local function floatToBase()
    if not savedBasePosition then
        createNotification("Error", "Base position not set", 3)
        return
    end
    floatActive = true
    local character = player.Character
    if not character then floatActive = false return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then floatActive = false return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then humanoid:ChangeState(Enum.HumanoidStateType.Freefall) end
    FloatBtn.Text = "Floating..."
    local startTime = tick()
    local speed = 40
    if floatConnection then floatConnection:Disconnect() end
    floatConnection = RunService.Heartbeat:Connect(function()
        if not floatActive or not hrp or not hrp.Parent then
            floatConnection:Disconnect()
            FloatBtn.Text = "Float to Base"
            return
        end
        local target = savedBasePosition
        local dir = target - hrp.Position
        if dir.Magnitude < 3 or tick() - startTime > 15 then
            floatActive = false
            hrp.Velocity = Vector3.zero
            floatConnection:Disconnect()
            FloatBtn.Text = "Float to Base"
            return
        end
        hrp.Velocity = dir.Unit * speed
    end)
end

-- ===== Auto Steal — race condition fixed =====
local autoStealRunning = false  -- guard separado del toggle visual

local function toggleAutoSteal()
    if autoStealRunning then return end  -- bloquea re-entrada mientras corre
    if not savedBasePosition then
        createNotification("Error", "Set base position first", 3)
        return
    end

    autoStealActive = not autoStealActive
    AutoStealBtn.Text = "Auto Steal: " .. (autoStealActive and "ON" or "OFF")
    AutoStealBtn.BackgroundColor3 = autoStealActive and Color3.fromRGB(50, 120, 50) or Color3.fromRGB(70, 70, 70)

    if not autoStealActive then return end

    autoStealRunning = true
    disableAllFunctions()

    task.spawn(function()
        local character = player.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        if not character or not hrp then
            autoStealActive = false
            autoStealRunning = false
            AutoStealBtn.Text = "Auto Steal: OFF"
            AutoStealBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
            return
        end

        savedHeight = hrp.Position.Y
        hrp.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 200, 0))
        task.wait(1)

        local originalBase = savedBasePosition
        savedBasePosition = Vector3.new(originalBase.X, hrp.Position.Y, originalBase.Z)

        floatToBase()

        -- espera con timeout propio — sin task.delay suelto
        local deadline = tick() + 15
        while floatActive and tick() < deadline do
            task.wait()
        end
        if floatActive then
            -- timeout alcanzado: cancela el float manualmente
            floatActive = false
            if floatConnection then floatConnection:Disconnect() floatConnection = nil end
            FloatBtn.Text = "Float to Base"
        end

        if hrp and hrp.Parent then
            hrp.CFrame = CFrame.new(Vector3.new(hrp.Position.X, savedHeight, hrp.Position.Z))
        end
        savedBasePosition = originalBase

        autoStealActive = false
        autoStealRunning = false
        AutoStealBtn.Text = "Auto Steal: OFF"
        AutoStealBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
    end)
end

