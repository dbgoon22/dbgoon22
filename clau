-- ===== AutoFinder =====
local function parseGen(text)
    if not text then return 0 end
    text = tostring(text):lower():gsub("%$", ""):gsub(",", ""):gsub("%s", "")
    local num = tonumber(text:match("[%d%.]+")) or 0
    if text:find("b") then return num * 1e9
    elseif text:find("m") then return num * 1e6
    elseif text:find("k") then return num * 1e3
    end
    return num
end

local function scanCurrentServer()
    local found = {}
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return found end
    for _, plot in ipairs(plots:GetChildren()) do
        local podiums = plot:FindFirstChild("AnimalPodiums")
        if not podiums then continue end
        for _, podium in ipairs(podiums:GetChildren()) do
            local base   = podium:FindFirstChild("Base")
            local spawn  = base and base:FindFirstChild("Spawn")
            local attach = spawn and (spawn:FindFirstChild("Attachment") or spawn:FindFirstChild("PromptAttachment"))
            if not attach then continue end
            local overhead  = attach:FindFirstChild("AnimalOverhead") or attach:FindFirstChildWhichIsA("BillboardGui")
            if not overhead then continue end
            local nameLabel = overhead:FindFirstChild("DisplayName") or overhead:FindFirstChild("Name") or overhead:FindFirstChildWhichIsA("TextLabel")
            local genLabel  = overhead:FindFirstChild("Generation") or overhead:FindFirstChild("Income") or overhead:FindFirstChild("Gen")
            local name = nameLabel and nameLabel.Text or ""
            local gen  = genLabel  and parseGen(genLabel.Text) or 0
            if TARGET_NAMES[name] or gen >= MIN_GEN then
                table.insert(found, { name = name, gen = gen, plot = plot.Name })
            end
        end
    end
    return found
end

local function getBestServer()
    local url = ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100"):format(PLACE_ID)
    local ok, body = pcall(function() return game:HttpGet(url) end)
    if not ok or not body then return nil end
    local ok2, data = pcall(function() return HttpService:JSONDecode(body) end)
    if not ok2 or not data or not data.data then return nil end
    for _, server in ipairs(data.data) do
        if server.id ~= game.JobId
            and not hopBlacklist[server.id]
            and server.playing < server.maxPlayers
            and server.playing > 0 then
            return server.id
        end
    end
    return nil
end

local function hopServer()
    local jobId = getBestServer()
    if not jobId then
        createNotification("AutoFinder", "No free servers, retrying...", 2)
        return false
    end
    hopBlacklist[jobId] = true
    createNotification("AutoFinder", "Hopping...", 2)
    pcall(function()
        TeleportService:TeleportToPlaceInstance(PLACE_ID, jobId, player)
    end)
    return true
end

local function toggleAutoFinder()
    autoFinderActive = not autoFinderActive
    AutoFinderBtn.Text = "AutoFinder: " .. (autoFinderActive and "ON" or "OFF")
    AutoFinderBtn.BackgroundColor3 = autoFinderActive and Color3.fromRGB(50, 120, 50) or Color3.fromRGB(70, 70, 70)
    if autoFinderConnection then
        task.cancel(autoFinderConnection)
        autoFinderConnection = nil
    end
    if autoFinderActive then
        createNotification("AutoFinder", "Scanning for Money Puggy+", 3)
        autoFinderConnection = task.spawn(function()
            while autoFinderActive do
                local hits = scanCurrentServer()
                if #hits > 0 then
                    local msg = ""
                    for i, h in ipairs(hits) do
                        msg = msg .. h.name .. " (" .. string.format("%.1fM/s", h.gen / 1e6) .. ")"
                        if i < #hits then msg = msg .. " | " end
                    end
                    createNotification("FOUND!", msg, 8)
                    AutoFinderBtn.Text = "AutoFinder: FOUND"
                    AutoFinderBtn.BackgroundColor3 = Color3.fromRGB(200, 160, 0)
                    autoFinderActive = false
                    break
                end
                hopServer()
                task.wait(4)
            end
        end)
    end
end

