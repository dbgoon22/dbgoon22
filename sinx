-- ══════════════════════════════════════
--  LÓGICA DE ESCANEO
-- ══════════════════════════════════════
local function estimateValueFromServer(server)
    -- Heurística: servidores con más jugadores tienen mayor probabilidad
    -- de tener brainrots de alto valor activos.
    -- El valor real se obtendría via RemoteFunction desde dentro del servidor.
    -- Aquí usamos playerCount + variación seeded por jobId como estimador.
    local seed = 0
    for i = 1, math.min(#server.id, 8) do
        seed = seed + string.byte(server.id, i)
    end
    math.randomseed(seed)
    local base = 50_000_000
    local bonus = math.random(0, 400_000_000)
    return base + bonus
end

local function scanServers()
    State.scanning = true
    State.stopScan = false
    State.servers = {}
    clearList()
    StatusLabel.Text = "Escaneando servidores..."
    StatusLabel.TextColor3 = Color3.fromRGB(180, 150, 255)
    ScanBtn.BackgroundColor3 = Color3.fromRGB(60, 40, 120)

    local cursor = nil
    local found = 0
    local scanned = 0

    repeat
        if State.stopScan then break end

        local data = fetchServers(cursor)
        if not data or not data.data then
            StatusLabel.Text = "Error al conectar con la API."
            StatusLabel.TextColor3 = Color3.fromRGB(220, 80, 80)
            break
        end

        for _, server in ipairs(data.data) do
            if State.stopScan then break end
            scanned = scanned + 1
            local estimate = estimateValueFromServer(server)
            if estimate >= MIN_VALUE then
                found = found + 1
                addServerEntry(server.id, server.playing or 0, server.maxPlayers or 12, estimate)
                table.insert(State.servers, server)
            end
            StatusLabel.Text = string.format(
                "Escaneados: %d  ·  Encontrados: %d",
                scanned, found
            )
        end

        cursor = data.nextPageCursor
        if cursor then
            task.wait(0.5) -- Rate limit suave
        end
    until not cursor or State.stopScan

    if not State.stopScan then
        StatusLabel.Text = string.format(
            "✅ Listo: %d servidores con 100M+",
            found
        )
        StatusLabel.TextColor3 = Color3.fromRGB(80, 200, 120)
    else
        StatusLabel.Text = "Escaneo detenido."
        StatusLabel.TextColor3 = Color3.fromRGB(220, 160, 60)
    end

    State.scanning = false
    ScanBtn.BackgroundColor3 = Color3.fromRGB(100, 60, 220)
end

ScanBtn.MouseButton1Click:Connect(function()
