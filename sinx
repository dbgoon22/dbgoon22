--  FUNCIONES DE DETECCIÓN DE BRAINROT
-- ══════════════════════════════════════
local function getBrainrotValue(server)
    -- Intenta leer el valor del brainrot del thumbnail/job
    -- En SAB los valores altos suelen estar en el nombre del servidor o metadata
    local success, result = pcall(function()
        return server["maxPlayers"] or 0
    end)
    -- Simulación de valor: en entorno real se parsea via RemoteFunction o servidor
    return success and result or 0
end

local function fetchServers(cursor)
    local url = string.format(
        "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100%s",
        GAME_ID,
        cursor and ("&cursor=" .. cursor) or ""
    )
    local success, response = pcall(function()
        return game:HttpGet(url)
    end)
    if not success then return nil end
    local ok, data = pcall(HttpService.JSONDecode, HttpService, response)
    if not ok then return nil end
    return data
end

local function detectHighValueInServer(jobId)
    -- En SAB, el brainrot de alto valor modifica propiedades del workspace
    -- Buscamos instancias con valor >= 100M en el servidor actual como referencia
    -- Para servidores remotos se usa la API de thumbnails o player count como heurística
    for _, model in ipairs(workspace:GetDescendants()) do
        if model:IsA("Model") and model:FindFirstChild("Value") then
            local val = model.Value
            if typeof(val) == "Instance" and val:IsA("IntValue") then
                if val.Value >= MIN_VALUE then
                    return true, val.Value
                end
            end
        end
    end
    return false, 0
end

