UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

    -- toggle GUI con Y (prioridad)
    if input.KeyCode == State.Keybinds.ToggleGui then
        State.GuiVisible = not State.GuiVisible
        if Main then
            Main.Visible = State.GuiVisible
        end
        return
    end

    if listeningForBind then
        State.Keybinds[listeningForBind] = input.KeyCode
        if updateKeybindLabels then updateKeybindLabels() end
        listeningForBind = nil
        return
    end

    if input.KeyCode == State.Keybinds.AutoBat then
        State.AutoBat = not State.AutoBat
        if updateToggles then updateToggles() end
    elseif input.KeyCode == State.Keybinds.AutoSteal then
        State.AutoSteal = not State.AutoSteal
        if updateToggles then updateToggles() end
    elseif input.KeyCode == State.Keybinds.Speed then
        State.SpeedEnabled = not State.SpeedEnabled
        if updateToggles then updateToggles() end
    elseif input.KeyCode == State.Keybinds.InfJump then
        State.InfJump = not State.InfJump
        if updateToggles then updateToggles() end
    end
end)

