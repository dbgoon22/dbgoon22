    local btn = Instance.new("TextButton")
    btn.Size = UDim2.fromOffset(70, 24)
    btn.Position = UDim2.new(1, -80, 0.5, -12)
    btn.BackgroundColor3 = Color3.fromRGB(25, 35, 55)
