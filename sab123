-- SPEED (bypass más estable)
task.spawn(function()
    while true do
        if State.SpeedEnabled and Hum and Hum.Parent and HRP then
            -- método dual: WalkSpeed + velocity impulse suave
            Hum.WalkSpeed = State.SpeedValue
            if Hum.MoveDirection.Magnitude > 0.1 then
                local dir = Hum.MoveDirection.Unit
                HRP.AssemblyLinearVelocity = Vector3.new(
                    dir.X * State.SpeedValue * 1.05,
                    HRP.AssemblyLinearVelocity.Y,
                    dir.Z * State.SpeedValue * 1.05
                )
            end
        end
        task.wait(0.03)
    end
end)

-- INFINITE JUMP (sin matarte)
local lastJump = 0
UIS.JumpRequest:Connect(function()
    if not State.InfJump or not Hum or not Hum.Parent then return end
    local now = tick()
    if now - lastJump < 0.12 then return end
    lastJump = now

    -- forzar estado sin usar ChangeState agresivo que a veces mata
    Hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
    Hum:ChangeState(Enum.HumanoidStateType.Jumping)
    if HRP then
        local vel = HRP.AssemblyLinearVelocity
        HRP.AssemblyLinearVelocity = Vector3.new(vel.X, 50, vel.Z) -- impulso controlado
    end
end)

-- AUTO BAT (chase + aim + hit)
task.spawn(function()
    while true do
        if State.AutoBat and HRP and Hum and Hum.Parent then
            local target, dist = nearestPlayer(State.BatRange)
            if target and target.Character then
                local tHRP = target.Character:FindFirstChild("HumanoidRootPart")
                if tHRP then
                    -- chase
                    Hum:MoveTo(tHRP.Position)

                    -- aim
                    local lookPos = Vector3.new(tHRP.Position.X, HRP.Position.Y, tHRP.Position.Z)
                    HRP.CFrame = CFrame.lookAt(HRP.Position, lookPos)

                    -- equip + hitbox + swing
                    local bat = equipBat()
                    if bat then
                        if not batHitboxPart or not batHitboxPart.Parent then
                            createBatHitbox(bat)
                        end
                        if dist < (State.HitboxSize + 8) then
                            pcall(function() bat:Activate() end)
                        end
                    end
                end
            end
        else
            removeBatHitbox()
        end
        task.wait(0.08)
    end
end)

-- AUTO STEAL (más agresivo y fiable)
task.spawn(function()
    while true do
        if State.AutoSteal and HRP then
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("ProximityPrompt") and obj.Enabled then
                    local parent = obj.Parent
                    if parent then
                        local pos
                        if parent:IsA("BasePart") then
                            pos = parent.Position
                        elseif parent:IsA("Model") and parent.PrimaryPart then
                            pos = parent.PrimaryPart.Position
                        elseif parent:IsA("Attachment") then
                            pos = parent.WorldPosition
                        end

                        if pos then
                            local d = (pos - HRP.Position).Magnitude
                            if d <= State.StealRange then
                                firePrompt(obj)
                            end
                        end
                    end
                end
            end
        end
        task.wait(0.18)
    end
end)

