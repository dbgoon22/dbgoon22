-- ===================== UTILS =====================
local function getTool(nameContains)
    local function scan(container)
        if not container then return nil end
        for _, t in ipairs(container:GetChildren()) do
            if t:IsA("Tool") and string.find(string.lower(t.Name), string.lower(nameContains or "")) then
                return t
            end
        end
    end
    return scan(LP:FindFirstChild("Backpack")) or scan(Char)
end

local function equipBat()
    local bat = getTool("bat") or getTool("slap") or getTool("tung") or getTool("baseball")
    if bat and bat.Parent ~= Char and Hum then
        Hum:EquipTool(bat)
        return bat
    end
    return bat
end

local function nearestPlayer(maxDist)
    local closest, dist = nil, maxDist or math.huge
    if not HRP then return nil, dist end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local tHRP = p.Character:FindFirstChild("HumanoidRootPart")
            local tHum = p.Character:FindFirstChildOfClass("Humanoid")
            if tHRP and tHum and tHum.Health > 0 then
                local d = (tHRP.Position - HRP.Position).Magnitude
                if d < dist then
                    closest, dist = p, d
                end
            end
        end
    end
    return closest, dist
end

local function firePrompt(prompt)
    if typeof(fireproximityprompt) == "function" then
        pcall(fireproximityprompt, prompt)
    else
        pcall(function()
            prompt:InputHoldBegin()
            task.wait(math.max(prompt.HoldDuration or 0, 0.05) + 0.03)
            prompt:InputHoldEnd()
        end)
    end
end

-- ===================== HITBOX EXPAND =====================
local function createBatHitbox(bat)
    if batHitboxPart and batHitboxPart.Parent then
        batHitboxPart:Destroy()
    end
    local handle = bat:FindFirstChild("Handle")
    if not handle then return end

    local part = Instance.new("Part")
    part.Name = "dbgoon_hitbox"
    part.Size = Vector3.new(State.HitboxSize, State.HitboxSize, State.HitboxSize)
    part.Transparency = 0.85
    part.Color = Color3.fromRGB(0, 255, 180)
    part.Material = Enum.Material.ForceField
    part.CanCollide = false
    part.Massless = true
    part.Anchored = false
    part.Parent = bat

    local weld = Instance.new("Weld")
    weld.Part0 = handle
    weld.Part1 = part
    weld.C0 = CFrame.new(0, 0, -State.HitboxSize * 0.35)
    weld.Parent = part

    batHitboxPart = part
end

local function removeBatHitbox()
    if batHitboxPart and batHitboxPart.Parent then
        batHitboxPart:Destroy()
    end
    batHitboxPart = nil
end

