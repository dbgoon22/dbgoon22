local ScreenGui, Main

local function GetChar(p) return p and p.Character end
local function GetRoot(p)
    local c = GetChar(p)
    return c and c:FindFirstChild("HumanoidRootPart")
end
local function GetHum(p)
    local c = GetChar(p)
    return c and c:FindFirstChildOfClass("Humanoid")
end
local function ValidChar(p)
    if not p or not p.Parent then return false end
    local h, r = GetHum(p), GetRoot(p)
    return h ~= nil and r ~= nil and h.Health > 0
end

-- fuerza velocidad horizontal sin tocar demasiado la Y (evita kills)
local function ForceHorizontalVelocity(root, horiz)
    if not root then return end
    pcall(function()
        local v = root.AssemblyLinearVelocity
        local newY = v.Y
        -- si está cayendo muy fuerte, no empeorar
        if newY < -80 then newY = -40 end
        root.AssemblyLinearVelocity = Vector3.new(horiz.X, newY, horiz.Z)
    end)
end

-- =========================================================
-- SPEED (estable, no mata, funciona con brainrot)
-- =========================================================

local function ApplySpeed(dt)
    if not State.Speed.Enabled or State.Fly.Enabled then return end
    local root = GetRoot(LocalPlayer)
    local hum  = GetHum(LocalPlayer)
    if not root or not hum or hum.Health <= 0 then return end

    if OriginalWalkSpeeds[hum] == nil then
        OriginalWalkSpeeds[hum] = hum.WalkSpeed
    end
    pcall(function()
        hum.WalkSpeed = 16
        hum.JumpPower = math.max(hum.JumpPower, 50)
    end)

    local UIS = UserInputService
    local fwd = (UIS:IsKeyDown(Enum.KeyCode.W) or UIS:IsKeyDown(Enum.KeyCode.Up))    and 1 or 0
    local bwd = (UIS:IsKeyDown(Enum.KeyCode.S) or UIS:IsKeyDown(Enum.KeyCode.Down))  and 1 or 0
    local lft = (UIS:IsKeyDown(Enum.KeyCode.A) or UIS:IsKeyDown(Enum.KeyCode.Left))  and 1 or 0
    local rgt = (UIS:IsKeyDown(Enum.KeyCode.D) or UIS:IsKeyDown(Enum.KeyCode.Right)) and 1 or 0

    local speed = math.clamp(SafeNum(State.Speed.Value, 42), 1, 120)
    local move  = Vector3.zero

    if fwd + bwd + lft + rgt > 0 then
        local camCF   = Camera.CFrame
        local flatFwd = SafeUnit(Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z))
        local flatRgt = SafeUnit(Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z))
        move = SafeUnit(flatFwd * (fwd - bwd) + flatRgt * (rgt - lft)) * speed
    end

    ForceHorizontalVelocity(root, move)

    -- pequeño empujón de CFrame solo si hay input (ayuda a romper el agarre del brainrot)
    if move.Magnitude > 1 then
        pcall(function()
            root.CFrame = root.CFrame + Vector3.new(move.X, 0, move.Z) * dt * 0.22
        end)
    end
end

-- =========================================================
-- FLY (estable + override con brainrot)
-- =========================================================

local function ApplyFly(dt)
    if not State.Fly.Enabled then return end
    local root = GetRoot(LocalPlayer)
    local hum  = GetHum(LocalPlayer)
    if not root then return end

    if hum then
        pcall(function()
            hum.PlatformStand = true
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        end)
    end

    local UIS   = UserInputService
    local speed = math.clamp(SafeNum(State.Fly.Speed, 52), 1, 140)

    local fwd = (UIS:IsKeyDown(Enum.KeyCode.W) or UIS:IsKeyDown(Enum.KeyCode.Up))    and 1 or 0
    local bwd = (UIS:IsKeyDown(Enum.KeyCode.S) or UIS:IsKeyDown(Enum.KeyCode.Down))  and 1 or 0
    local lft = (UIS:IsKeyDown(Enum.KeyCode.A) or UIS:IsKeyDown(Enum.KeyCode.Left))  and 1 or 0
    local rgt = (UIS:IsKeyDown(Enum.KeyCode.D) or UIS:IsKeyDown(Enum.KeyCode.Right)) and 1 or 0
    local up  = UIS:IsKeyDown(Enum.KeyCode.Space) and 1 or 0
    local dn  = UIS:IsKeyDown(Enum.KeyCode.LeftControl) and 1 or 0

    local dir = Camera.CFrame.LookVector * (fwd - bwd)
              + Camera.CFrame.RightVector * (rgt - lft)
              + Vector3.new(0, 1, 0) * (up - dn)

    local vel = dir.Magnitude > 1e-3 and SafeUnit(dir) * speed or Vector3.zero

    pcall(function()
        root.AssemblyLinearVelocity = vel
        root.AssemblyAngularVelocity = Vector3.zero
        if vel.Magnitude > 0.4 then
            root.CFrame = CFrame.new(root.Position + vel * dt * 0.48)
        end
    end)
end

local function StopFly()
    local hum = GetHum(LocalPlayer)
    local root = GetRoot(LocalPlayer)
    if hum then
        pcall(function()
            hum.PlatformStand = false
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end)
    end
    if root then
        pcall(function()
            local v = root.AssemblyLinearVelocity
            root.AssemblyLinearVelocity = Vector3.new(0, math.clamp(v.Y, -40, 20), 0)
        end)
    end
end

-- =========================================================
-- AUTO STEAL — persigue y agarra en bucle
-- =========================================================

local function RefreshBrainrotCache()
    local found = {}
    local ok, descendants = pcall(function() return Workspace:GetDescendants() end)
    if not ok or type(descendants) ~= "table" then
        brainrotCache = found
        return
    end

    for _, obj in SafeIPairs(descendants) do
        if obj and (obj:IsA("Model") or obj:IsA("BasePart")) then
            local lname = string.lower(tostring(obj.Name or ""))
            if lname:find("brainrot") or lname:find("pet") or lname:find("steal") or lname:find("collect") or lname:find("item") then
                local owner = nil
                local p = obj.Parent
                for _ = 1, 12 do
                    if not p then break end
                    for _, plr in SafeIPairs(Players:GetPlayers()) do
                        if plr and plr ~= LocalPlayer then
                            local pname = tostring(plr.Name or "")
                            if p.Name == pname or string.find(tostring(p.Name), pname, 1, true) then
                                owner = plr
                                break
                            end
                        end
                    end
                    if owner then break end
                    p = p.Parent
                end
                if owner then
                    local posPart = obj:IsA("BasePart") and obj
                        or obj:FindFirstChild("HumanoidRootPart")
                        or obj.PrimaryPart
                        or obj:FindFirstChildWhichIsA("BasePart", true)
                    if posPart and posPart:IsA("BasePart") then
                        table.insert(found, { part = posPart, owner = owner, obj = obj })
                    end
                end
            end
        end
    end
    brainrotCache = found
    brainrotCacheTime = tick()
end

local function TryAutoSteal(dt)
    if not State.AutoSteal.Enabled then return end
    stealTimer = stealTimer + dt

    local myRoot = GetRoot(LocalPlayer)
    if not myRoot then return end

    if tick() - brainrotCacheTime > CACHE_TTL or #brainrotCache == 0 then
        RefreshBrainrotCache()
    end
    if #brainrotCache == 0 then return end

    -- ordenar por distancia
    table.sort(brainrotCache, function(a, b)
        local pa = a.part and a.part.Position or Vector3.zero
        local pb = b.part and b.part.Position or Vector3.zero
        return (pa - myRoot.Position).Magnitude < (pb - myRoot.Position).Magnitude
    end)

    local target = brainrotCache[1]
    if not target or not target.part or not target.part.Parent then
        RefreshBrainrotCache()
        return
    end

    local tPos = target.part.Position
    local dist = (tPos - myRoot.Position).Magnitude

    -- siempre se acerca / se pone encima (aunque aún no se pueda agarrar)
    local goal = tPos + Vector3.new(0, 2.8, 0)
    local dir  = goal - myRoot.Position

    pcall(function()
        if dist > 6 then
            -- persigue
            local stepSpeed = 95
            local step = SafeUnit(dir) * math.min(stepSpeed * dt, dist)
            myRoot.CFrame = CFrame.new(myRoot.Position + step)
            ForceHorizontalVelocity(myRoot, SafeUnit(dir) * stepSpeed)
        else
            -- ya encima → fuerza el agarre
            myRoot.CFrame = CFrame.new(goal)
            myRoot.AssemblyLinearVelocity = Vector3.new(0, -12, 0)

            if hasFTI and stealTimer > 0.08 then
                firetouchinterest(myRoot, target.part, 0)
                task.wait(0.01)
                firetouchinterest(myRoot, target.part, 1)
                stealTimer = 0
            end

            if hasFPP then
                local prompt = target.obj and target.obj:FindFirstChildWhichIsA("ProximityPrompt", true)
                if prompt then
                    pcall(function() fireproximityprompt(prompt) end)
                end
            end
        end
    end)
end

-- =========================================================
-- HITBOX (seti bypass)
-- =========================================================

local function GetHitboxSize()
    return math.clamp(SafeNum(State.Hitbox.Size, 14), 1, 80)
end

local function SaveOrigSize(player)
    if player == LocalPlayer then return end
    local r = GetRoot(player)
    if r and OriginalSizes[player] == nil then OriginalSizes[player] = r.Size end
end

local function ApplyHitbox(player)
    if player == LocalPlayer then return end
    local r = GetRoot(player)
    if not r then return end
    SaveOrigSize(player)
    local s = GetHitboxSize()
    pcall(function()
        if hasSeti then
            seti(r, "Size", Vector3.new(s, s, s))
        else
            r.Size = Vector3.new(s, s, s)
        end
        r.CanCollide = false
        r.Massless = true
        r.Transparency = 0.7
    end)
end

local function RestoreHitbox(player)
    if player == LocalPlayer then return end
    local r = GetRoot(player)
    local o = OriginalSizes[player]
    if r and o then
        pcall(function()
            if hasSeti then seti(r, "Size", o) else r.Size = o end
            r.CanCollide = true
            r.Massless = false
            r.Transparency = 0
        end)
    end
    OriginalSizes[player] = nil
end

local function SetAllHitboxes(en)
    for _, p in SafeIPairs(Players:GetPlayers()) do
        if p and p ~= LocalPlayer then
            if en then ApplyHitbox(p) else RestoreHitbox(p) end
        end
    end
end

local function UpdateHitboxSize()
    if not State.Hitbox.Enabled then return end
    for _, p in SafeIPairs(Players:GetPlayers()) do
        if p and p ~= LocalPlayer then ApplyHitbox(p) end
    end
end

-- =========================================================
-- ESP
-- =========================================================

local function RemoveESP(player)
    local o = ESPObjects[player]
    if o then pcall(function() o:Destroy() end); ESPObjects[player] = nil end
end

local function AddESP(player)
    if player == LocalPlayer then return end
    if not State.ESP.Enabled then RemoveESP(player) return end
    local char = player.Character
    if not char then return end
    local ex = ESPObjects[player]
    if ex and ex.Parent == char then
        ex.FillColor = State.ESP.Color
        ex.OutlineColor = State.ESP.Color
        return
    end
    RemoveESP(player)
    local hl = Instance.new("Highlight")
    hl.Name = GUI_NAME .. RandStr(4)
    hl.Adornee = char
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.FillColor = State.ESP.Color
    hl.OutlineColor = State.ESP.Color
    hl.FillTransparency = 0.6
    hl.OutlineTransparency = 0
    hl.Parent = char
    ESPObjects[player] = hl
end

local function RefreshESP()
    for _, p in SafeIPairs(Players:GetPlayers()) do
        if p and p ~= LocalPlayer then
            if State.ESP.Enabled then AddESP(p) else RemoveESP(p) end
        end
    end
end

-- =========================================================
-- ANTI RAGDOLL / MEDUSA
-- =========================================================

local function SaveMotors(char)
    if not char or SavedMotor6Ds[char] then return end
    local m = {}
    local ok, list = pcall(function() return char:GetDescendants() end)
    if not ok or type(list) ~= "table" then return end
    for _, v in SafeIPairs(list) do
        if v and v:IsA("Motor6D") then
            m[v] = { part0 = v.Part0, part1 = v.Part1, c0 = v.C0, c1 = v.C1 }
        end
    end
    SavedMotor6Ds[char] = m
end

local function RestoreMotors(char)
    if not char then return end
    local m = SavedMotor6Ds[char]
    if type(m) ~= "table" then return end
    for motor, d in pairs(m) do
        pcall(function()
            if motor and motor.Parent then
                motor.Enabled = true
                motor.Part0 = d.part0
                motor.Part1 = d.part1
                motor.C0 = d.c0
                motor.C1 = d.c1
            end
        end)
    end
end

local function KillConstraints(char)
    if not char then return end
    local ok, list = pcall(function() return char:GetDescendants() end)
    if not ok or type(list) ~= "table" then return end
    for _, v in SafeIPairs(list) do
        if v and (v:IsA("BallSocketConstraint") or v:IsA("HingeConstraint") or v:IsA("WeldConstraint")) then
            pcall(function() v:Destroy() end)
        end
    end
end

local function ForceUnfreeze(char, hum, root)
    if not char or not hum or not root then return end
    pcall(function()
        for _, part in SafeIPairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.Anchored and part.Name ~= "HumanoidRootPart" then
                part.Anchored = false
            end
        end
        root.Anchored = false
        RestoreMotors(char)
        KillConstraints(char)
        hum.PlatformStand = false
        hum.Sit = false
        hum.WalkSpeed = math.max(hum.WalkSpeed, 16)
        hum.JumpPower = math.max(hum.JumpPower, 50)
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        task.defer(function()
            if hum and hum.Parent then
                hum:ChangeState(Enum.HumanoidStateType.Running)
            end
        end)
        root.AssemblyLinearVelocity = Vector3.zero
    end)
end

local function ApplyAntiRagdoll()
    if not State.AntiRagdoll.Enabled then return end
    local char = LocalPlayer.Character
    local hum  = GetHum(LocalPlayer)
    local root = GetRoot(LocalPlayer)
    if not hum or not char or not root then return end

    SaveMotors(char)
    local st = hum:GetState()
    local isDown = st == Enum.HumanoidStateType.Ragdoll
                or st == Enum.HumanoidStateType.FallingDown
                or st == Enum.HumanoidStateType.Physics

    local frozen = root.Anchored or (hum.WalkSpeed < 0.5 and hum.JumpPower < 1)
    if not frozen then
        pcall(function()
            for _, v in SafeIPairs(char:GetDescendants()) do
                if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" and v.Anchored then
                    frozen = true
                    break
                end
            end
        end)
    end

    if isDown or frozen then
        lastStoneTime = tick()
        ForceUnfreeze(char, hum, root)
    elseif tick() - lastStoneTime < 2.0 then
        pcall(function()
            if hum:GetState() == Enum.HumanoidStateType.Freefall or hum:GetState() == Enum.HumanoidStateType.GettingUp then
                hum:ChangeState(Enum.HumanoidStateType.Running)
            end
            hum.PlatformStand = false
            hum.WalkSpeed = math.max(hum.WalkSpeed, 16)
        end)
    end
end

-- =========================================================
-- TARGET / AIMBOT / AUTO HIT
-- =========================================================

local function GetClosest()
    local myRoot = GetRoot(LocalPlayer)
    if not myRoot then return nil end
    local best, bestD = nil, math.huge
    for _, p in SafeIPairs(Players:GetPlayers()) do
        if p and p ~= LocalPlayer and ValidChar(p) then
            local r = GetRoot(p)
            if r then
                local d = (r.Position - myRoot.Position).Magnitude
                if d < bestD then bestD = d; best = p end
            end
        end
    end
    return best
end

local function UpdateTarget()
    if State.AutoHit.Enabled or State.Aimbot.Enabled then
        CurrentTarget = GetClosest()
    else
        CurrentTarget = nil
    end
end

local function UpdateAimbot(target, dt)
    if not State.Aimbot.Enabled or not target or not ValidChar(target) then return end
    local r = GetRoot(target)
    if not r or not Camera then return end
    local tp = r.Position + Vector3.new(0, 1.4, 0)
    local alpha = 1 - math.pow(0.015, math.clamp(dt * 14, 0, 1))
    pcall(function()
        local nCF = Camera.CFrame:Lerp(CFrame.lookAt(Camera.CFrame.Position, tp), alpha)
        if hasSeti then seti(Camera, "CFrame", nCF) else Camera.CFrame = nCF end
    end)
end

local function TryAutoHit(target, dt)
    if not State.AutoHit.Enabled or not target or not ValidChar(target) then return end
    local myRoot = GetRoot(LocalPlayer)
    local tRoot  = GetRoot(target)
    if not myRoot or not tRoot then return end

    local dist = (tRoot.Position - myRoot.Position).Magnitude
    local hitRadius = 8.5
    local goal = tRoot.Position + Vector3.new(0, 1.1, 0)
    local dir  = goal - myRoot.Position
    local speed = 70

    pcall(function()
        if dist > hitRadius then
            local step = SafeUnit(dir) * math.min(speed * dt, dist * 0.9)
            myRoot.CFrame = CFrame.new(myRoot.Position + step)
            ForceHorizontalVelocity(myRoot, SafeUnit(dir) * speed)
        else
            myRoot.CFrame = CFrame.new(goal)
            if hasFTI then
                firetouchinterest(myRoot, tRoot, 0)
                task.wait(0.01)
                firetouchinterest(myRoot, tRoot, 1)
            end
            local char = LocalPlayer.Character
            if char then
                local tool = char:FindFirstChildOfClass("Tool")
                if tool then
                    pcall(function() tool:Activate() end)
                end
            end
        end
    end)
end

-- =========================================================
-- INFINITE JUMP
-- =========================================================

UserInputService.JumpRequest:Connect(function()
    if not State.InfJump.Enabled or jumpDb or State.Fly.Enabled then return end
    local hum  = GetHum(LocalPlayer)
    local root = GetRoot(LocalPlayer)
    if not hum or not root or hum.Health <= 0 then return end

    jumpDb = true
    pcall(function()
        local v = root.AssemblyLinearVelocity
        root.AssemblyLinearVelocity = Vector3.new(v.X, 50, v.Z)
    end)
    task.delay(0.18, function() jumpDb = false end)
end)

-- =========================================================
-- HEARTBEAT
-- =========================================================

RunService.Heartbeat:Connect(function(dt)
    if State.Speed.Enabled and not State.Fly.Enabled then
        ApplySpeed(dt)
    end

    if State.Fly.Enabled then
        ApplyFly(dt)
    else
        local hum = GetHum(LocalPlayer)
        if hum and hum.PlatformStand then
            StopFly()
        end
    end

    ApplyAntiRagdoll()
    TryAutoSteal(dt)

    TargetAccumulator = TargetAccumulator + dt
    if TargetAccumulator >= TARGET_UPDATE_RATE then
        TargetAccumulator = 0
        UpdateTarget()
    end

    if State.Aimbot.Enabled and CurrentTarget then
        UpdateAimbot(CurrentTarget, dt)
    end
    if State.AutoHit.Enabled and CurrentTarget then
        TryAutoHit(CurrentTarget, dt)
    end

    -- reaplicar hitbox cada poco por si el juego lo resetea
    if State.Hitbox.Enabled and tick() % 1.2 < dt then
        UpdateHitboxSize()
    end
end)

-- =========================================================
-- PLAYER EVENTS
-- =========================================================

local function OnCharAdded(player)
    OriginalSizes[player] = nil
    task.delay(0.4, function()
        if not player or not player.Parent or not player.Character then return end
        if State.Hitbox.Enabled then ApplyHitbox(player) end
        if State.ESP.Enabled then AddESP(player) end
    end)
end

local function SetupPlayer(player)
    if not player or player == LocalPlayer or PlayerConnections[player] then return end
    local c = {}
    PlayerConnections[player] = c
    c.ca = player.CharacterAdded:Connect(function() OnCharAdded(player) end)
    c.cr = player.CharacterRemoving:Connect(function(char)
        local e = ESPObjects[player]
        if e and e.Adornee == char then RemoveESP(player) end
        OriginalSizes[player] = nil
        if char then SavedMotor6Ds[char] = nil end
    end)
    if player.Character then task.defer(function() OnCharAdded(player) end) end
end

local function CleanupPlayer(player)
    if not player then return end
    RemoveESP(player)
    local r = GetRoot(player)
    local o = OriginalSizes[player]
    if r and o then pcall(function() r.Size = o end) end
    OriginalSizes[player] = nil
    local c = PlayerConnections[player]
    if type(c) == "table" then
        for _, v in pairs(c) do pcall(function() v:Disconnect() end) end
    end
    PlayerConnections[player] = nil
    if CurrentTarget == player then CurrentTarget = nil end
end

for _, p in SafeIPairs(Players:GetPlayers()) do SetupPlayer(p) end
Players.PlayerAdded:Connect(SetupPlayer)
Players.PlayerRemoving:Connect(CleanupPlayer)

LocalPlayer.CharacterAdded:Connect(function(char)
    SavedMotor6Ds = {}
    brainrotCache = {}
    brainrotCacheTime = 0
    task.wait(0.35)
    if char then SaveMotors(char) end
end)

