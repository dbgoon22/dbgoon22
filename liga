local function Toggle(parent, label, desc, order, callback)
    local row = Instance.new("Frame", parent)
    row.Size = UDim2.new(1, 0, 0, 56)
    row.BackgroundColor3 = BG_ROW
    row.BorderSizePixel = 0
    row.LayoutOrder = order
    row.ZIndex = 4
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 12)

    local bar = Instance.new("Frame", row)
    bar.Size = UDim2.new(0, 3, 0, 36)
    bar.Position = UDim2.new(0, 0, 0.5, -18)
    bar.BackgroundColor3 = ACCENT
    bar.BorderSizePixel = 0
    bar.ZIndex = 6
    Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

    local lbl = Instance.new("TextLabel", row)
    lbl.Size = UDim2.new(1, -80, 0, 24)
    lbl.Position = UDim2.new(0, 14, 0, 7)
    lbl.BackgroundTransparency = 1
    lbl.Text = label
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 14
    lbl.TextColor3 = TEXT_1
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex = 5

    if desc then
        local sub = Instance.new("TextLabel", row)
        sub.Size = UDim2.new(1, -80, 0, 16)
        sub.Position = UDim2.new(0, 14, 0, 32)
        sub.BackgroundTransparency = 1
        sub.Text = desc
        sub.Font = Enum.Font.Gotham
        sub.TextSize = 11
        sub.TextColor3 = TEXT_DIM
        sub.TextXAlignment = Enum.TextXAlignment.Left
        sub.ZIndex = 5
    end

    local bg = Instance.new("Frame", row)
    bg.Size = UDim2.new(0, 46, 0, 24)
    bg.Position = UDim2.new(1, -58, 0.5, -12)
    bg.BackgroundColor3 = OFF_CLR
    bg.BorderSizePixel = 0
    bg.ZIndex = 5
    Instance.new("UICorner", bg).CornerRadius = UDim.new(1, 0)

    local dot = Instance.new("Frame", bg)
    dot.Size = UDim2.new(0, 18, 0, 18)
    dot.Position = UDim2.new(0, 3, 0.5, -9)
    dot.BackgroundColor3 = Color3.fromRGB(160, 130, 210)
    dot.BorderSizePixel = 0
    dot.ZIndex = 6
    Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

    local enabled = false
    local function SetState(v, inv)
        enabled = v == true
        TweenService:Create(bg, TweenInfo.new(0.18), { BackgroundColor3 = enabled and ON_COLOR or OFF_CLR }):Play()
        TweenService:Create(dot, TweenInfo.new(0.18), {
            Position = enabled and UDim2.new(0, 25, 0.5, -9) or UDim2.new(0, 3, 0.5, -9),
            BackgroundColor3 = enabled and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(160, 130, 210)
        }):Play()
        TweenService:Create(bar, TweenInfo.new(0.18), { BackgroundColor3 = enabled and ACCENT2 or ACCENT }):Play()
        if inv ~= false then callback(enabled) end
    end

    bg.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then SetState(not enabled) end
    end)
    return { Set = function(v) SetState(v) end, Get = function() return enabled end }
end

local function NumberBox(parent, label, desc, order, def, mn, mx, cb)
    local row = Instance.new("Frame", parent)
    row.Size = UDim2.new(1, 0, 0, 62)
    row.BackgroundColor3 = BG_ROW
    row.BorderSizePixel = 0
    row.LayoutOrder = order
    row.ZIndex = 4
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 12)

    local bar = Instance.new("Frame", row)
    bar.Size = UDim2.new(0, 3, 0, 38)
    bar.Position = UDim2.new(0, 0, 0.5, -19)
    bar.BackgroundColor3 = ACCENT2
    bar.BorderSizePixel = 0
    bar.ZIndex = 6
    Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

    local t = Instance.new("TextLabel", row)
    t.Size = UDim2.new(1, -140, 0, 24)
    t.Position = UDim2.new(0, 14, 0, 8)
    t.BackgroundTransparency = 1
    t.Text = label
    t.Font = Enum.Font.GothamBold
    t.TextSize = 14
    t.TextColor3 = TEXT_1
    t.TextXAlignment = Enum.TextXAlignment.Left
    t.ZIndex = 5

    local s = Instance.new("TextLabel", row)
    s.Size = UDim2.new(1, -140, 0, 16)
    s.Position = UDim2.new(0, 14, 0, 34)
    s.BackgroundTransparency = 1
    s.Text = desc
    s.Font = Enum.Font.Gotham
    s.TextSize = 11
    s.TextColor3 = TEXT_DIM
    s.TextXAlignment = Enum.TextXAlignment.Left
    s.ZIndex = 5

    local box = Instance.new("TextBox", row)
    box.Size = UDim2.new(0, 88, 0, 34)
    box.Position = UDim2.new(1, -100, 0.5, -17)
    box.BackgroundColor3 = BG_DARK
    box.BorderSizePixel = 0
    box.Text = tostring(def)
    box.Font = Enum.Font.GothamBold
    box.TextSize = 14
    box.TextColor3 = Color3.fromRGB(255, 255, 255)
    box.ClearTextOnFocus = false
    box.ZIndex = 5
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 8)
    local bs = Instance.new("UIStroke", box)
    bs.Thickness = 1.2
    bs.Color = ACCENT
    bs.Transparency = 0.6

    local function Apply()
        local v = math.clamp(math.floor(SafeNum(box.Text, def)), mn, mx)
        box.Text = tostring(v)
        cb(v)
        return v
    end
    box.FocusLost:Connect(Apply)
    return { Apply = Apply, Box = box }
end

