local TabButtons = {}
local PageFrames = {}

local function CreatePage(name)
    local sc = Instance.new("ScrollingFrame", Pages)
    sc.Name = name .. "P"
    sc.Size = UDim2.fromScale(1, 1)
    sc.BackgroundTransparency = 1
    sc.BorderSizePixel = 0
    sc.ScrollBarThickness = 4
    sc.ScrollBarImageColor3 = ACCENT
    sc.AutomaticCanvasSize = Enum.AutomaticSize.Y
    sc.CanvasSize = UDim2.new(0, 0, 0, 0)
    sc.Visible = false
    sc.ZIndex = 3
    local lay = Instance.new("UIListLayout", sc)
    lay.Padding = UDim.new(0, 7)
    lay.SortOrder = Enum.SortOrder.LayoutOrder
    local pad = Instance.new("UIPadding", sc)
    pad.PaddingTop = UDim.new(0, 8)
    pad.PaddingLeft = UDim.new(0, 4)
    pad.PaddingRight = UDim.new(0, 4)
    pad.PaddingBottom = UDim.new(0, 10)
    PageFrames[name] = sc
    return sc
end

local function SetTab(name)
    for n, p in pairs(PageFrames) do p.Visible = (n == name) end
    for n, b in pairs(TabButtons) do
        local a = (n == name)
        b.BackgroundColor3 = a and ACCENT or Color3.fromRGB(28, 22, 52)
        b.TextColor3 = a and Color3.fromRGB(255, 255, 255) or TEXT_DIM
    end
end

local function MakeTab(name, icon)
    local btn = Instance.new("TextButton", TabBar)
    btn.Size = UDim2.new(0, 140, 0, 30)
    btn.BackgroundColor3 = Color3.fromRGB(28, 22, 52)
    btn.BorderSizePixel = 0
    btn.Text = icon .. "  " .. name
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.TextColor3 = TEXT_DIM
    btn.ZIndex = 4
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 9)
    TabButtons[name] = btn
    btn.MouseButton1Click:Connect(function() SetTab(name) end)
end

