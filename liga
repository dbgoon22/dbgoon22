}

local OriginalSizes      = {}
local OriginalWalkSpeeds = {}
local SavedMotor6Ds      = {}
local ESPObjects         = {}
local PlayerConnections  = {}

local GuiVisible        = true
local CurrentTarget     = nil
local TargetAccumulator = 0
local TARGET_UPDATE_RATE = 0.08

local stealTimer        = 0
local jumpDb            = false
