-- hop + load wait
----------------------------------------------------------------
local function waitForLoad(timeout)
    timeout = timeout or 18
    local t0 = tick()

    -- esperar character
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart", 8)
    if not hrp then return false end

    -- esperar que el mapa tenga algo de estructura
    while tick() - t0 < timeout do
        local hasStructure = workspace:FindFirstChild("Bases")
            or workspace:FindFirstChild("Plots")
            or workspace:FindFirstChild("Brains")
            or #workspace:GetChildren() > 15
        if hasStructure then
            task.wait(2.5) -- un poco más para que se repliquen los brainrots
            return true
        end
        task.wait(0.4)
    end
    return false
end

local function hop()
    if hopping then return end
    hopping = true
    setStatus("Obteniendo lista de servidores...", Color3.fromRGB(255, 200, 80))

    local servers = getServers(6)
    if #servers == 0 then
        setStatus("Sin servidores disponibles. Reintento en 4s...", Color3.fromRGB(255, 120, 120))
        hopping = false
        task.wait(4)
        return
    end

    local target = servers[1] -- el de menos jugadores
    setStatus(string.format("Hop → %d/%d jugadores", target.playing, target.max), Color3.fromRGB(255, 200, 80))
    addRecent(target.id)

    local success, err = pcall(function()
        TeleportService:TeleportToPlaceInstance(PlaceId, target.id, LocalPlayer)
    end)

    if not success then
        setStatus("Teleport falló: " .. tostring(err), Color3.fromRGB(255, 100, 100))
        -- reintento simple
        task.wait(2)
        pcall(function()
            TeleportService:TeleportToPlaceInstance(PlaceId, target.id, LocalPlayer)
        end)
    end
    hopping = false
end

local function checkCurrentServer()
    if not waitForLoad(16) then
        setStatus("Carga incompleta, saltando...", Color3.fromRGB(255, 160, 80))
        return false
    end

    local found = scanServer()
    if #found > 0 then
        foundSomething = true
        autoJoin = false
        AutoBtn.Text = "Auto Join: OFF"
        AutoBtn.BackgroundColor3 = Color3.fromRGB(38, 38, 46)

        local list = table.concat(found, ", ")
        setStatus("¡ENCONTRADO!\n" .. list, Color3.fromRGB(80, 255, 130))

        -- notificación grande
        local notif = Instance.new("TextLabel")
        notif.Size = UDim2.new(0, 420, 0, 70)
        notif.Position = UDim2.new(0.5, -210, 0.12, 0)
        notif.BackgroundColor3 = Color3.fromRGB(18, 55, 28)
        notif.Text = "BRAINROT DETECTADO\n" .. list
        notif.TextColor3 = Color3.fromRGB(110, 255, 140)
        notif.Font = Enum.Font.GothamBold
        notif.TextSize = 15
        notif.TextWrapped = true
        notif.Parent = ScreenGui
        Instance.new("UICorner", notif).CornerRadius = UDim.new(0, 8)
        task.delay(10, function() if notif then notif:Destroy() end end)
        return true
    end
    return false
end

