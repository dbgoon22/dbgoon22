local function setStatus(txt, color)
    Status.Text = txt
    if color then Status.TextColor3 = color end
end

local function addRecent(jobId)
    table.insert(recentJobs, 1, jobId)
    if #recentJobs > MAX_RECENT then table.remove(recentJobs) end
end

local function isRecent(jobId)
    for _, id in ipairs(recentJobs) do
        if id == jobId then return true end
    end
    return false
end

-- señales de que el objeto es realmente un brainrot (no un decorado random)
local VALUE_NAMES = {
    "PricePerSecond", "Value", "Income", "Generation", "CashPerSecond",
    "MoneyPerSecond", "Earn", "Rate", "IncomePerSecond"
}

local function hasIncomeSignal(obj)
    for _, name in ipairs(VALUE_NAMES) do
        local v = obj:FindFirstChild(name, true)
        if v and (v:IsA("NumberValue") or v:IsA("IntValue") or v:IsA("StringValue")) then
            return true
        end
    end
    -- billboard con texto de generación también cuenta
    for _, d in ipairs(obj:GetDescendants()) do
        if d:IsA("BillboardGui") or d:IsA("TextLabel") then
            local t = string.lower(tostring(d.Text or d.Name or ""))
            if t:find("/s") or t:find("m/s") or t:find("k/s") or t:find("b/s") then
                return true
            end
        end
    end
    return false
end

local function exactOrStrictMatch(name)
    local lower = string.lower(name)
    -- exacto primero
    if TARGET_SET[lower] then
        return TARGET_SET[lower]
    end
    -- strict: el nombre del target completo aparece como substring (evita "Antonio" random)
    for key, original in pairs(TARGET_SET) do
        if #key >= 6 and lower:find(key, 1, true) then  -- mínimo 6 chars para reducir falsos
            return original
        end
    end
    return nil
end

local function collectCandidates()
    local roots = {}
    -- contenedores típicos
    for _, name in ipairs({"Bases", "Plots", "Brains", "Мозги", "Animals", "Units", "Brainrots"}) do
        local f = workspace:FindFirstChild(name)
        if f then table.insert(roots, f) end
    end
    -- si no hay carpetas conocidas, caemos a workspace completo
    if #roots == 0 then
        table.insert(roots, workspace)
    end
    return roots
end

local function scanServer()
    local found = {}
    local seen = {}

    local function consider(obj)
        if not (obj:IsA("Model") or obj:IsA("BasePart") or obj:IsA("Folder")) then return end
        local match = exactOrStrictMatch(obj.Name)
        if not match then return end
        if seen[match] then return end

        -- exigir señal de income O estar dentro de una base/plot
        local inBase = false
        local p = obj.Parent
        while p and p ~= workspace do
            local pn = string.lower(p.Name)
            if pn:find("base") or pn:find("plot") or pn:find("podium") or pn:find("slot") then
                inBase = true
                break
            end
            p = p.Parent
        end

        if hasIncomeSignal(obj) or inBase then
            seen[match] = true
            table.insert(found, match)
        end
    end

    for _, root in ipairs(collectCandidates()) do
        for _, obj in ipairs(root:GetDescendants()) do
            consider(obj)
        end
        -- también los hijos directos del root
        for _, child in ipairs(root:GetChildren()) do
            consider(child)
        end
    end

    return found
end

----------------------------------------------------------------
-- server list (paginado real)
----------------------------------------------------------------
local function getServers(maxPages)
    maxPages = maxPages or 5
    local servers = {}
    local cursor = ""
    local pages = 0

    while pages < maxPages do
        pages = pages + 1
        local url = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
        if cursor ~= "" then
            url = url .. "&cursor=" .. HttpService:UrlEncode(cursor)
        end

        local ok, data = pcall(function()
            return HttpService:JSONDecode(game:HttpGet(url))
        end)

        if not ok or type(data) ~= "table" or not data.data then
            break
        end

        for _, s in ipairs(data.data) do
            if s.playing and s.maxPlayers and s.id
                and s.playing < s.maxPlayers
                and s.id ~= game.JobId
                and not isRecent(s.id)
            then
                table.insert(servers, {
                    id = s.id,
                    playing = s.playing,
                    max = s.maxPlayers
                })
            end
        end

        if not data.nextPageCursor or data.nextPageCursor == "" then
            break
        end
        cursor = data.nextPageCursor
        task.wait(0.15)
    end

    -- preferir servidores con pocos jugadores (más chance de rares sin pelea)
    table.sort(servers, function(a, b)
        return a.playing < b.playing
    end)

    return servers
end

