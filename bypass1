-- =========================================================
-- UTILITIES
-- =========================================================

local function GetCharacter(player)
    return player and player.Character
end

local function GetRoot(player)
    local char = GetCharacter(player)
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function GetHumanoid(player)
    local char = GetCharacter(player)
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function IsCharacterValid(player)
    if not player or not player.Parent then return false end
    local humanoid = GetHumanoid(player)
    local root     = GetRoot(player)
    return humanoid ~= nil
        and root    ~= nil
        and humanoid.Health > 0
end

local function SafeNumber(value, fallback)
    local n = tonumber(value)
    if not n or n ~= n or math.abs(n) == math.huge then
        return fallback
    end
    return n
end

-- =========================================================
-- HITBOX
-- BYPASS: seti() evita __newindex hooks del juego sobre Size.
-- =========================================================

local function GetHitboxSize()
    return math.clamp(SafeNumber(State.Hitbox.Size, 10), 1, 100)
end

local function SaveOriginalSize(player)
    if player == LocalPlayer then return end
    local root = GetRoot(player)
    if root and OriginalSizes[player] == nil then
        OriginalSizes[player] = root.Size
    end
end

local function ApplyHitbox(player)
    if player == LocalPlayer then return end
    local root = GetRoot(player)
    if not root then return end
    SaveOriginalSize(player)
    pcall(function()
        local s = GetHitboxSize()
        if hasSeti then
            seti(root, "Size", Vector3.new(s, s, s))
        else
            root.Size = Vector3.new(s, s, s)
        end
        root.CanCollide = false
    end)
end

local function RestoreHitbox(player)
    if player == LocalPlayer then return end
    local root     = GetRoot(player)
    local original = OriginalSizes[player]
    if root and original then
        pcall(function()
            if hasSeti then
                seti(root, "Size", original)
            else
                root.Size = original
            end
        end)
    end
    OriginalSizes[player] = nil
end

local function SetAllHitboxes(enabled)
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if enabled then ApplyHitbox(player)
            else            RestoreHitbox(player) end
        end
    end
end

local function UpdateHitboxSize()
    if not State.Hitbox.Enabled then return end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then ApplyHitbox(player) end
    end
end

-- =========================================================
-- ESP
-- =========================================================

local function RemoveESP(player)
    local obj = ESPObjects[player]
    if obj then
        pcall(function() obj:Destroy() end)
        ESPObjects[player] = nil
    end
end

local function AddESP(player)
    if player == LocalPlayer then return end
    if not State.ESP.Enabled then RemoveESP(player) return end
    local char = player.Character
    if not char then return end
    local existing = ESPObjects[player]
    if existing and existing.Parent == char then
        existing.FillColor    = State.ESP.Color
        existing.OutlineColor = State.ESP.Color
        return
    end
    RemoveESP(player)
    local hl = Instance.new("Highlight")
    hl.Name                = GUI_NAME .. "_ESP"
    hl.Adornee             = char
    hl.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
    hl.FillColor           = State.ESP.Color
    hl.OutlineColor        = State.ESP.Color
    hl.FillTransparency    = 0.75
    hl.OutlineTransparency = 0
    hl.Parent              = char
    ESPObjects[player]     = hl
end

local function RefreshESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if State.ESP.Enabled then AddESP(player)
            else                      RemoveESP(player) end
        end
    end
end

-- =========================================================
-- ANTI-RAGDOLL
-- BYPASS: guarda Motor6Ds, los restaura en cada frame ragdoll,
-- destruye BallSocket/Hinge inyectadas, fuerza GettingUp.
-- =========================================================

local function SaveMotor6Ds(character)
    if not character then return end
    if SavedMotor6Ds[character] then return end
    local motors = {}
    for _, v in ipairs(character:GetDescendants()) do
        if v:IsA("Motor6D") then
            motors[v] = {
                part0 = v.Part0,
                part1 = v.Part1,
                c0    = v.C0,
                c1    = v.C1,
            }
        end
    end
    SavedMotor6Ds[character] = motors
end

local function RestoreMotor6Ds(character)
    if not character then return end
    local motors = SavedMotor6Ds[character]
    if not motors then return end
    for motor, data in pairs(motors) do
        pcall(function()
            if motor and motor.Parent then
                motor.Enabled = true
                motor.Part0   = data.part0
                motor.Part1   = data.part1
                motor.C0      = data.c0
                motor.C1      = data.c1
            end
        end)
    end
end

local function RemoveRagdollConstraints(character)
    if not character then return end
    for _, v in ipairs(character:GetDescendants()) do
        if v:IsA("BallSocketConstraint") or v:IsA("HingeConstraint") then
            pcall(function() v:Destroy() end)
        end
    end
end

local function ApplyAntiRagdoll()
    if not State.AntiRagdoll.Enabled then return end
    local char     = LocalPlayer.Character
    local humanoid = GetHumanoid(LocalPlayer)
    if not humanoid or not char then return end
    SaveMotor6Ds(char)
    local state = humanoid:GetState()
    if state == Enum.HumanoidStateType.Ragdoll
        or state == Enum.HumanoidStateType.FallingDown then
        pcall(function()
            RestoreMotor6Ds(char)
            RemoveRagdollConstraints(char)
            humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        end)
    end
end

