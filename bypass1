-- SPEED
-- BYPASS: ClaimOwnership + WalkSpeed directo.
-- =========================================================

local SPEED_MAX = 500

local function GetSpeedValue()
    return math.clamp(SafeNumber(State.Speed.Value, 16), 1, SPEED_MAX)
end

local function RemoveSpeed()
    local humanoid = GetHumanoid(LocalPlayer)
    if humanoid then
        local orig = OriginalWalkSpeeds[humanoid]
        pcall(function()
            humanoid.WalkSpeed = orig or 16
        end)
        OriginalWalkSpeeds[humanoid] = nil
    end
end

local function ApplySpeed()
    local humanoid = GetHumanoid(LocalPlayer)
    if not humanoid or humanoid.Health <= 0 then return end
    if OriginalWalkSpeeds[humanoid] == nil then
        OriginalWalkSpeeds[humanoid] = humanoid.WalkSpeed
    end
    local root = GetRoot(LocalPlayer)
    if root then ClaimOwnership(root) end
    pcall(function()
        humanoid.WalkSpeed = GetSpeedValue()
    end)
end

-- =========================================================
-- INFINITE JUMP
-- BYPASS: SetStateEnabled(Landed, false) antes de saltar.
-- =========================================================

local jumpDebounce = false

UserInputService.JumpRequest:Connect(function()
    if not State.InfJump.Enabled then return end
    if jumpDebounce then return end
    local humanoid = GetHumanoid(LocalPlayer)
    if not humanoid or humanoid.Health <= 0 then return end
    jumpDebounce = true
    pcall(function()
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Landed, false)
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        task.delay(0.1, function()
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Landed, true)
        end)
    end)
    task.delay(0.15, function() jumpDebounce = false end)
end)

-- =========================================================
-- TARGET
-- =========================================================

local function GetClosestPlayer()
    local myRoot = GetRoot(LocalPlayer)
    if not myRoot then return nil end
    local closest, closestDist = nil, math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and IsCharacterValid(player) then
            local root = GetRoot(player)
            if root then
                local d = (root.Position - myRoot.Position).Magnitude
                if d < closestDist then
                    closestDist = d
                    closest     = player
                end
            end
        end
    end
    return closest
end

local function UpdateTarget()
    if State.AutoHit.Enabled or State.Aimbot.Enabled then
        CurrentTarget = GetClosestPlayer()
    else
        CurrentTarget = nil
    end
end

-- =========================================================
-- AIMBOT
-- BYPASS: seti en camera.CFrame si disponible.
-- =========================================================

local function UpdateAimbot(target, dt)
    if not State.Aimbot.Enabled then return end
    if not target or not IsCharacterValid(target) then return end
    local root   = GetRoot(target)
    local camera = workspace.CurrentCamera
    if not root or not camera then return end
    local targetPos = root.Position + Vector3.new(0, 2, 0)
    local alpha     = 1 - math.pow(0.01, math.clamp(dt * 12, 0, 1))
    pcall(function()
        local newCF = camera.CFrame:Lerp(
            CFrame.lookAt(camera.CFrame.Position, targetPos),
            alpha
        )
        if hasSeti then
            seti(camera, "CFrame", newCF)
        else
            camera.CFrame = newCF
        end
    end)
end

