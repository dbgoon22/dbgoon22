-- =========================================================
-- BYPASS: ENVIRONMENT DETECTION
-- rawget(_G, ...) nunca lanza error aunque el global no exista.
-- typeof(nil) devuelve "nil", no crashea.
-- =========================================================

local function hasGlobal(name)
    return typeof(rawget(_G, name)) == "function"
end

local hasGetHui       = hasGlobal("gethui")
local hasProtectGui   = hasGlobal("protect_gui")
local hasGetRawMeta   = hasGlobal("getrawmetatable")
local hasHookMeta     = hasGlobal("hookmetamethod")
local hasSeti         = hasGlobal("seti")
local hasCloneRef     = hasGlobal("cloneref")

-- =========================================================
-- SERVICES
-- =========================================================

local function SafeClone(service)
    if hasCloneRef then
        local ok, result = pcall(cloneref, service)
        if ok and result then return result end
    end
    return service
end

local Players          = SafeClone(game:GetService("Players"))
local RunService       = SafeClone(game:GetService("RunService"))
local UserInputService = SafeClone(game:GetService("UserInputService"))
local TweenService     = SafeClone(game:GetService("TweenService"))
local HttpService      = SafeClone(game:GetService("HttpService"))

