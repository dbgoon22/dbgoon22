        sub.Font                   = Enum.Font.Gotham
        sub.TextSize               = 11
        sub.TextColor3             = Color3.fromRGB(140, 120, 180)
        sub.TextXAlignment         = Enum.TextXAlignment.Left
        sub.ZIndex                 = 5
    end

    local bg = Instance.new("Frame", row)
    bg.Size             = UDim2.new(0, 42, 0, 22)
    bg.Position         = UDim2.new(1, -54, 0.5, -11)
    bg.BackgroundColor3 = Color3.fromRGB(50, 40, 80)
    bg.BorderSizePixel  = 0
    bg.ZIndex           = 5
    Instance.new("UICorner", bg).CornerRadius = UDim.new(1, 0)

    local dot = Instance.new("Frame", bg)
    dot.Size             = UDim2.new(0, 16, 0, 16)
    dot.Position         = UDim2.new(0, 3, 0.5, -8)
    dot.BackgroundColor3 = Color3.fromRGB(180, 150, 255)
    dot.BorderSizePixel  = 0
    dot.ZIndex           = 6
    Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

    local enabled = false
    local function SetState(value, invoke)
        enabled = value == true
        TweenService:Create(bg, TweenInfo.new(0.15), {
            BackgroundColor3 = enabled
                and Color3.fromRGB(120, 60, 255)
                or  Color3.fromRGB(50, 40, 80)
        }):Play()
        TweenService:Create(dot, TweenInfo.new(0.15), {
            Position = enabled
                and UDim2.new(0, 23, 0.5, -8)
                or  UDim2.new(0, 3,  0.5, -8)
        }):Play()
        if invoke ~= false then callback(enabled) end
    end

    bg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            SetState(not enabled)
        end
    end)

    return { Set = function(v) SetState(v) end, Get = function() return enabled end }
end

local function NumberBox(parent, label, description, order, defaultValue, minValue, maxValue, callback)
    local row = Instance.new("Frame", parent)
    row.Size             = UDim2.new(1, 0, 0, 58)
    row.BackgroundColor3 = Color3.fromRGB(22, 18, 40)
    row.BorderSizePixel  = 0
    row.LayoutOrder      = order
    row.ZIndex           = 4
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 10)

    local title = Instance.new("TextLabel", row)
    title.Size                   = UDim2.new(1, -130, 0, 24)
    title.Position               = UDim2.new(0, 12, 0, 6)
    title.BackgroundTransparency = 1
    title.Text                   = label
    title.Font                   = Enum.Font.GothamBold
    title.TextSize               = 14
    title.TextColor3             = Color3.fromRGB(240, 230, 255)
    title.TextXAlignment         = Enum.TextXAlignment.Left
    title.ZIndex                 = 5

    local sub = Instance.new("TextLabel", row)
    sub.Size                   = UDim2.new(1, -130, 0, 16)
    sub.Position               = UDim2.new(0, 12, 0, 30)
    sub.BackgroundTransparency = 1
    sub.Text                   = description
    sub.Font                   = Enum.Font.Gotham
    sub.TextSize               = 10
    sub.TextColor3             = Color3.fromRGB(140, 120, 180)
    sub.TextXAlignment         = Enum.TextXAlignment.Left
    sub.ZIndex                 = 5

    local box = Instance.new("TextBox", row)
    box.Size             = UDim2.new(0, 80, 0, 30)
    box.Position         = UDim2.new(1, -92, 0.5, -15)
    box.BackgroundColor3 = Color3.fromRGB(35, 28, 60)
    box.BorderSizePixel  = 0
    box.Text             = tostring(defaultValue)
    box.Font             = Enum.Font.GothamBold
    box.TextSize         = 13
    box.TextColor3       = Color3.fromRGB(255, 255, 255)
    box.ClearTextOnFocus = false
    box.ZIndex           = 5
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 7)

    local function Apply()
        local value = math.clamp(
            math.floor(SafeNumber(box.Text, defaultValue)),
            minValue, maxValue
        )
        box.Text = tostring(value)
        callback(value)
        return value
    end
    box.FocusLost:Connect(Apply)
    return { Apply = Apply, Box = box }
end

