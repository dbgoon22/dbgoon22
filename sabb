-- FLOAT
-- =========================================================

local function stopFloat()
    floatActive = false

    if floatConnection then
        floatConnection:Disconnect()
        floatConnection = nil
    end

    FloatBtn.Text = "Float to Base"
end

local function floatToBase()
    if floatActive then
        return
    end

    if not savedBasePosition then
        createNotification("Error", "Base position not set", 3)
        return
    end

    local character = player.Character
    if not character then
        return
    end

    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then
        return
    end

    floatActive = true
    FloatBtn.Text = "Floating..."

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
    end

    local startTime = time()
    local speed = 40

    if floatConnection then
        floatConnection:Disconnect()
    end

    floatConnection = RunService.Heartbeat:Connect(function()
        if not floatActive then
            return
        end

        if not hrp or not hrp.Parent then
            stopFloat()
            return
        end

        local target = savedBasePosition
        local dir = target - hrp.Position

        if dir.Magnitude < 3 or time() - startTime > 15 then
            hrp.AssemblyLinearVelocity = Vector3.zero
            stopFloat()
            return
        end

        hrp.AssemblyLinearVelocity = dir.Unit * speed
    end)
end

-- =========================================================
-- AUTOSTEAL
-- =========================================================

local function stopAutoSteal()
    autoStealToken += 1

    autoStealActive = false
    autoStealRunning = false

    stopFloat()

    AutoStealBtn.Text = "Auto Steal: OFF"
    AutoStealBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
end

local function toggleAutoSteal()
    if autoStealRunning then
        return
    end

    if not savedBasePosition then
        createNotification("Error", "Set base position first", 3)
        return
    end

    autoStealActive = not autoStealActive

    AutoStealBtn.Text =
        "Auto Steal: " .. (autoStealActive and "ON" or "OFF")

    AutoStealBtn.BackgroundColor3 =
        autoStealActive
        and Color3.fromRGB(50, 120, 50)
        or Color3.fromRGB(70, 70, 70)

    if not autoStealActive then
        return
    end

    autoStealRunning = true

    -- Desactiva solamente funciones de movimiento
    if noclipActive then
        toggleNoclip()
    end

    if flyActive then
        toggleFly()
    end

    if boostSpeedActive then
        boostSpeedActive = false

        if boostSpeedConnection then
            boostSpeedConnection:Disconnect()
            boostSpeedConnection = nil
        end

        BoostSpeedBtn.Text = "Boost Speed: OFF"
        BoostSpeedBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
    end

    autoStealToken += 1
    local currentToken = autoStealToken

    task.spawn(function()
        local character = player.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")

        if not character or not hrp then
            stopAutoSteal()
            return
        end

        savedHeight = hrp.Position.Y

        hrp.CFrame = CFrame.new(
            hrp.Position + Vector3.new(0, 200, 0)
        )

        task.wait(1)

        if currentToken ~= autoStealToken then
            return
        end

        if not hrp.Parent then
            stopAutoSteal()
            return
        end

        local originalBase = savedBasePosition

        -- Mantiene X/Z de la base pero usa la altura elevada
        savedBasePosition = Vector3.new(
            originalBase.X,
            hrp.Position.Y,
            originalBase.Z
        )

        floatToBase()

        local deadline = time() + 15

        while floatActive and time() < deadline do
            if currentToken ~= autoStealToken then
                return
            end

            task.wait()
        end

        if currentToken ~= autoStealToken then
            return
        end

        if floatActive then
            stopFloat()
        end

        if hrp and hrp.Parent then
            hrp.CFrame = CFrame.new(
                hrp.Position.X,
                savedHeight,
                hrp.Position.Z
            )

            hrp.AssemblyLinearVelocity = Vector3.zero
        end

        savedBasePosition = originalBase

        autoStealActive = false
        autoStealRunning = false

        AutoStealBtn.Text = "Auto Steal: OFF"
        AutoStealBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
    end)
end

