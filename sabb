local function destroyESPForPlayer(targetPlayer)
    local data = espHandles[targetPlayer]

    if data then
        if data.highlight and data.highlight.Parent then
            data.highlight:Destroy()
        end

        if data.billboard and data.billboard.Parent then
            data.billboard:Destroy()
        end
    end

    espHandles[targetPlayer] = nil
end

local function destroyAllESP()
    for targetPlayer in pairs(espHandles) do
        destroyESPForPlayer(targetPlayer)
    end

    table.clear(espHandles)
end

local function disconnectCharacterConnections()
    for targetPlayer, connection in pairs(characterConnections) do
        if connection then
            connection:Disconnect()
        end

        characterConnections[targetPlayer] = nil
    end
end

local function createESP(targetPlayer)
    if not targetPlayer or targetPlayer == player then
        return nil
    end

    local character = targetPlayer.Character
    if not character then
        return nil
    end

    destroyESPForPlayer(targetPlayer)

    local highlight = Instance.new("Highlight")
    highlight.Name = "ESP_Highlight"
    highlight.Adornee = character
    highlight.FillColor = Color3.fromRGB(255, 0, 0)
    highlight.FillTransparency = 0.5
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = character

    local billboard = nil

    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")

    if humanoidRootPart then
        billboard = Instance.new("BillboardGui")
        billboard.Name = "ESP_Billboard"
        billboard.AlwaysOnTop = true
        billboard.Size = UDim2.new(4, 0, 1, 0)
        billboard.StudsOffset = Vector3.new(0, 3, 0)
        billboard.Adornee = humanoidRootPart
        billboard.LightInfluence = 0
        billboard.Parent = humanoidRootPart

        local nameLabel = Instance.new("TextLabel")
        nameLabel.Name = "ESP_Name"
        nameLabel.Text = targetPlayer.Name
        nameLabel.TextColor3 = Color3.new(1, 1, 1)
        nameLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
        nameLabel.TextStrokeTransparency = 0
        nameLabel.TextSize = 14
        nameLabel.Font = Enum.Font.GothamBold
        nameLabel.BackgroundTransparency = 1
        nameLabel.Size = UDim2.new(1, 0, 1, 0)
        nameLabel.Parent = billboard
    end

    local data = {
        highlight = highlight,
        billboard = billboard
    }

    espHandles[targetPlayer] = data

    return data
end

local function setupESPPlayer(targetPlayer)
    if targetPlayer == player then
        return
    end

    createESP(targetPlayer)

    if characterConnections[targetPlayer] then
        characterConnections[targetPlayer]:Disconnect()
    end

    characterConnections[targetPlayer] =
        targetPlayer.CharacterAdded:Connect(function(character)
            if not espActive then
                return
            end

            local hrp = character:WaitForChild("HumanoidRootPart", 5)

            if not espActive then
                return
            end

            if hrp then
                createESP(targetPlayer)
            else
                createESP(targetPlayer)
            end
        end)
end

local function toggleESP()
    espActive = not espActive

    if ESPBtn then
        ESPBtn.Text = "ESP: " .. (espActive and "ON" or "OFF")
        ESPBtn.BackgroundColor3 =
            espActive
            and Color3.fromRGB(50, 120, 50)
            or Color3.fromRGB(70, 70, 70)
    end

    if espHeartbeatConnection then
        espHeartbeatConnection:Disconnect()
        espHeartbeatConnection = nil
    end

    if playerAddedConnection then
        playerAddedConnection:Disconnect()
        playerAddedConnection = nil
    end

    disconnectCharacterConnections()
    destroyAllESP()

    if not espActive then
        return
    end

    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        setupESPPlayer(targetPlayer)
    end

    playerAddedConnection = Players.PlayerAdded:Connect(function(targetPlayer)
        if espActive then
            setupESPPlayer(targetPlayer)
        end
    end)

    espHeartbeatConnection = RunService.Heartbeat:Connect(function()
        if not espActive then
            return
        end

        for targetPlayer, data in pairs(espHandles) do
            if not targetPlayer or not targetPlayer.Parent then
                destroyESPForPlayer(targetPlayer)
                continue
            end

            local character = targetPlayer.Character

            if character then
                if data.highlight and data.highlight.Parent then
                    data.highlight.Adornee = character
                end

                local hrp = character:FindFirstChild("HumanoidRootPart")

                if data.billboard and data.billboard.Parent and hrp then
                    data.billboard.Adornee = hrp
                end
            end
        end
    end)
end

