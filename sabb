local function toggleFly()
    if autoStealActive then
        return
    end

    flyActive = not flyActive

    FlyBtn.Text = "Fly: " .. (flyActive and "ON" or "OFF")
    FlyBtn.BackgroundColor3 =
        flyActive
        and Color3.fromRGB(50, 120, 50)
        or Color3.fromRGB(70, 70, 70)

    FlyGui.Visible = flyActive

    if flyConnection then
        flyConnection:Disconnect()
        flyConnection = nil
    end

    forwardActive = false
    backwardActive = false

    if not flyActive then
        local character = player.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")

        if hrp then
            hrp.AssemblyLinearVelocity = Vector3.zero
        end

        return
    end

    local character = player.Character
    if not character then
        flyActive = false
        FlyBtn.Text = "Fly: OFF"
        FlyGui.Visible = false
        return
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local hrp = character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not hrp then
        flyActive = false
        FlyBtn.Text = "Fly: OFF"
        FlyGui.Visible = false
        return
    end

    humanoid:ChangeState(Enum.HumanoidStateType.Freefall)

    local flySpeed = 50

    flyConnection = RunService.Heartbeat:Connect(function()
        if not flyActive then
            return
        end

        if not character.Parent or not hrp.Parent then
            flyActive = false
            FlyGui.Visible = false
            return
        end

        local camera = workspace.CurrentCamera

        if not camera then
            return
        end

        local look = camera.CFrame.LookVector
        local move = Vector3.zero

        if forwardActive then
            move += look
        end

        if backwardActive then
            move -= look
        end

        if move.Magnitude > 0 then
            move = move.Unit * flySpeed
        end

        hrp.AssemblyLinearVelocity = move
    end)
end

