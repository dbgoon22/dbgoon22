        BoostSpeedBtn.Text = "Boost Speed: OFF"
        BoostSpeedBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
        return
    end

    local hrp = character:FindFirstChild("HumanoidRootPart")

    if not hrp then
