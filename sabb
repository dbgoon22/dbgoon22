        local camera = workspace.CurrentCamera
        if not camera then
            return
        end

        local look = camera.CFrame.LookVector
        local horizontal = Vector3.new(look.X, 0, look.Z)

        if horizontal.Magnitude > 0.001 then
            hrp.AssemblyLinearVelocity =
                horizontal.Unit * speed
        else
            hrp.AssemblyLinearVelocity = Vector3.zero
        end
    end)
end

-- =========================================================
-- PARSE GENERATION
-- =========================================================

local function parseGen(text)
    if not text then
        return 0
    end

    text = tostring(text)
        :lower()
        :gsub("%$", "")
        :gsub(",", "")
        :gsub("%s", "")

    local num = tonumber(text:match("[%d%.]+")) or 0

    if text:find("b") then
        return num * 1e9
    elseif text:find("m") then
        return num * 1e6
    elseif text:find("k") then
        return num * 1e3
    end

    return num
end

-- =========================================================
-- SCAN CURRENT SERVER
-- =========================================================

local function scanCurrentServer()
    local found = {}

    local plots = workspace:FindFirstChild("Plots")
    if not plots then
        return found
    end

    for _, plot in ipairs(plots:GetChildren()) do
        local podiums = plot:FindFirstChild("AnimalPodiums")

        if not podiums then
            continue
        end

        for _, podium in ipairs(podiums:GetChildren()) do
            local base = podium:FindFirstChild("Base")
            local spawn = base and base:FindFirstChild("Spawn")

            local attach = spawn and (
                spawn:FindFirstChild("Attachment")
                or spawn:FindFirstChild("PromptAttachment")
            )

            if not attach then
                continue
            end

            local overhead =
                attach:FindFirstChild("AnimalOverhead")
                or attach:FindFirstChildWhichIsA("BillboardGui")

            if not overhead then
                continue
            end

            local nameLabel =
                overhead:FindFirstChild("DisplayName")
                or overhead:FindFirstChild("Name")
                or overhead:FindFirstChildWhichIsA("TextLabel")

            local genLabel =
                overhead:FindFirstChild("Generation")
                or overhead:FindFirstChild("Income")
                or overhead:FindFirstChild("Gen")

            local name = nameLabel and tostring(nameLabel.Text) or ""
            local gen = genLabel and parseGen(genLabel.Text) or 0

            -- IMPORTANT:
            -- Name in target list OR generation >= 20M/s
            if TARGET_NAMES[name] or gen >= MIN_GEN then
                table.insert(found, {
                    name = name,
                    gen = gen,
                    plot = plot.Name
                })
            end
        end
    end

    return found
end

-- =========================================================
-- SERVER LIST
-- =========================================================

local function getServers(cursor)
    local url =
        ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100")
        :format(PLACE_ID)

    if cursor then
        url = url .. "&cursor=" .. HttpService:UrlEncode(cursor)
    end

    local ok, body = pcall(function()
        return game:HttpGet(url)
    end)

    if not ok or not body then
        return nil
    end

    local decodeOk, data = pcall(function()
        return HttpService:JSONDecode(body)
    end)

    if not decodeOk or not data then
        return nil
    end

    return data
end

local function getNextServer()
    local cursor = nil

    for _ = 1, 3 do
        local data = getServers(cursor)

        if not data or not data.data then
            return nil
        end

        for _, server in ipairs(data.data) do
            if server.id ~= game.JobId
                and not hopBlacklist[server.id]
                and server.playing < server.maxPlayers
                and server.playing > 0 then

                return server.id
            end
        end

        cursor = data.nextPageCursor

        if not cursor then
            break
        end
    end

    return nil
end

-- =========================================================
-- SERVER HOP
-- =========================================================

local function hopServer()
    local jobId = getNextServer()

    if not jobId then
        createNotification(
            "AutoFinder",
            "No free servers, retrying...",
            2
        )

        return false
    end

    hopBlacklist[jobId] = true

    createNotification(
        "AutoFinder",
        "Hopping...",
        2
    )

    local ok, err = pcall(function()
        TeleportService:TeleportToPlaceInstance(
            PLACE_ID,
            jobId,
            player
        )
    end)

    if not ok then
        hopBlacklist[jobId] = nil

        createNotification(
            "Teleport Error",
            tostring(err),
            4
        )

        return false
    end

    return true
end

-- =========================================================
-- AUTOFINDER
-- =========================================================

local function stopAutoFinder()
    autoFinderActive = false

    if autoFinderThread then
        task.cancel(autoFinderThread)
        autoFinderThread = nil
    end

    AutoFinderBtn.Text = "AutoFinder: OFF"
    AutoFinderBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
end

local function toggleAutoFinder()
    if autoFinderActive then
        stopAutoFinder()
        return
    end

    autoFinderActive = true

    AutoFinderBtn.Text = "AutoFinder: ON"
    AutoFinderBtn.BackgroundColor3 = Color3.fromRGB(50, 120, 50)

    createNotification(
        "AutoFinder",
        "Scanning for targets...",
        3
    )

    autoFinderThread = task.spawn(function()
        while autoFinderActive do
            local hits = scanCurrentServer()

            if #hits > 0 then
                local parts = {}

                for _, hit in ipairs(hits) do
                    table.insert(
                        parts,
                        string.format(
                            "%s (%.1fM/s)",
                            hit.name,
                            hit.gen / 1e6
                        )
                    )
                end

                createNotification(
                    "FOUND!",
                    table.concat(parts, " | "),
                    8
                )

                autoFinderActive = false
                AutoFinderBtn.Text = "AutoFinder: FOUND"
                AutoFinderBtn.BackgroundColor3 =
                    Color3.fromRGB(200, 160, 0)

                autoFinderThread = nil
                return
            end

            if not autoFinderActive then
                return
            end

            hopServer()

            task.wait(4)
        end
    end)
end

