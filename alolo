local function formatVal(n)
    if n >= 1e9 then return string.format("%.2fB", n / 1e9) end
    if n >= 1e6 then return string.format("%.1fM", n / 1e6) end
    if n >= 1e3 then return string.format("%.0fK", n / 1e3) end
    return tostring(math.floor(n))
end

local function tryParseNumber(x)
    if typeof(x) == "number" then return x end
    if typeof(x) ~= "string" then return 0 end
    local s = x:lower():gsub(",", ""):gsub("%$", ""):gsub("/s", ""):gsub("%s+", "")
    local mul = 1
    if s:find("b") then mul = 1e9; s = s:gsub("b", "") end
    if s:find("m") then mul = 1e6; s = s:gsub("m", "") end
    if s:find("k") then mul = 1e3; s = s:gsub("k", "") end
    local n = tonumber(s)
    return n and n * mul or 0
end

-- saca valor + nombre legible del podium/modelo
local function getBrainrotInfo(obj)
    local bestVal = 0
    local bestName = obj.Name

    -- nombre preferido: DisplayName, ObjectText del prompt, o TextLabel grande
    local function considerName(str)
        if not str or str == "" then return end
        local clean = str:gsub("%s+", " "):match("^%s*(.-)%s*$")
        if #clean > 2 and not clean:match("^[%d%.%s%$%/s]+$") then
            bestName = clean
        end
    end

    considerName(obj.Name)
    if obj:GetAttribute("Name") then considerName(tostring(obj:GetAttribute("Name"))) end
    if obj:GetAttribute("DisplayName") then considerName(tostring(obj:GetAttribute("DisplayName"))) end

    for _, d in ipairs(obj:GetDescendants()) do
        if d:IsA("NumberValue") or d:IsA("IntValue") then
            local n = d.Value
            if n > bestVal then bestVal = n end
        elseif d:IsA("StringValue") then
            local n = tryParseNumber(d.Value)
            if n > bestVal then bestVal = n end
            if d.Name:lower():find("name") then considerName(d.Value) end
        elseif d:IsA("TextLabel") or d:IsA("TextButton") then
            local n = tryParseNumber(d.Text)
            if n > bestVal then bestVal = n end
            if #d.Text > 2 and not d.Text:match("^[%d%.%s%$%/s,]+$") then
                considerName(d.Text)
            end
        elseif d:IsA("ProximityPrompt") and d.ObjectText and d.ObjectText ~= "" then
            considerName(d.ObjectText)
        end
    end

    -- atributos de income comunes
    for _, attr in ipairs({"Income", "Value", "Generation", "Gen", "CashPerSecond", "MoneyPerSecond"}) do
        local a = obj:GetAttribute(attr)
        if a then
            local n = tryParseNumber(a)
            if n > bestVal then bestVal = n end
        end
    end

    return bestVal, bestName
end

local function scanCurrentServer()
    local maxV = 0
    local bestName = "Unknown"
    local hits = {}

    local roots = {}
    for _, name in ipairs({"Plots", "Bases", "PlotsFolder", "PlayerPlots"}) do
        local f = workspace:FindFirstChild(name)
        if f then table.insert(roots, f) end
    end
    if #roots == 0 then
        for _, c in ipairs(workspace:GetChildren()) do
            if c:IsA("Folder") or c:IsA("Model") then
                local ln = c.Name:lower()
                if c:FindFirstChild("AnimalPodiums") or ln:find("plot") or ln:find("base") then
                    table.insert(roots, c)
                end
            end
        end
    end

    for _, root in ipairs(roots) do
        for _, plot in ipairs(root:GetChildren()) do
            local pods = plot:FindFirstChild("AnimalPodiums") or plot:FindFirstChild("Podiums") or plot
            for _, pod in ipairs(pods:GetChildren()) do
                local val, name = getBrainrotInfo(pod)
                if val >= MIN_VALUE then
                    if val > maxV then
                        maxV = val
                        bestName = name
                    end
                    table.insert(hits, {value = val, name = name, plot = plot.Name})
                end
            end
            -- modelos sueltos con value
            for _, d in ipairs(plot:GetDescendants()) do
                if d:IsA("Model") then
                    local val, name = getBrainrotInfo(d)
                    if val >= MIN_VALUE then
                        if val > maxV then
                            maxV = val
                            bestName = name
                        end
                        table.insert(hits, {value = val, name = name, plot = plot.Name})
                    end
                end
            end
        end
    end

    -- ordenar hits por valor
    table.sort(hits, function(a, b) return a.value > b.value end)
    return maxV, bestName, hits
end

local function fetchPublicServers()
    local list = {}
    local cursor = ""
    local pages = 0
    while pages < 6 do
        local url = ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100"):format(PLACE_ID)
        if cursor ~= "" then url = url .. "&cursor=" .. cursor end
        local ok, body = pcall(function() return game:HttpGet(url) end)
        if not ok or not body then break end
        local data = HS:JSONDecode(body)
        if not data or not data.data then break end
        for _, s in ipairs(data.data) do
            local playing = s.playing or 0
            local maxP = s.maxPlayers or 8
            -- solo servers con gente real (no 0-1)
            if s.id ~= game.JobId and playing >= MIN_PLAYERS and playing < maxP then
                table.insert(list, {
                    id = s.id,
                    players = playing,
                    maxPlayers = maxP,
                    ping = s.ping or 999
                })
            end
        end
        cursor = data.nextPageCursor
        if not cursor or cursor == "" then break end
        pages += 1
        task.wait(0.12)
    end
    -- preferir servers con más jugadores (menos chance de bot solo)
    table.sort(list, function(a, b)
        if a.players ~= b.players then return a.players > b.players end
        return (a.ping or 999) < (b.ping or 999)
    end)
    return list
end

