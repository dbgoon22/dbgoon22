local function addFoundServer(jobId, maxVal, brainrotName, players)
    if maxVal < MIN_VALUE then return end
    for _, s in ipairs(getgenv().SAB_Finder.FoundServers) do
        if s.id == jobId then
            if maxVal > s.maxVal then
                s.maxVal = maxVal
                s.brainrotName = brainrotName or s.brainrotName
                s.players = players or s.players
                refreshListUI()
            end
            return
        end
    end
    table.insert(getgenv().SAB_Finder.FoundServers, {
        id = jobId,
        maxVal = maxVal,
        brainrotName = brainrotName or "Unknown",
        players = players or #Players:GetPlayers()
    })
    table.sort(getgenv().SAB_Finder.FoundServers, function(a, b) return a.maxVal > b.maxVal end)
    refreshListUI()
end

-- AutoJoin: hop solo a servers con ≥ MIN_PLAYERS; solo añade a lista si scan confirma 100M+
local hopIndex = 1
local serverCache = {}
local lastJob = ""

autoBtn.MouseButton1Click:Connect(function()
    getgenv().SAB_Finder.AutoJoin = not getgenv().SAB_Finder.AutoJoin
    autoBtn.Text = "Finder AutoJoin: " .. (getgenv().SAB_Finder.AutoJoin and "ON" or "OFF")
    autoBtn.BackgroundColor3 = getgenv().SAB_Finder.AutoJoin and Color3.fromRGB(35, 110, 55) or Color3.fromRGB(45, 45, 62)

    if not getgenv().SAB_Finder.AutoJoin then
        status.Text = "AutoJoin off"
        return
    end

    status.Text = "buscando servers con 100M+ (min " .. MIN_PLAYERS .. " players)..."
    task.spawn(function()
        while getgenv().SAB_Finder.AutoJoin do
            -- esperar a que el server cargue un poco
            task.wait(2.5)

            local playerCount = #Players:GetPlayers()
            if playerCount < MIN_PLAYERS then
                status.Text = "server con pocos players (" .. playerCount .. ") → hop"
            else
                local maxV, bName, hits = scanCurrentServer()
                if maxV >= MIN_VALUE then
                    status.Text = "HIT: " .. (bName or "?") .. "  " .. formatVal(maxV) .. "/s"
                    addFoundServer(game.JobId, maxV, bName, playerCount)
                    -- se queda en el server bueno; sigue scaneando por si sube otro
                    task.wait(4)
                else
                    status.Text = "sin 100M+ aquí (" .. playerCount .. "p) → hop"
                end
            end

            if not getgenv().SAB_Finder.AutoJoin then break end

            -- si no hay hit fuerte, hop a otro
            local maxV2 = select(1, scanCurrentServer())
            if maxV2 < MIN_VALUE or playerCount < MIN_PLAYERS then
                if #serverCache == 0 or hopIndex > #serverCache then
                    status.Text = "actualizando lista de servers..."
                    serverCache = fetchPublicServers()
                    hopIndex = 1
                    if #serverCache == 0 then
                        status.Text = "sin servers ≥" .. MIN_PLAYERS .. " players, reintento..."
                        task.wait(5)
                    end
                end
                if serverCache[hopIndex] then
                    local target = serverCache[hopIndex]
                    hopIndex += 1
                    if target.id ~= game.JobId then
                        status.Text = "hop → " .. target.players .. " players"
                        lastJob = target.id
                        pcall(function()
                            TS:TeleportToPlaceInstance(PLACE_ID, target.id, LP)
                        end)
                        -- después del teleport el loop se reinicia en el nuevo server
                        task.wait(8)
                    end
                else
                    task.wait(2)
                end
            else
                task.wait(3)
            end
        end
    end)
end)

