-- ========== HELPERS ==========
local function notify(title, text, duration)
    duration = duration or 4
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = duration,
        })
    end)
    print("[SAB Finder]", title, text)
end

local function normalize(s)
    return string.lower((s or ""):gsub("%s+", " "):match("^%s*(.-)%s*$") or "")
end

local function isTarget(name)
    local n = normalize(name)
    for t, on in pairs(selected) do
        if on and (n == normalize(t) or string.find(n, normalize(t), 1, true)) then
            return t
        end
    end
    return nil
end

-- scan current server for any selected target
local function scanServer()
    local hits = {}
    local roots = {
        workspace:FindFirstChild("Bases"),
        workspace:FindFirstChild("Plots"),
        workspace:FindFirstChild("Map"),
        workspace,
    }

    for _, root in ipairs(roots) do
        if not root then continue end
        for _, desc in ipairs(root:GetDescendants()) do
            if desc:IsA("Model") or desc:IsA("Folder") then
                local match = isTarget(desc.Name)
                if match then
                    local owner = "unknown"
                    local p = desc.Parent
                    while p and p ~= workspace do
                        if p.Name and #p.Name > 2 then
                            owner = p.Name
                            break
                        end
                        p = p.Parent
                    end
                    table.insert(hits, {name = match, owner = owner, instance = desc})
                end
            end
            -- also check StringValue / Billboard name labels
            if desc:IsA("StringValue") or desc:IsA("TextLabel") then
                local match = isTarget(desc.Value or desc.Text)
                if match then
                    table.insert(hits, {name = match, owner = desc.Parent and desc.Parent.Name or "?", instance = desc})
                end
            end
        end
    end

    -- players inventory / backpack style
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then continue end
        for _, folderName in ipairs({"Brainrots", "Pets", "Inventory", "Collection"}) do
            local folder = plr:FindFirstChild(folderName)
            if folder then
                for _, child in ipairs(folder:GetChildren()) do
                    local match = isTarget(child.Name)
                    if match then
                        table.insert(hits, {name = match, owner = plr.Name, instance = child})
                    end
                end
            end
        end
    end

    return hits
end

-- public server list (Roblox API)
local function getPublicServers()
    local ok, body = pcall(function()
        return game:HttpGet("https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100")
    end)
    if not ok or not body then return {} end
    local ok2, data = pcall(HttpService.JSONDecode, HttpService, body)
    if not ok2 or not data or not data.data then return {} end
    local list = {}
    for _, s in ipairs(data.data) do
        if s.id and s.id ~= game.JobId and s.playing and s.playing < (s.maxPlayers or 8) then
            table.insert(list, s.id)
        end
    end
    return list
end

local function hop()
    local servers = getPublicServers()
    if #servers == 0 then
        notify("Hop", "No public servers available right now")
        return
    end
    local target = servers[math.random(1, #servers)]
    notify("Hop", "Teleporting…")
    pcall(function()
        TeleportService:TeleportToPlaceInstance(PlaceId, target, LP)
    end)
end

