    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 10)

    local title = Instance.new("TextLabel", row)
    title.Size             = UDim2.new(1, -130, 0, 24)
    title.Position         = UDim2.new(0, 12, 0, 6)
    title.BackgroundTransparency = 1
    title.Text             = label
    title.Font             = Enum.Font.GothamBold
    title.TextSize         = 14
    title.TextColor3       = Color3.fromRGB(240, 230, 255)
    title.TextXAlignment   = Enum.TextXAlignment.Left
    title.ZIndex           = 5

    local sub = Instance.new("TextLabel", row)
    sub.Size             = UDim2.new(1, -130, 0, 16)
    sub.Position         = UDim2.new(0, 12, 0, 30)
    sub.BackgroundTransparency = 1
    sub.Text             = description
    sub.Font             = Enum.Font.Gotham
    sub.TextSize         = 10
    sub.TextColor3       = Color3.fromRGB(140, 120, 180)
    sub.TextXAlignment   = Enum.TextXAlignment.Left
    sub.ZIndex           = 5

    local box = Instance.new("TextBox", row)
    box.Size             = UDim2.new(0, 80, 0, 30)
    box.Position         = UDim2.new(1, -92, 0.5, -15)
    box.BackgroundColor3 = Color3.fromRGB(35, 28, 60)
    box.BorderSizePixel  = 0
    box.Text             = tostring(defaultValue)
    box.Font             = Enum.Font.GothamBold
    box.TextSize         = 13
    box.TextColor3       = Color3.fromRGB(255, 255, 255)
    box.ClearTextOnFocus = false
    box.ZIndex           = 5
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 7)

    local function Apply()
        local value = math.clamp(
            math.floor(SafeNumber(box.Text, defaultValue)),
            minValue, maxValue
        )
        box.Text = tostring(value)
        callback(value)
        return value
    end
    box.FocusLost:Connect(Apply)
    return { Apply = Apply, Box = box }
end

