-- Finder storage
local foundServers = {}
local foundCount   = 0

local function ClearFoundServers()
    table.clear(foundServers)
    foundCount = 0
end

local function AddUniqueServer(id)
    if typeof(id) ~= "string" or id == "" then return false end
    if foundServers[id] then return false end
    foundServers[id] = true
    foundCount += 1
    return true
end

local function ValidateFinderRange()
    local mn = math.clamp(math.floor(SafeNumber(State.Finder.MinPlayers, 0)),   0, 100)
    local mx = math.clamp(math.floor(SafeNumber(State.Finder.MaxPlayers, 100)), 0, 100)
    if mn > mx then mn, mx = mx, mn end
    State.Finder.MinPlayers = mn
    State.Finder.MaxPlayers = mx
    return mn, mx
end

local searchButton = Instance.new("TextButton", FinderPage)
searchButton.Size             = UDim2.new(1, 0, 0, 38)
searchButton.BackgroundColor3 = Color3.fromRGB(100, 50, 220)
searchButton.BorderSizePixel  = 0
searchButton.Text             = "⚡ BUSCAR SERVIDORES"
searchButton.Font             = Enum.Font.GothamBold
searchButton.TextSize         = 14
searchButton.TextColor3       = Color3.fromRGB(255, 255, 255)
searchButton.LayoutOrder      = 14
searchButton.ZIndex           = 5
Instance.new("UICorner", searchButton).CornerRadius = UDim.new(0, 10)

searchButton.MouseButton1Click:Connect(function()
    if FinderBusy then return end
    local minP, maxP = ValidateFinderRange()
    FinderBusy = true
    searchButton.Text = "⏳ Escaneando..."
    ClearFoundServers()
    finderLog.Text = "Escaneando servidores...\n"
    local placeId = game.PlaceId
    task.spawn(function()
        local cursor = ""
        for attempt = 1, 20 do
            local url = string.format(
                "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100%s",
                placeId,
                cursor ~= "" and "&cursor=" .. HttpService:UrlEncode(cursor) or ""
            )
            local ok, result = pcall(function()
                return HttpService:JSONDecode(game:HttpGet(url))
            end)
            if not ok or typeof(result) ~= "table" or typeof(result.data) ~= "table" then
                finderLog.Text = finderLog.Text .. string.format("⚠ Error en intento %d\n", attempt)
                break
            end
            for _, server in ipairs(result.data) do
                if typeof(server) == "table" then
                    local playing   = tonumber(server.playing)
                    local maxPlSrv  = tonumber(server.maxPlayers)
                    local id        = server.id
                    if playing and playing >= minP and playing <= maxP and AddUniqueServer(id) then
                        finderLog.Text = finderLog.Text .. string.format(
                            "✅ %s... | %d jugadores%s\n",
                            tostring(id):sub(1, 16),
                            playing,
                            maxPlSrv and ("/" .. maxPlSrv) or ""
                        )
                    end
                end
            end
            cursor = typeof(result.nextPageCursor) == "string" and result.nextPageCursor or ""
            if cursor == "" then break end
            task.wait(0.35)
        end
        finderLog.Text = finderLog.Text .. (
            foundCount > 0
            and string.format("\n✅ %d servidor(es) encontrados.", foundCount)
            or  string.format("\n❌ No se encontraron servidores con %d-%d jugadores.", minP, maxP)
        )
        searchButton.Text = "⚡ BUSCAR SERVIDORES"
        FinderBusy = false
    end)
end)

