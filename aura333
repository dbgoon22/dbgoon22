-- =========================================================
-- UTILITIES
-- =========================================================

local function GetCharacter(player)
    return player and player.Character
end

local function GetRoot(player)
    local char = GetCharacter(player)
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function GetHumanoid(player)
    local char = GetCharacter(player)
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function IsCharacterValid(player)
    if not player or not player.Parent then return false end
    local humanoid = GetHumanoid(player)
    local root     = GetRoot(player)
    return humanoid ~= nil
        and root     ~= nil
        and humanoid.Health > 0
end

local function SafeNumber(value, fallback)
    local n = tonumber(value)
    if not n or n ~= n or math.abs(n) == math.huge then
        return fallback
    end
    return n
end

-- =========================================================
-- HITBOX
-- =========================================================

local function GetHitboxSize()
    return math.clamp(SafeNumber(State.Hitbox.Size, 10), 1, 100)
end

local function SaveOriginalSize(player)
    if player == LocalPlayer then return end
    local root = GetRoot(player)
    if root and OriginalSizes[player] == nil then
        OriginalSizes[player] = root.Size
    end
end

local function ApplyHitbox(player)
    if player == LocalPlayer then return end
    local root = GetRoot(player)
    if not root then return end
    SaveOriginalSize(player)
    pcall(function()
        local s = GetHitboxSize()
        root.Size       = Vector3.new(s, s, s)
        root.CanCollide = false
    end)
end

local function RestoreHitbox(player)
    if player == LocalPlayer then return end
    local root     = GetRoot(player)
    local original = OriginalSizes[player]
    if root and original then
        pcall(function() root.Size = original end)
    end
    OriginalSizes[player] = nil
end

local function SetAllHitboxes(enabled)
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if enabled then ApplyHitbox(player)
            else            RestoreHitbox(player) end
        end
    end
end

local function UpdateHitboxSize()
    if not State.Hitbox.Enabled then return end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then ApplyHitbox(player) end
    end
end

-- =========================================================
-- ESP
-- =========================================================

local function RemoveESP(player)
    local obj = ESPObjects[player]
    if obj then
        pcall(function() obj:Destroy() end)
        ESPObjects[player] = nil
    end
end

local function AddESP(player)
    if player == LocalPlayer then return end
    if not State.ESP.Enabled then RemoveESP(player) return end
    local char = player.Character
    if not char then return end
    local existing = ESPObjects[player]
    if existing and existing.Parent == char then
        existing.FillColor    = State.ESP.Color
        existing.OutlineColor = State.ESP.Color
        return
    end
    RemoveESP(player)
    local hl = Instance.new("Highlight")
    hl.Name               = "dbgoon22_ESP"
    hl.Adornee            = char
    hl.DepthMode          = Enum.HighlightDepthMode.AlwaysOnTop
    hl.FillColor          = State.ESP.Color
    hl.OutlineColor       = State.ESP.Color
    hl.FillTransparency   = 0.75
    hl.OutlineTransparency = 0
    hl.Parent             = char
    ESPObjects[player]    = hl
end

local function RefreshESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if State.ESP.Enabled then AddESP(player)
            else                      RemoveESP(player) end
        end
    end
end

-- =========================================================
-- ANTI-RAGDOLL
-- =========================================================
-- Previene el estado Ragdoll forzando GettingUp cada frame.
-- También elimina restricciones Motor6D → BallSocketConstraint
-- que algunos juegos inyectan al hacer ragdoll.

local function RemoveRagdollConstraints(character)
    if not character then return end
    for _, v in ipairs(character:GetDescendants()) do
        if v:IsA("BallSocketConstraint")
            or v:IsA("HingeConstraint") then
            -- guardamos el tipo antes de destruir para logging
            pcall(function() v:Destroy() end)
        end
    end
end

local function ApplyAntiRagdoll()
    if not State.AntiRagdoll.Enabled then return end
    local humanoid = GetHumanoid(LocalPlayer)
    if not humanoid then return end
    local state = humanoid:GetState()
    if state == Enum.HumanoidStateType.Ragdoll
        or state == Enum.HumanoidStateType.FallingDown then
        pcall(function()
            humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        end)
        -- limpia constraints que el juego haya añadido
        RemoveRagdollConstraints(LocalPlayer.Character)
    end
end

-- =========================================================
-- SPEED BYPASS
-- =========================================================
-- BodyVelocity evita que el servidor detecte WalkSpeed alto
-- manteniendo el movimiento en el cliente.
-- Cap: 33.

local SPEED_MAX = 33

local function GetSpeedValue()
    return math.clamp(
        SafeNumber(State.Speed.Value, 16),
        1,
        SPEED_MAX
    )
end

local function RemoveSpeedBypass()
    if SpeedBodyVelocity then
        pcall(function() SpeedBodyVelocity:Destroy() end)
        SpeedBodyVelocity = nil
    end
    -- restaura WalkSpeed original
    local humanoid = GetHumanoid(LocalPlayer)
    if humanoid then
        local orig = OriginalWalkSpeeds[humanoid]
        pcall(function()
            humanoid.WalkSpeed = orig or 16
        end)
        OriginalWalkSpeeds[humanoid] = nil
    end
end

local function ApplySpeedBypass()
    local humanoid = GetHumanoid(LocalPlayer)
    local root     = GetRoot(LocalPlayer)
    if not humanoid or not root then return end
    if humanoid.Health <= 0 then return end

    -- guarda original una vez
    if OriginalWalkSpeeds[humanoid] == nil then
        OriginalWalkSpeeds[humanoid] = humanoid.WalkSpeed
    end

    local speed = GetSpeedValue()

    -- mantiene WalkSpeed bajo para evadir detecciones
    -- y usa BodyVelocity para el movimiento real
    pcall(function() humanoid.WalkSpeed = 16 end)

    -- crea o reutiliza BodyVelocity
    local bv = root:FindFirstChild("dbgoon22_SpeedBV")
    if not bv then
        bv          = Instance.new("BodyVelocity")
        bv.Name     = "dbgoon22_SpeedBV"
        bv.MaxForce = Vector3.new(1e5, 0, 1e5)
        bv.P        = 1e4
        bv.Parent   = root
        SpeedBodyVelocity = bv
    end

    -- dirección del movimiento desde MoveDirection del humanoid
    local dir = humanoid.MoveDirection
    if dir.Magnitude > 0.1 then
        bv.Velocity = dir * speed
    else
        bv.Velocity = Vector3.zero
    end
end

-- =========================================================
-- INFINITE JUMP BYPASS
-- =========================================================
-- Usa JumpRequest + ChangeState en loop con debounce.
-- El debounce evita el spam que algunos anti-cheats detectan.

local jumpDebounce = false

UserInputService.JumpRequest:Connect(function()
    if not State.InfJump.Enabled then return end
    if jumpDebounce then return end

    local humanoid = GetHumanoid(LocalPlayer)
    if not humanoid or humanoid.Health <= 0 then return end

    jumpDebounce = true
    pcall(function()
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end)
    task.delay(0.15, function() jumpDebounce = false end)
end)

-- Bypass adicional: cancela el estado Landed → resetea para
-- permitir el siguiente salto sin tocar suelo.
RunService.Stepped:Connect(function()
    if not State.InfJump.Enabled then return end
    local humanoid = GetHumanoid(LocalPlayer)
    if not humanoid or humanoid.Health <= 0 then return end
    local state = humanoid:GetState()
    if state == Enum.HumanoidStateType.Landed then
        -- no hace nada: deja al juego manejar Landed normalmente
        -- el bypass actúa en el siguiente JumpRequest
    end
end)

-- =========================================================
-- TARGET
-- =========================================================

local function GetClosestPlayer()
    local myRoot = GetRoot(LocalPlayer)
    if not myRoot then return nil end
    local closest, closestDist = nil, math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and IsCharacterValid(player) then
            local root = GetRoot(player)
            if root then
                local d = (root.Position - myRoot.Position).Magnitude
                if d < closestDist then
                    closestDist = d
                    closest     = player
                end
            end
        end
    end
    return closest
end

local function UpdateTarget()
    if State.AutoHit.Enabled or State.Aimbot.Enabled then
        CurrentTarget = GetClosestPlayer()
    else
        CurrentTarget = nil
    end
end

-- =========================================================
-- AIMBOT
-- =========================================================

local function UpdateAimbot(target, dt)
    if not State.Aimbot.Enabled then return end
    if not target or not IsCharacterValid(target) then return end
    local root   = GetRoot(target)
    local camera = workspace.CurrentCamera
    if not root or not camera then return end
    local targetPos = root.Position + Vector3.new(0, 2, 0)
    local alpha     = 1 - math.pow(0.01, math.clamp(dt * 12, 0, 1))
    pcall(function()
        camera.CFrame = camera.CFrame:Lerp(
            CFrame.lookAt(camera.CFrame.Position, targetPos),
            alpha
        )
    end)
end

-- =========================================================
-- AUTO HIT
-- =========================================================

local function TryAutoHit(target)
    if not State.AutoHit.Enabled then return end
    if not target or not IsCharacterValid(target) then return end
    local myRoot     = GetRoot(LocalPlayer)
    local targetRoot = GetRoot(target)
    if not myRoot or not targetRoot then return end
    if (targetRoot.Position - myRoot.Position).Magnitude > 8 then return end
    -- integra aquí el sistema de combate del juego
end

-- =========================================================
-- HEARTBEAT
-- =========================================================

RunService.Heartbeat:Connect(function(dt)

    -- Speed bypass
    if State.Speed.Enabled then
        ApplySpeedBypass()
    end

    -- Anti-ragdoll
    ApplyAntiRagdoll()

    -- Target update
    TargetAccumulator += dt
    if TargetAccumulator >= TARGET_UPDATE_RATE then
        TargetAccumulator = 0
        UpdateTarget()
    end

    if State.Aimbot.Enabled and CurrentTarget then
        UpdateAimbot(CurrentTarget, dt)
    end

    if State.AutoHit.Enabled and CurrentTarget then
        TryAutoHit(CurrentTarget)
    end
end)

-- =========================================================
-- CHARACTER EVENTS
-- =========================================================

local function OnCharacterAdded(player)
    OriginalSizes[player] = nil
    task.delay(0.5, function()
        if not player.Parent or not player.Character then return end
        if State.Hitbox.Enabled then ApplyHitbox(player) end
        if State.ESP.Enabled    then AddESP(player)      end
    end)
end

local function SetupPlayer(player)
    if player == LocalPlayer then return end
    if PlayerConnections[player] then return end
    local conns = {}
    PlayerConnections[player] = conns
    conns.CharacterAdded = player.CharacterAdded:Connect(function()
        OnCharacterAdded(player)
    end)
    conns.CharacterRemoving = player.CharacterRemoving:Connect(function(char)
        local esp = ESPObjects[player]
        if esp and esp.Adornee == char then RemoveESP(player) end
        OriginalSizes[player] = nil
    end)
    if player.Character then
        task.defer(function() OnCharacterAdded(player) end)
    end
end

local function CleanupPlayer(player)
    RemoveESP(player)
    local root     = GetRoot(player)
    local original = OriginalSizes[player]
    if root and original then
        pcall(function() root.Size = original end)
    end
    OriginalSizes[player] = nil
    local conns = PlayerConnections[player]
    if conns then
        for _, c in pairs(conns) do pcall(function() c:Disconnect() end) end
    end
    PlayerConnections[player] = nil
    if CurrentTarget == player then CurrentTarget = nil end
end

for _, player in ipairs(Players:GetPlayers()) do SetupPlayer(player) end
Players.PlayerAdded:Connect(SetupPlayer)
Players.PlayerRemoving:Connect(CleanupPlayer)

LocalPlayer.CharacterAdded:Connect(function()
    SpeedBodyVelocity = nil
    task.wait(0.5)
    if State.Speed.Enabled then ApplySpeedBypass() end
end)

