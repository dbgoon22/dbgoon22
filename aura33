-- =========================================================
-- FINDER STORAGE
-- =========================================================

local foundServers = {}
local foundCount = 0

local function ClearFoundServers()
    table.clear(foundServers)
    foundCount = 0
end

local function AddUniqueServer(id)
    if typeof(id) ~= "string"
        or id == "" then

        return false
    end

    if foundServers[id] then
        return false
    end

    foundServers[id] = true
    foundCount += 1

    return true
end

local function ValidateFinderRange()
    local minPlayers = math.clamp(
        math.floor(
            SafeNumber(
                State.Finder.MinPlayers,
                0
            )
        ),
        0,
        100
    )

    local maxPlayers = math.clamp(
        math.floor(
            SafeNumber(
                State.Finder.MaxPlayers,
                100
            )
        ),
        0,
        100
    )

    if minPlayers > maxPlayers then
        minPlayers, maxPlayers =
            maxPlayers, minPlayers
    end

    State.Finder.MinPlayers = minPlayers
    State.Finder.MaxPlayers = maxPlayers

    return minPlayers, maxPlayers
end

