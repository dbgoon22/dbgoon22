searchButton.MouseButton1Click:Connect(function()

    if FinderBusy then
        return
    end

    local minPlayers, maxPlayers =
        ValidateFinderRange()

    FinderBusy = true

    searchButton.Text =
        "⏳ Escaneando..."

    ClearFoundServers()

    finderLog.Text =
        "Escaneando servidores...\n"

    local placeId = game.PlaceId

    task.spawn(function()

        local cursor = ""

        for attempt = 1, 20 do

            local url =
                string.format(
                    "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100%s",
                    placeId,
                    cursor ~= ""
                        and "&cursor="
                            .. HttpService:UrlEncode(cursor)
                        or ""
                )

            local success, result =
                pcall(function()

                    local raw =
                        game:HttpGet(url)

                    return HttpService:JSONDecode(raw)
                end)

            if not success
                or typeof(result) ~= "table"
                or typeof(result.data) ~= "table" then

                finderLog.Text =
                    finderLog.Text
                    .. string.format(
                        "⚠ Error en intento %d\n",
                        attempt
                    )

                break
            end

            for _, server in ipairs(result.data) do

                if typeof(server) == "table" then

                    local playing =
                        tonumber(server.playing)

                    local maxPlayersServer =
                        tonumber(server.maxPlayers)

                    local id =
                        server.id

                    if playing
                        and playing >= minPlayers
                        and playing <= maxPlayers
                        and AddUniqueServer(id) then

                        finderLog.Text =
                            finderLog.Text
                            .. string.format(
                                "✅ %s... | %d jugadores",
                                tostring(id):sub(1, 16),
                                playing
                            )

                        if maxPlayersServer then
                            finderLog.Text =
                                finderLog.Text
                                .. string.format(
                                    "/%d",
                                    maxPlayersServer
                                )
                        end

                        finderLog.Text =
                            finderLog.Text .. "\n"
                    end
                end
            end

            cursor =
                typeof(result.nextPageCursor)
                    == "string"
                and result.nextPageCursor
                or ""

            if cursor == "" then
                break
            end

            task.wait(0.35)
        end

        if foundCount > 0 then

            finderLog.Text =
                finderLog.Text
                .. string.format(
                    "\n✅ %d servidor(es) encontrados.",
                    foundCount
                )

        else

            finderLog.Text =
                finderLog.Text
                .. string.format(
                    "\n❌ No se encontraron servidores " ..
                    "con %d-%d jugadores.",
                    minPlayers,
                    maxPlayers
                )
        end

        searchButton.Text =
            "⚡ BUSCAR SERVIDORES"

        FinderBusy = false
    end)
end)

