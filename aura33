-- =========================================================
-- TARGET
-- =========================================================

local function GetClosestPlayer()
    local myRoot = GetRoot(LocalPlayer)

    if not myRoot then
        return nil
    end

    local closest = nil
    local closestDistance = math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer
            and IsCharacterValid(player) then

            local root = GetRoot(player)

            if root then
                local distance =
                    (root.Position - myRoot.Position).Magnitude

                if distance < closestDistance then
                    closestDistance = distance
                    closest = player
                end
            end
        end
    end

    return closest
end

local function UpdateTarget()
    if State.AutoHit.Enabled
        or State.Aimbot.Enabled then

        CurrentTarget = GetClosestPlayer()
    else
        CurrentTarget = nil
    end
end

-- =========================================================
-- AIMBOT
-- =========================================================

local function UpdateAimbot(target, dt)
    if not State.Aimbot.Enabled then
        return
    end

    if not target
        or not IsCharacterValid(target) then

        return
    end

    local root = GetRoot(target)
    local camera = workspace.CurrentCamera

    if not root or not camera then
        return
    end

    local targetPosition =
        root.Position + Vector3.new(0, 2, 0)

    local currentPosition =
        camera.CFrame.Position

    local targetCFrame =
        CFrame.lookAt(
            currentPosition,
            targetPosition
        )

    local alpha =
        1 - math.pow(0.01, math.clamp(dt * 12, 0, 1))

    pcall(function()
        camera.CFrame =
            camera.CFrame:Lerp(
                targetCFrame,
                alpha
            )
    end)
end

-- =========================================================
-- AUTO HIT
-- =========================================================

-- Punto de integración deliberadamente vacío.
-- No se buscan ni ejecutan RemoteEvents arbitrarios.

local function TryAutoHit(target)
    if not State.AutoHit.Enabled then
        return
    end

    if not target
        or not IsCharacterValid(target) then

        return
    end

    local myRoot = GetRoot(LocalPlayer)
    local targetRoot = GetRoot(target)

    if not myRoot or not targetRoot then
        return
    end

    local distance =
        (targetRoot.Position - myRoot.Position).Magnitude

    if distance > 8 then
        return
    end

    -- Integra aquí únicamente el sistema de combate
    -- legítimo/documentado del juego.
end

-- =========================================================
-- HEARTBEAT
-- =========================================================

RunService.Heartbeat:Connect(function(dt)

    if State.Speed.Enabled then
        ApplySpeed()
    end

    TargetAccumulator += dt

    if TargetAccumulator >= TARGET_UPDATE_RATE then
        TargetAccumulator = 0
        UpdateTarget()
    end

    if State.Aimbot.Enabled
        and CurrentTarget then

        UpdateAimbot(CurrentTarget, dt)
    end

    if State.AutoHit.Enabled
        and CurrentTarget then

        TryAutoHit(CurrentTarget)
    end
end)

-- =========================================================
-- CHARACTER EVENTS
-- =========================================================

local function OnCharacterAdded(player)
    OriginalSizes[player] = nil

    task.delay(0.5, function()
        if not player.Parent then
            return
        end

        if not player.Character then
            return
        end

        if State.Hitbox.Enabled then
            ApplyHitbox(player)
        end

        if State.ESP.Enabled then
            AddESP(player)
        end
    end)
end

local function SetupPlayer(player)
    if player == LocalPlayer then
        return
    end

    if PlayerConnections[player] then
        return
    end

    local connections = {}

    PlayerConnections[player] = connections

    connections.CharacterAdded =
        player.CharacterAdded:Connect(function()
            OnCharacterAdded(player)
        end)

    connections.CharacterRemoving =
        player.CharacterRemoving:Connect(function(character)
            local esp = ESPObjects[player]

            if esp
                and esp.Adornee == character then

                RemoveESP(player)
            end

            OriginalSizes[player] = nil
        end)

    if player.Character then
        task.defer(function()
            OnCharacterAdded(player)
        end)
    end
end

local function CleanupPlayer(player)
    RemoveESP(player)

    local root = GetRoot(player)
    local original = OriginalSizes[player]

    if root and original then
        pcall(function()
            root.Size = original
        end)
    end

    OriginalSizes[player] = nil

    local connections = PlayerConnections[player]

    if connections then
        for _, connection in pairs(connections) do
            if connection then
                pcall(function()
                    connection:Disconnect()
                end)
            end
        end
    end

    PlayerConnections[player] = nil

    if CurrentTarget == player then
        CurrentTarget = nil
    end
end

for _, player in ipairs(Players:GetPlayers()) do
    SetupPlayer(player)
end

Players.PlayerAdded:Connect(SetupPlayer)
Players.PlayerRemoving:Connect(CleanupPlayer)

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)

    if State.Speed.Enabled then
        ApplySpeed()
    end
end)

