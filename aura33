-- =========================================================
-- UTILITIES
-- =========================================================

local function GetCharacter(player)
    return player and player.Character
end

local function GetRoot(player)
    local character = GetCharacter(player)

    if not character then
        return nil
    end

    return character:FindFirstChild("HumanoidRootPart")
end

local function GetHumanoid(player)
    local character = GetCharacter(player)

    if not character then
        return nil
    end

    return character:FindFirstChildOfClass("Humanoid")
end

local function IsCharacterValid(player)
    if not player or not player.Parent then
        return false
    end

    local character = GetCharacter(player)

    if not character then
        return false
    end

    local humanoid = GetHumanoid(player)
    local root = GetRoot(player)

    return humanoid ~= nil
        and root ~= nil
        and humanoid.Health > 0
end

local function SafeNumber(value, fallback)
    local number = tonumber(value)

    if not number
        or number ~= number
        or number == math.huge
        or number == -math.huge then

        return fallback
    end

    return number
end

-- =========================================================
-- HITBOX
-- =========================================================

local function GetHitboxSize()
    return math.clamp(
        SafeNumber(State.Hitbox.Size, 10),
        1,
        100
    )
end

local function SaveOriginalSize(player)
    if player == LocalPlayer then
        return
    end

    local root = GetRoot(player)

    if not root then
        return
    end

    if OriginalSizes[player] == nil then
        OriginalSizes[player] = root.Size
    end
end

local function ApplyHitbox(player)
    if player == LocalPlayer then
        return
    end

    local root = GetRoot(player)

    if not root then
        return
    end

    SaveOriginalSize(player)

    local size = GetHitboxSize()

    pcall(function()
        root.Size = Vector3.new(size, size, size)
        root.CanCollide = false
    end)
end

local function RestoreHitbox(player)
    if player == LocalPlayer then
        return
    end

    local root = GetRoot(player)
    local original = OriginalSizes[player]

    if root and original then
        pcall(function()
            root.Size = original
        end)
    end

    OriginalSizes[player] = nil
end

local function SetAllHitboxes(enabled)
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if enabled then
                ApplyHitbox(player)
            else
                RestoreHitbox(player)
            end
        end
    end
end

local function UpdateHitboxSize()
    if not State.Hitbox.Enabled then
        return
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            ApplyHitbox(player)
        end
    end
end

-- =========================================================
-- ESP
-- =========================================================

local function RemoveESP(player)
    local object = ESPObjects[player]

    if object then
        pcall(function()
            object:Destroy()
        end)

        ESPObjects[player] = nil
    end
end

local function AddESP(player)
    if player == LocalPlayer then
        return
    end

    if not State.ESP.Enabled then
        RemoveESP(player)
        return
    end

    local character = player.Character

    if not character then
        return
    end

    local existing = ESPObjects[player]

    if existing
        and existing.Parent == character then

        existing.FillColor = State.ESP.Color
        existing.OutlineColor = State.ESP.Color

        return
    end

    RemoveESP(player)

    local highlight = Instance.new("Highlight")

    highlight.Name = "dbgoon22_ESP"
    highlight.Adornee = character
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.FillColor = State.ESP.Color
    highlight.OutlineColor = State.ESP.Color
    highlight.FillTransparency = 0.75
    highlight.OutlineTransparency = 0
    highlight.Parent = character

    ESPObjects[player] = highlight
end

local function RefreshESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if State.ESP.Enabled then
                AddESP(player)
            else
                RemoveESP(player)
            end
        end
    end
end

-- =========================================================
-- SPEED
-- =========================================================

local function GetSpeedValue()
    return math.clamp(
        SafeNumber(State.Speed.Value, 50),
        1,
        200
    )
end

local function SaveOriginalWalkSpeed()
    local humanoid = GetHumanoid(LocalPlayer)

    if not humanoid then
        return
    end

    if OriginalWalkSpeeds[humanoid] == nil then
        OriginalWalkSpeeds[humanoid] = humanoid.WalkSpeed
    end
end

local function ApplySpeed()
    local humanoid = GetHumanoid(LocalPlayer)

    if not humanoid or humanoid.Health <= 0 then
        return
    end

    SaveOriginalWalkSpeed()

    pcall(function()
        humanoid.WalkSpeed = GetSpeedValue()
    end)
end

local function ResetSpeed()
    local humanoid = GetHumanoid(LocalPlayer)

    if not humanoid then
        return
    end

    local original = OriginalWalkSpeeds[humanoid]

    if original then
        pcall(function()
            humanoid.WalkSpeed = original
        end)

        OriginalWalkSpeeds[humanoid] = nil
    else
        pcall(function()
            humanoid.WalkSpeed = 16
        end)
    end
end

