    bar.BackgroundColor3 = ACCENT2; bar.BorderSizePixel = 0; bar.ZIndex = 6
    Instance.new("UICorner", bar).CornerRadius = UDim.new(1,0)

    local t = Instance.new("TextLabel", row)
    t.Size = UDim2.new(1,-140,0,24); t.Position = UDim2.new(0,14,0,8)
    t.BackgroundTransparency = 1; t.Text = label
    t.Font = Enum.Font.GothamBold; t.TextSize = 14
    t.TextColor3 = TEXT_1; t.TextXAlignment = Enum.TextXAlignment.Left; t.ZIndex = 5

    local s = Instance.new("TextLabel", row)
    s.Size = UDim2.new(1,-140,0,16); s.Position = UDim2.new(0,14,0,34)
    s.BackgroundTransparency = 1; s.Text = desc
    s.Font = Enum.Font.Gotham; s.TextSize = 11
    s.TextColor3 = TEXT_DIM; s.TextXAlignment = Enum.TextXAlignment.Left; s.ZIndex = 5

    local box = Instance.new("TextBox", row)
    box.Size = UDim2.new(0,88,0,34); box.Position = UDim2.new(1,-100,0.5,-17)
    box.BackgroundColor3 = BG_DARK; box.BorderSizePixel = 0
    box.Text = tostring(def); box.Font = Enum.Font.GothamBold; box.TextSize = 14
    box.TextColor3 = Color3.fromRGB(255,255,255); box.ClearTextOnFocus = false; box.ZIndex = 5
    Instance.new("UICorner", box).CornerRadius = UDim.new(0,8)
    local bs = Instance.new("UIStroke", box); bs.Thickness = 1.2; bs.Color = ACCENT; bs.Transparency = 0.6

    local function Apply()
        local v = math.clamp(math.floor(SafeNum(box.Text, def)), mn, mx)
        box.Text = tostring(v); cb(v); return v
    end
    box.FocusLost:Connect(Apply)
    return { Apply=Apply, Box=box }
end

