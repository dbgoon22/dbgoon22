-- =========================================================
-- UTILITIES
-- =========================================================

local function GetChar(p)   return p and p.Character end
local function GetRoot(p)
    local c = GetChar(p)
    return c and c:FindFirstChild("HumanoidRootPart")
end
local function GetHum(p)
    local c = GetChar(p)
    return c and c:FindFirstChildOfClass("Humanoid")
end
local function ValidChar(p)
    if not p or not p.Parent then return false end
    local h = GetHum(p); local r = GetRoot(p)
    return h ~= nil and r ~= nil and h.Health > 0
end
local function SafeNum(v, fb)
    local n = tonumber(v)
    if not n or n ~= n or math.abs(n) == math.huge then return fb end
    return n
end

-- =========================================================
-- BYPASS: SPEED con BodyVelocity
-- BodyVelocity es más difícil de detectar que WalkSpeed porque
-- el servidor ve WalkSpeed normal — el movimiento viene de la
-- física local del BodyVelocity que el cliente controla.
-- =========================================================

local function RemoveSpeedBV()
    if SpeedBV then
        pcall(function() SpeedBV:Destroy() end)
        SpeedBV = nil
    end
    -- restaurar WalkSpeed original
    local hum = GetHum(LocalPlayer)
    if hum then
        local orig = OriginalWalkSpeeds[hum]
        pcall(function() hum.WalkSpeed = orig or 16 end)
        OriginalWalkSpeeds[hum] = nil
    end
end

local function ApplySpeedBV()
    if not State.Speed.Enabled then return end
    local root = GetRoot(LocalPlayer)
    local hum  = GetHum(LocalPlayer)
    if not root or not hum or hum.Health <= 0 then return end

    -- guardar original
    if OriginalWalkSpeeds[hum] == nil then
        OriginalWalkSpeeds[hum] = hum.WalkSpeed
    end

    -- mantener WalkSpeed bajo para no levantar flags del servidor
    pcall(function() hum.WalkSpeed = 16 end)

    -- crear/actualizar BodyVelocity
    local existing = root:FindFirstChild("__dbBV")
    if not existing then
        local bv = Instance.new("BodyVelocity")
        bv.Name          = "__dbBV"
        bv.MaxForce      = Vector3.new(1e5, 0, 1e5)
        bv.Velocity      = Vector3.zero
        bv.P             = 1e4
        bv.Parent        = root
        SpeedBV          = bv
    else
        SpeedBV = existing
    end

    -- dirección de movimiento basada en la cámara + input
    local cam    = Workspace.CurrentCamera
    local move   = Vector3.zero
    local speed  = SafeNum(State.Speed.Value, 50)

    -- leer keys manualmente (compatible con todos los ejecutores)
    local UIS = UserInputService
    local fwd = (UIS:IsKeyDown(Enum.KeyCode.W) or UIS:IsKeyDown(Enum.KeyCode.Up))  and 1 or 0
    local bwd = (UIS:IsKeyDown(Enum.KeyCode.S) or UIS:IsKeyDown(Enum.KeyCode.Down)) and 1 or 0
    local lft = (UIS:IsKeyDown(Enum.KeyCode.A) or UIS:IsKeyDown(Enum.KeyCode.Left)) and 1 or 0
    local rgt = (UIS:IsKeyDown(Enum.KeyCode.D) or UIS:IsKeyDown(Enum.KeyCode.Right)) and 1 or 0

    if fwd == 0 and bwd == 0 and lft == 0 and rgt == 0 then
        -- sin input: BodyVelocity a 0 → permite parar limpio
        if SpeedBV then
            pcall(function() SpeedBV.Velocity = Vector3.zero end)
        end
        return
    end

    local camCF  = cam.CFrame
    local flatFwd = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z).Unit
    local flatRgt = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z).Unit

    move = (flatFwd * (fwd - bwd) + flatRgt * (rgt - lft))
    if move.Magnitude > 0 then
        move = move.Unit * speed
    end

    pcall(function()
        if SpeedBV and SpeedBV.Parent then
            SpeedBV.Velocity = move
        end
    end)
end

-- =========================================================
-- BYPASS: FLY con BodyGyro + BodyVelocity
-- =========================================================

local function RemoveFly()
    if FlyBG then pcall(function() FlyBG:Destroy() end); FlyBG = nil end
    if FlyBV then pcall(function() FlyBV:Destroy() end); FlyBV = nil end
end

local function SetupFly()
    local root = GetRoot(LocalPlayer)
    if not root then return end
    RemoveFly()
    local bg = Instance.new("BodyGyro")
    bg.Name     = "__dbBG"
    bg.MaxTorque = Vector3.new(1e5,1e5,1e5)
    bg.P        = 1e4
    bg.CFrame   = root.CFrame
    bg.Parent   = root
    FlyBG       = bg

    local bv = Instance.new("BodyVelocity")
    bv.Name     = "__dbFV"
    bv.MaxForce = Vector3.new(1e5,1e5,1e5)
    bv.Velocity = Vector3.zero
    bv.P        = 1e4
    bv.Parent   = root
    FlyBV       = bv
end

local function ApplyFly()
    if not State.Fly.Enabled then return end
    local root = GetRoot(LocalPlayer)
    if not root then return end

    if not FlyBV or not FlyBV.Parent then SetupFly() end

    local cam   = Workspace.CurrentCamera
    local speed = SafeNum(State.Fly.Speed, 60)
    local UIS   = UserInputService

    local fwd = (UIS:IsKeyDown(Enum.KeyCode.W)  or UIS:IsKeyDown(Enum.KeyCode.Up))    and 1 or 0
    local bwd = (UIS:IsKeyDown(Enum.KeyCode.S)  or UIS:IsKeyDown(Enum.KeyCode.Down))  and 1 or 0
    local lft = (UIS:IsKeyDown(Enum.KeyCode.A)  or UIS:IsKeyDown(Enum.KeyCode.Left))  and 1 or 0
    local rgt = (UIS:IsKeyDown(Enum.KeyCode.D)  or UIS:IsKeyDown(Enum.KeyCode.Right)) and 1 or 0
    local up  = UIS:IsKeyDown(Enum.KeyCode.Space) and 1 or 0
    local dn  = UIS:IsKeyDown(Enum.KeyCode.LeftControl) and 1 or 0

    local dir = cam.CFrame.LookVector * (fwd - bwd)
                + cam.CFrame.RightVector * (rgt - lft)
                + Vector3.new(0,1,0) * (up - dn)

    pcall(function()
        FlyBV.Velocity = dir.Magnitude > 0 and dir.Unit * speed or Vector3.zero
        FlyBG.CFrame   = cam.CFrame
    end)
end

-- =========================================================
-- AUTO STEAL — Steal a Brainrot
-- El juego usa TouchInterest en los brainrots de la base.
-- El mecanismo: teleportar encima del brainrot → firetouchinterest
-- o simplemente mover el HRP encima y dejar que el touch lo procese.
-- Buscamos objetos con el tag "Brainrot" o en el modelo "Base" de otros.
-- =========================================================

local stealCooldown = 0
local hasFTI        = hasGlobal("firetouchinterest")

local function GetEnemyBrainrots()
    local found = {}
    -- los brainrots están en Workspace bajo el character/base de cada player
    -- o bajo un folder de bases. buscamos cualquier Model/Part con nombre
    -- que contenga "Brainrot" o esté bajo una base que no sea nuestra.
    for _, obj in ipairs(Workspace:GetDescendants()) do
        -- filtro por nombre común en el juego
        if obj:IsA("Model") or obj:IsA("BasePart") then
            local name = obj.Name:lower()
            if name:find("brainrot") or name:find("pet") then
                -- verificar que no sea nuestro
                local owner = nil
                local p = obj.Parent
                for i = 1, 6 do
                    if p then
                        for _, player in ipairs(Players:GetPlayers()) do
                            if player ~= LocalPlayer and p.Name == player.Name then
                                owner = player
                                break
                            end
                        end
                        if owner then break end
                        p = p.Parent
                    end
                end
                if owner then
                    local pos = obj:IsA("Model")
                        and (obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart)
                        or obj
                    if pos then
                        table.insert(found, { part = pos, owner = owner, obj = obj })
                    end
                end
            end
        end
    end
    return found
end

local function TryAutoSteal(dt)
    if not State.AutoSteal.Enabled then return end
    stealCooldown = stealCooldown - dt
    if stealCooldown > 0 then return end

    local myRoot = GetRoot(LocalPlayer)
    if not myRoot then return end

    local targets = GetEnemyBrainrots()
    if #targets == 0 then return end

    -- ordenar por distancia
    table.sort(targets, function(a, b)
        local posA = a.part:IsA("BasePart") and a.part.Position or Vector3.zero
        local posB = b.part:IsA("BasePart") and b.part.Position or Vector3.zero
        return (posA - myRoot.Position).Magnitude < (posB - myRoot.Position).Magnitude
    end)

    local target = targets[1]
    local tPart  = target.part
    if not tPart or not tPart.Parent then return end

    local tPos = tPart:IsA("BasePart") and tPart.Position or Vector3.zero

    pcall(function()
        -- teleportar encima del brainrot
        myRoot.CFrame = CFrame.new(tPos + Vector3.new(0, 3, 0))
        task.wait(0.05)

        -- firetouchinterest si está disponible (más fiable)
        if hasFTI then
            local touchPart = tPart:IsA("BasePart") and tPart
                or target.obj:IsA("BasePart") and target.obj
                or target.obj:FindFirstChildWhichIsA("BasePart")
            if touchPart then
                firetouchinterest(myRoot, touchPart, 0)
                task.wait(0.02)
                firetouchinterest(myRoot, touchPart, 1)
            end
        end
    end)

    stealCooldown = SafeNum(State.AutoSteal.Cooldown, 0.3)
end

-- =========================================================
-- HITBOX
-- =========================================================

local function GetHitboxSize()
    return math.clamp(SafeNum(State.Hitbox.Size, 15), 1, 100)
end

local function SaveOrigSize(player)
    if player == LocalPlayer then return end
    local r = GetRoot(player)
    if r and OriginalSizes[player] == nil then OriginalSizes[player] = r.Size end
end

local function ApplyHitbox(player)
    if player == LocalPlayer then return end
    local r = GetRoot(player)
    if not r then return end
    SaveOrigSize(player)
    pcall(function()
        local s = GetHitboxSize()
        if hasSeti then seti(r, "Size", Vector3.new(s,s,s))
        else             r.Size = Vector3.new(s,s,s) end
        r.CanCollide = false
    end)
end

local function RestoreHitbox(player)
    if player == LocalPlayer then return end
    local r = GetRoot(player); local o = OriginalSizes[player]
    if r and o then
        pcall(function()
            if hasSeti then seti(r, "Size", o) else r.Size = o end
        end)
    end
    OriginalSizes[player] = nil
end

local function SetAllHitboxes(en)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            if en then ApplyHitbox(p) else RestoreHitbox(p) end
        end
    end
end

local function UpdateHitboxSize()
    if not State.Hitbox.Enabled then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then ApplyHitbox(p) end
    end
end

-- =========================================================
-- ESP
-- =========================================================

local function RemoveESP(player)
    local o = ESPObjects[player]
    if o then pcall(function() o:Destroy() end); ESPObjects[player] = nil end
end

local function AddESP(player)
    if player == LocalPlayer then return end
    if not State.ESP.Enabled then RemoveESP(player) return end
    local char = player.Character
    if not char then return end
    local ex = ESPObjects[player]
    if ex and ex.Parent == char then
        ex.FillColor = State.ESP.Color; ex.OutlineColor = State.ESP.Color; return
    end
    RemoveESP(player)
    local hl = Instance.new("Highlight")
    hl.Name                = GUI_NAME .. "_E"
    hl.Adornee             = char
    hl.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
    hl.FillColor           = State.ESP.Color
    hl.OutlineColor        = State.ESP.Color
    hl.FillTransparency    = 0.6
    hl.OutlineTransparency = 0
    hl.Parent              = char
    ESPObjects[player]     = hl
end

local function RefreshESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            if State.ESP.Enabled then AddESP(p) else RemoveESP(p) end
        end
    end
end

-- =========================================================
-- ANTI-RAGDOLL (triple capa)
-- =========================================================

local function SaveMotors(char)
    if not char or SavedMotor6Ds[char] then return end
    local m = {}
    for _, v in ipairs(char:GetDescendants()) do
        if v:IsA("Motor6D") then
            m[v] = { part0=v.Part0, part1=v.Part1, c0=v.C0, c1=v.C1 }
        end
    end
    SavedMotor6Ds[char] = m
end

local function RestoreMotors(char)
    if not char then return end
    local m = SavedMotor6Ds[char]; if not m then return end
    for motor, d in pairs(m) do
        pcall(function()
            if motor and motor.Parent then
                motor.Enabled = true
                motor.Part0 = d.part0; motor.Part1 = d.part1
                motor.C0 = d.c0;      motor.C1 = d.c1
            end
        end)
    end
end

local function KillConstraints(char)
    if not char then return end
    for _, v in ipairs(char:GetDescendants()) do
        if v:IsA("BallSocketConstraint") or v:IsA("HingeConstraint") then
            pcall(function() v:Destroy() end)
        end
    end
end

local function ApplyAntiRagdoll()
    if not State.AntiRagdoll.Enabled then return end
    local char = LocalPlayer.Character
    local hum  = GetHum(LocalPlayer)
    if not hum or not char then return end
    SaveMotors(char)
    local st = hum:GetState()
    if st == Enum.HumanoidStateType.Ragdoll or st == Enum.HumanoidStateType.FallingDown then
        pcall(function()
            RestoreMotors(char)
            KillConstraints(char)
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end)
    end
end

-- =========================================================
-- TARGET (closest enemy)
-- =========================================================

local function GetClosest()
    local myRoot = GetRoot(LocalPlayer)
    if not myRoot then return nil end
    local best, bestD = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and ValidChar(p) then
            local r = GetRoot(p)
            if r then
                local d = (r.Position - myRoot.Position).Magnitude
                if d < bestD then bestD = d; best = p end
            end
        end
    end
    return best
end

local function UpdateTarget()
    if State.AutoHit.Enabled or State.Aimbot.Enabled then
        CurrentTarget = GetClosest()
    else
        CurrentTarget = nil
    end
end

-- =========================================================
-- AIMBOT
-- =========================================================

local function UpdateAimbot(target, dt)
    if not State.Aimbot.Enabled or not target or not ValidChar(target) then return end
    local r  = GetRoot(target)
    local cam = Workspace.CurrentCamera
    if not r or not cam then return end
    local tp  = r.Position + Vector3.new(0,2,0)
    local al  = 1 - math.pow(0.01, math.clamp(dt * 14, 0, 1))
    pcall(function()
        local nCF = cam.CFrame:Lerp(CFrame.lookAt(cam.CFrame.Position, tp), al)
        if hasSeti then seti(cam, "CFrame", nCF) else cam.CFrame = nCF end
    end)
end

-- =========================================================
-- AUTO HIT — vuela hacia el jugador y "ataca" (touch)
-- En Steal a Brainrot el daño a jugadores es por hitbox touch
-- o por herramienta equipada. Simulamos ambos.
-- =========================================================

local autoHitCooldown = 0

local function TryAutoHit(target, dt)
    if not State.AutoHit.Enabled or not target or not ValidChar(target) then return end
    autoHitCooldown = autoHitCooldown - dt
    if autoHitCooldown > 0 then return end

    local myRoot  = GetRoot(LocalPlayer)
    local tRoot   = GetRoot(target)
    if not myRoot or not tRoot then return end

    local dist = (tRoot.Position - myRoot.Position).Magnitude

    pcall(function()
        -- volar hacia el objetivo
        myRoot.CFrame = CFrame.new(
            myRoot.Position:Lerp(tRoot.Position + Vector3.new(0,2,0), 0.4)
        )

        -- si estamos cerca, firetouchinterest para simular golpe
        if dist < 12 and hasFTI then
            firetouchinterest(myRoot, tRoot, 0)
            task.wait(0.02)
            firetouchinterest(myRoot, tRoot, 1)
        end

        -- intentar usar herramienta equipada si el juego tiene bat/weapon
        local char = LocalPlayer.Character
        if char then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then
                local remote = tool:FindFirstChildOfClass("RemoteEvent")
                    or tool:FindFirstChildOfClass("RemoteFunction")
                if remote and remote:IsA("RemoteEvent") then
                    pcall(function() remote:FireServer(tRoot.Position) end)
                end
            end
        end
    end)

    autoHitCooldown = 0.15
end

-- =========================================================
-- INFINITE JUMP — SetStateEnabled bypass
-- =========================================================

local jumpDb = false
UserInputService.JumpRequest:Connect(function()
    if not State.InfJump.Enabled then return end
    if jumpDb then return end
    local hum = GetHum(LocalPlayer)
    if not hum or hum.Health <= 0 then return end
    jumpDb = true
    pcall(function()
        hum:SetStateEnabled(Enum.HumanoidStateType.Landed, false)
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
        task.delay(0.1, function()
            hum:SetStateEnabled(Enum.HumanoidStateType.Landed, true)
        end)
    end)
    task.delay(0.15, function() jumpDb = false end)
end)

-- =========================================================
-- HEARTBEAT
-- =========================================================

RunService.Heartbeat:Connect(function(dt)
    if State.Speed.Enabled and not State.Fly.Enabled then
        ApplySpeedBV()
    elseif not State.Speed.Enabled and SpeedBV then
        RemoveSpeedBV()
    end

    if State.Fly.Enabled then
        ApplyFly()
    elseif FlyBV then
        RemoveFly()
    end

    ApplyAntiRagdoll()
    TryAutoSteal(dt)

    TargetAccumulator += dt
    if TargetAccumulator >= TARGET_UPDATE_RATE then
        TargetAccumulator = 0
        UpdateTarget()
    end

    if State.Aimbot.Enabled and CurrentTarget then
        UpdateAimbot(CurrentTarget, dt)
    end
    if State.AutoHit.Enabled and CurrentTarget then
        TryAutoHit(CurrentTarget, dt)
    end
end)

-- =========================================================
-- CHARACTER / PLAYER EVENTS
-- =========================================================

local function OnCharAdded(player)
    OriginalSizes[player] = nil
    task.delay(0.5, function()
        if not player.Parent or not player.Character then return end
        if State.Hitbox.Enabled then ApplyHitbox(player) end
        if State.ESP.Enabled    then AddESP(player)      end
    end)
end

local function SetupPlayer(player)
    if player == LocalPlayer or PlayerConnections[player] then return end
    local c = {}
    PlayerConnections[player] = c
    c.ca = player.CharacterAdded:Connect(function()   OnCharAdded(player) end)
    c.cr = player.CharacterRemoving:Connect(function(char)
        local e = ESPObjects[player]
        if e and e.Adornee == char then RemoveESP(player) end
        OriginalSizes[player]   = nil
        SavedMotor6Ds[char]     = nil
    end)
    if player.Character then task.defer(function() OnCharAdded(player) end) end
end

local function CleanupPlayer(player)
    RemoveESP(player)
    local r = GetRoot(player); local o = OriginalSizes[player]
    if r and o then pcall(function() r.Size = o end) end
    OriginalSizes[player] = nil
    local c = PlayerConnections[player]
    if c then for _, v in pairs(c) do pcall(function() v:Disconnect() end) end end
    PlayerConnections[player] = nil
    if CurrentTarget == player then CurrentTarget = nil end
end

for _, p in ipairs(Players:GetPlayers()) do SetupPlayer(p) end
Players.PlayerAdded:Connect(SetupPlayer)
Players.PlayerRemoving:Connect(CleanupPlayer)

LocalPlayer.CharacterAdded:Connect(function(char)
    SavedMotor6Ds = {}
    SpeedBV = nil; FlyBV = nil; FlyBG = nil
    task.wait(0.5)
    SaveMotors(char)
    if State.Speed.Enabled then ApplySpeedBV() end
end)

