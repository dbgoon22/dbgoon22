-- =========================================================
-- BYPASS: ENV DETECTION (rawget, nunca lanza error)
-- =========================================================

local function hasGlobal(name)
    return typeof(rawget(_G, name)) == "function"
end

local hasGetHui     = hasGlobal("gethui")
local hasProtectGui = hasGlobal("protect_gui")
local hasGetRMeta   = hasGlobal("getrawmetatable")
local hasHookMeta   = hasGlobal("hookmetamethod")
local hasSeti       = hasGlobal("seti")
local hasCloneRef   = hasGlobal("cloneref")

local function SafeClone(svc)
    if hasCloneRef then
        local ok, r = pcall(cloneref, svc)
        if ok and r then return r end
    end
    return svc
end

