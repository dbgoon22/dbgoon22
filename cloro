-- ===================== INPUT =====================
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.Y then
        State.guiVisible = not State.guiVisible
        if State.gui and State.gui.main then
            State.gui.main.Visible = State.guiVisible
        end
    end
end)

-- ===================== MAIN LOOPS =====================
createGUI()

task.spawn(function()
    while true do
        if State.scannerEnabled then
            local high = scanWorkspace()
            updateESP()
            if State.gui and State.gui.StatusLabel and not State.autoFinder then
                local total = 0
                for _ in pairs(State.foundHigh) do total = total + 1 end
                State.gui.StatusLabel.Text = string.format("Scan: %d brainrots | ≥50M: %d", total, high)
            end
        end
        task.wait(CONFIG.SCAN_INTERVAL)
    end
end)

-- cleanup on leave
Players.PlayerRemoving:Connect(function(p)
    if p == LocalPlayer then
        for m in pairs(State.espObjects) do clearESP(m) end
    end
end)

