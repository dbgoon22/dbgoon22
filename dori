-- =========================================================
-- METATABLE HOOK UTILS
-- =========================================================
-- Hookea __newindex / __index de una instancia vía getrawmetatable.
-- Requiere executor con setreadonly / make_writeable.

local function HookMeta(obj, indexType, predicate, replacement)
    -- indexType: "__newindex" o "__index"
    if not (typeof(getrawmetatable) == "function") then return end
    local mt = getrawmetatable(obj)
    if not mt then return end
    if typeof(setreadonly) == "function" then
        pcall(setreadonly, mt, false)
    elseif typeof(make_writeable) == "function" then
        pcall(make_writeable, mt)
    else
        return -- sin acceso a metatable write
    end
    local original = mt[indexType]
    mt[indexType] = newproxy and newproxy(false) or {}
    mt[indexType] = function(self, key, value)
        if predicate(self, key, value) then
            return replacement(self, key, value, original)
        end
        return original(self, key, value)
    end
end

