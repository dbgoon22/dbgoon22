local function GetCharacter(p) return p and p.Character end
local function GetRoot(p)
    local c = GetCharacter(p)
    return c and c:FindFirstChild("HumanoidRootPart")
end
local function GetHumanoid(p)
    local c = GetCharacter(p)
    return c and c:FindFirstChildOfClass("Humanoid")
end
local function IsCharacterValid(p)
    if not p or not p.Parent then return false end
    local h = GetHumanoid(p)
    local r = GetRoot(p)
    return h ~= nil and r ~= nil and h.Health > 0
end
local function SafeNumber(v, fb)
    local n = tonumber(v)
    if not n or n ~= n or math.abs(n) == math.huge then return fb end
    return n
end

-- =========================================================
-- REMOTE HOOK — filtra eventos de anti-cheat
-- =========================================================
-- Muchos juegos envían RemoteEvent:FireServer con el nombre
-- del evento al detectar anomalías (SpeedHack, ragdoll, etc.)
-- Hookeamos para silenciar esos remotes específicos.

local BLOCKED_REMOTES = {
    -- nombres genéricos que usan varios anti-cheats en Roblox
    "AntiCheat", "ReportHack", "CheatDetected",
    "SpeedCheck", "JumpCheck", "RagdollCheck",
    "ServerLog", "FlagPlayer", "SanityCheck",
}

local function IsBlockedRemote(remote)
    if not remote then return false end
    local name = remote.Name or ""
    for _, blocked in ipairs(BLOCKED_REMOTES) do
        if name:lower():find(blocked:lower()) then return true end
    end
    return false
end

-- Hook FireServer
if typeof(hookmetamethod) == "function" then
    -- método alternativo más compatible
    pcall(function()
        local originalFireServer = Instance.new("RemoteEvent").FireServer
        hookmetamethod(game, "__namecall", function(self, ...)
            local method = getnamecallmethod()
            if (method == "FireServer" or method == "InvokeServer")
                and self:IsA("RemoteEvent") or self:IsA("RemoteFunction") then
                if IsBlockedRemote(self) then
                    return -- silencia
                end
            end
            return originalFireServer(self, ...)
        end)
    end)
elseif typeof(hookfunction) == "function" then
    pcall(function()
        local RE_meta = getrawmetatable(Instance.new("RemoteEvent"))
        if RE_meta and RE_meta.__namecall then
            local orig = RE_meta.__namecall
            if typeof(setreadonly) == "function" then
                pcall(setreadonly, RE_meta, false)
            end
            RE_meta.__namecall = function(self, ...)
                local method = getnamecallmethod and getnamecallmethod() or ""
                if (method == "FireServer" or method == "InvokeServer")
                    and IsBlockedRemote(self) then
                    return
                end
                return orig(self, ...)
            end
        end
    end)
end

-- =========================================================
-- HITBOX BYPASS
-- =========================================================
-- El problema con solo cambiar Size es que el servidor puede
-- detectar que el HRP tiene un tamaño distinto al esperado.
-- Bypass: SetNetworkOwnership al cliente + mantener Size 
-- solo en el cliente vía loop (no se replica si no hay RB).

local function GetHitboxSize()
    return math.clamp(SafeNumber(State.Hitbox.Size, 10), 1, 100)
end

local function SaveOriginalSize(player)
    if player == LocalPlayer then return end
    local root = GetRoot(player)
    if root and OriginalSizes[player] == nil then
        OriginalSizes[player] = root.Size
    end
end

local function ApplyHitbox(player)
    if player == LocalPlayer then return end
    local root = GetRoot(player)
    if not root then return end
    SaveOriginalSize(player)
    pcall(function()
        local s = GetHitboxSize()
        -- Desactiva colisión para que no pushee al LocalPlayer
        root.CanCollide = false
        -- Fuerza el size localmente (FilteringEnabled: solo local)
        root.Size = Vector3.new(s, s, s)
        -- Transparency 1 para que no se vea el cubo gigante
        root.LocalTransparencyModifier = 1
    end)
end

local function RestoreHitbox(player)
    if player == LocalPlayer then return end
    local root     = GetRoot(player)
    local original = OriginalSizes[player]
    if root and original then
        pcall(function()
            root.Size = original
            root.LocalTransparencyModifier = 0
        end)
    end
    OriginalSizes[player] = nil
end

local function SetAllHitboxes(enabled)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            if enabled then ApplyHitbox(p) else RestoreHitbox(p) end
        end
    end
end

local function UpdateHitboxSize()
    if not State.Hitbox.Enabled then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then ApplyHitbox(p) end
    end
end

-- Re-aplica cada 0.1s para contrarrestar replicaciones del servidor
-- que reseteen el Size al valor original.
task.spawn(function()
    while true do
        task.wait(0.1)
        if State.Hitbox.Enabled then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and IsCharacterValid(p) then
                    ApplyHitbox(p)
                end
            end
        end
    end
end)

-- =========================================================
-- ESP BYPASS
-- =========================================================
-- Highlight en CoreGui/gethui es invisible para scripts
-- de detección que escaneen PlayerGui o el Character.
-- Adornee apunta al character pero el objeto vive fuera.

local ESPFolder = Instance.new("Folder")
ESPFolder.Name   = "dbgoon22_ESPFolder"
ESPFolder.Parent = GetCoreGui()

local function RemoveESP(player)
    local obj = ESPObjects[player]
    if obj then
        pcall(function() obj:Destroy() end)
        ESPObjects[player] = nil
    end
end

local function AddESP(player)
    if player == LocalPlayer then return end
    if not State.ESP.Enabled then RemoveESP(player) return end
    local char = player.Character
    if not char then return end
    local existing = ESPObjects[player]
    if existing and existing.Parent then
        existing.FillColor    = State.ESP.Color
        existing.OutlineColor = State.ESP.Color
        return
    end
    RemoveESP(player)
    local hl = Instance.new("Highlight")
    hl.Name                 = "dbgoon22_ESP_" .. player.Name
    hl.Adornee              = char            -- apunta al char
    hl.DepthMode            = Enum.HighlightDepthMode.AlwaysOnTop
    hl.FillColor            = State.ESP.Color
    hl.OutlineColor         = State.ESP.Color
    hl.FillTransparency     = 0.75
    hl.OutlineTransparency  = 0
    hl.Parent               = ESPFolder       -- vive en CoreGui/gethui
    ESPObjects[player]      = hl
end

local function RefreshESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            if State.ESP.Enabled then AddESP(p) else RemoveESP(p) end
        end
    end
end

-- =========================================================
-- ANTI-RAGDOLL BYPASS
-- =========================================================
-- v2.3 usaba GettingUp en Heartbeat. 
-- v2.4 añade:
--   1. Hook DescendantAdded: destruye constraints en caliente
--      cuando el juego las inserta durante el ragdoll.
--   2. Bloquea el cambio de estado Ragdoll vía StateChanged.
--   3. Mantiene Motor6D.MaxVelocity para impedir la animación.

local ragdollConnections = {}

local function CleanRagdollHooks()
    for _, c in pairs(ragdollConnections) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(ragdollConnections)
end

local function HookAntiRagdoll(character)
    if not character then return end
    CleanRagdollHooks()

    -- destruye constraints que ya existen
    for _, v in ipairs(character:GetDescendants()) do
        if v:IsA("BallSocketConstraint") or v:IsA("HingeConstraint") then
            pcall(function() v:Destroy() end)
        end
    end

    -- destruye constraints que se añadan en caliente
    ragdollConnections.DescendantAdded = character.DescendantAdded:Connect(function(v)
        if not State.AntiRagdoll.Enabled then return end
        if v:IsA("BallSocketConstraint") or v:IsA("HingeConstraint") then
            task.defer(function() pcall(function() v:Destroy() end) end)
        end
    end)

    -- bloquea StateChanged → Ragdoll / FallingDown
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        ragdollConnections.StateChanged = humanoid.StateChanged:Connect(function(_, new)
            if not State.AntiRagdoll.Enabled then return end
            if new == Enum.HumanoidStateType.Ragdoll
               or new == Enum.HumanoidStateType.FallingDown then
                task.defer(function()
                    pcall(function()
                        humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
                    end)
                end)
            end
        end)
    end
end

local function ApplyAntiRagdoll()
    if not State.AntiRagdoll.Enabled then return end
    local humanoid = GetHumanoid(LocalPlayer)
    if not humanoid then return end
    local state = humanoid:GetState()
    if state == Enum.HumanoidStateType.Ragdoll
       or state == Enum.HumanoidStateType.FallingDown then
        pcall(function()
            humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        end)
    end
end

-- =========================================================
-- SPEED BYPASS
-- =========================================================
-- WalkSpeed hook vía __newindex metatable:
-- cuando el servidor intenta resetear WalkSpeed a 16,
-- el hook devuelve 16 (lo que el servidor quiere ver)
-- pero el movimiento real viene de BodyVelocity.

local SPEED_MAX = 33

local function GetSpeedValue()
    return math.clamp(SafeNumber(State.Speed.Value, 16), 1, SPEED_MAX)
end

-- Hook WalkSpeed para bloquear resets del servidor
local walkSpeedHookActive = false
local function InstallWalkSpeedHook()
    if walkSpeedHookActive then return end
    walkSpeedHookActive = true
    HookMeta(
        -- objeto de referencia para obtener la metatable de Humanoid
        Instance.new("Humanoid"),
        "__newindex",
        function(self, key, value)
            return self:IsA("Humanoid")
                and key == "WalkSpeed"
                and State.Speed.Enabled
        end,
        function(self, key, value, original)
            -- deja que el juego crea que lo cambió, pero no lo aplica
            -- BodyVelocity maneja el movimiento real
            return
        end
    )
end
pcall(InstallWalkSpeedHook)

local function RemoveSpeedBypass()
    if SpeedBodyVelocity then
        pcall(function() SpeedBodyVelocity:Destroy() end)
        SpeedBodyVelocity = nil
    end
    local humanoid = GetHumanoid(LocalPlayer)
    if humanoid then
        local orig = OriginalWalkSpeeds[humanoid]
        pcall(function() humanoid.WalkSpeed = orig or 16 end)
        OriginalWalkSpeeds[humanoid] = nil
    end
end

local function ApplySpeedBypass()
    local humanoid = GetHumanoid(LocalPlayer)
    local root     = GetRoot(LocalPlayer)
    if not humanoid or not root or humanoid.Health <= 0 then return end

    if OriginalWalkSpeeds[humanoid] == nil then
        OriginalWalkSpeeds[humanoid] = humanoid.WalkSpeed
    end

    local speed = GetSpeedValue()
    pcall(function() humanoid.WalkSpeed = 16 end)

    local bv = root:FindFirstChild("dbgoon22_SpeedBV")
    if not bv then
        bv          = Instance.new("BodyVelocity")
        bv.Name     = "dbgoon22_SpeedBV"
        bv.MaxForce = Vector3.new(1e5, 0, 1e5)
        bv.P        = 1e4
        bv.Parent   = root
        SpeedBodyVelocity = bv
    end

    local dir = humanoid.MoveDirection
    bv.Velocity = dir.Magnitude > 0.1 and dir * speed or Vector3.zero
end

-- =========================================================
-- INFINITE JUMP BYPASS
-- =========================================================
-- v2.4: hook StateChanged para cancelar GettingDown antes
-- de que llegue a Landed, dando ventana limpia al siguiente jump.

local function InstallInfJumpStateHook(humanoid)
    if not humanoid then return end
    humanoid.StateChanged:Connect(function(_, new)
        if not State.InfJump.Enabled then return end
        -- cancela la transición GettingDown → Landed
        if new == Enum.HumanoidStateType.GettingDown then
            task.defer(function()
                if not State.InfJump.Enabled then return end
                pcall(function()
                    humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                end)
            end)
        end
    end)
end

UserInputService.JumpRequest:Connect(function()
    if not State.InfJump.Enabled then return end
    if jumpDebounce then return end
    local humanoid = GetHumanoid(LocalPlayer)
    if not humanoid or humanoid.Health <= 0 then return end
    jumpDebounce = true
    pcall(function()
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end)
    task.delay(0.15, function() jumpDebounce = false end)
end)

