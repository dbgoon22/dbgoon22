end

-- Convierte:
-- 50M
-- 50M/s
-- $50M/s
-- 1.5B
-- 250K
-- 1,500,000
-- etc.
local function safeNumber(value)
    if typeof(value) == "number" then
        return value
    end

    if typeof(value) ~= "string" then
        return 0
    end

    local text = value
        :lower()
        :gsub("%$", "")
        :gsub("%s+", "")
        :gsub("/second", "")
        :gsub("/sec", "")
        :gsub("/s", "")

    text = text:gsub(",", "")

    local numberPart, suffix = text:match("^([%d%.]+)([kmb]?)")

    if not numberPart then
        return 0
    end

    local n = tonumber(numberPart)

    if not n then
        return 0
    end

    if suffix == "k" then
        n *= 1e3
    elseif suffix == "m" then
        n *= 1e6
    elseif suffix == "b" then
        n *= 1e9
    end

    return n
end

local function formatIncome(value)
    value = tonumber(value) or 0

    if value >= 1e9 then
        return string.format("%.2fB/s", value / 1e9)
    elseif value >= 1e6 then
        return string.format("%.2fM/s", value / 1e6)
    elseif value >= 1e3 then
        return string.format("%.2fK/s", value / 1e3)
    else
        return string.format("%.0f/s", value)
    end
end

--==================================================
-- INCOME DETECTION
--==================================================

local INCOME_NAMES = {
    "Income",
    "IncomePerSecond",
    "MoneyPerSecond",
    "Generation",
    "CashPerSecond",
    "MPS",
    "PerSecond",
    "Value",
    "Earn",
    "Rate",
    "GenerationPerSecond",
}

local function getIncome(obj)
    -- Attributes
    for _, name in ipairs(INCOME_NAMES) do
        local attribute = obj:GetAttribute(name)

        if attribute ~= nil then
            local n = safeNumber(attribute)

            if n > 0 then
                return n
            end
        end
    end

    -- Values
    for _, name in ipairs(INCOME_NAMES) do
        local valueObject = obj:FindFirstChild(name, true)

        if valueObject then
            local value

            if valueObject:IsA("NumberValue")
                or valueObject:IsA("IntValue")
                or valueObject:IsA("StringValue") then

                value = valueObject.Value
            end

            if value ~= nil then
                local n = safeNumber(value)

                if n > 0 then
                    return n
                end
            end
        end
    end

    -- Display text
    for _, descendant in ipairs(obj:GetDescendants()) do
        local text = nil

        if descendant:IsA("StringValue") then
            text = descendant.Value
        elseif descendant:IsA("TextLabel")
            or descendant:IsA("TextButton")
            or descendant:IsA("TextBox") then
            text = descendant.Text
        end

        if typeof(text) == "string" then
            local lower = text:lower()

            if lower:find("/s")
                or lower:find("persecond")
                or lower:find("per second")
                or lower:find("m/s") then

                local number, suffix =
                    lower:match("([%d%.]+)%s*([kmb]?)%s*/?%s*s?")

                if number then
                    local result = tonumber(number)

                    if suffix == "k" then
                        result *= 1e3
                    elseif suffix == "m" then
                        result *= 1e6
                    elseif suffix == "b" then
                        result *= 1e9
                    end

                    if result and result > 0 then
                        return result
                    end
                end
            end
        end
    end

    return 0
end

--==================================================
-- NAME
--==================================================

local function getBrainrotName(obj)
    local candidates = {
        "BrainrotName",
        "DisplayName",
        "Name",
    }

    for _, name in ipairs(candidates) do
        local value = obj:FindFirstChild(name, true)

        if value then
            if value:IsA("StringValue") then
                return value.Value
            elseif value:IsA("TextLabel")
                or value:IsA("TextButton") then
                return value.Text
            end
        end

        local attribute = obj:GetAttribute(name)

        if typeof(attribute) == "string" and attribute ~= "" then
            return attribute
        end
    end

    return obj.Name
end

--==================================================
-- BRAINROT DETECTION
--==================================================

local function isPossibleBrainrot(obj)
    if not obj:IsA("Model") and not obj:IsA("Folder") then
        return false, 0
    end

    local income = getIncome(obj)

    if income > 0 then
        return true, income
    end

    local name = obj.Name:lower()

    if name:find("brainrot")
        or name:find("pet")
        or name:find("unit") then

        return true, 0
    end

    return false, 0
end

--==================================================
-- ESP
--==================================================

local function getRootPart(model)
    return model.PrimaryPart
        or model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChildWhichIsA("BasePart", true)
end

local function clearESP(model)
    local data = State.espObjects[model]

    if not data then
        return
    end

    if data.billboard then
        data.billboard:Destroy()
    end

    if data.highlight then
        data.highlight:Destroy()
    end

    State.espObjects[model] = nil
end

local function getESPColor(income)
    if income >= CONFIG.MIN_INCOME then
        return CONFIG.ESP_COLOR_HIGH
    elseif income >= 1e6 then
        return CONFIG.ESP_COLOR_MID
    else
        return CONFIG.ESP_COLOR_LOW
    end
end

local function createESP(model, income, name)
    if not model or not model.Parent then
        return
    end

    local root = getRootPart(model)

    if not root then
        return
    end

    local color = getESPColor(income)
    local data = State.espObjects[model]

    -- Ya existe: actualizarlo
    if data then
        if data.label then
            data.label.Text =
                string.format("%s\n%s", name, formatIncome(income))

            data.label.TextColor3 = color
        end

        if data.highlight then
            data.highlight.FillColor = color
            data.highlight.OutlineColor = color
        end

        if data.billboard then
            data.billboard.Adornee = root
        end

        return
    end

    local highlight = Instance.new("Highlight")
    highlight.Name = "SABB_ESP"
    highlight.Adornee = model
    highlight.FillColor = color
    highlight.OutlineColor = color
    highlight.FillTransparency = 0.65
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = model

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "SABB_Info"
    billboard.Adornee = root
    billboard.Size = UDim2.new(0, 180, 0, 45)
    billboard.StudsOffset = Vector3.new(0, 4, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = model

    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 0.3
    label.BackgroundColor3 = Color3.new(0, 0, 0)
    label.TextColor3 = color
    label.Font = Enum.Font.GothamBold
    label.TextSize = 13
    label.TextWrapped = true
    label.Text = string.format(
        "%s\n%s",
        name,
        formatIncome(income)
    )
    label.Parent = billboard

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 5)
    corner.Parent = label

    State.espObjects[model] = {
        billboard = billboard,
        highlight = highlight,
        label = label,
    }
end

local function updateESP()
    if not State.espEnabled then
        for model in pairs(State.espObjects) do
            clearESP(model)
        end

        return
    end

    for model, data in pairs(State.found) do
        if model.Parent and data.income > 0 then
            createESP(
                model,
                data.income,
                data.name
            )
        else
            clearESP(model)
            State.found[model] = nil
        end
    end

    -- Elimina ESP huérfanos
    for model in pairs(State.espObjects) do
        if not State.found[model] or not model.Parent then
            clearESP(model)
        end
    end
end

--==================================================
-- SCANNER
--==================================================

local function scanWorkspace()
    local found = {}
    local highCount = 0
    local scannedNodes = 0

    local function scan(root)
        if scannedNodes >= CONFIG.MAX_SCAN_NODES then
            return
        end

        scannedNodes += 1

        local children = root:GetChildren()

        for _, child in ipairs(children) do
            if scannedNodes >= CONFIG.MAX_SCAN_NODES then
                break
            end

            local ok, income = isPossibleBrainrot(child)

            if ok and income > 0 then
                found[child] = {
                    income = income,
                    name = getBrainrotName(child),
                }

                if income >= CONFIG.MIN_INCOME then
                    highCount += 1
                end
            end

            -- Escanea todos los niveles, pero con límite global.
            if #child:GetChildren() > 0 then
                scan(child)
            end
        end
    end

    pcall(function()
        scan(Workspace)
    end)

    State.found = found

    return highCount, scannedNodes
end

--==================================================
-- TARGET
--==================================================

local function getNearestHigh()
    local character, humanoid, hrp = getCharacter()

    if not hrp then
        return nil
    end

    local bestModel = nil
    local bestDistance = math.huge
    local bestIncome = 0

    for model, data in pairs(State.found) do
        if model.Parent
            and data.income >= CONFIG.MIN_INCOME then

            local root = getRootPart(model)

            if root then
                local distance =
                    (root.Position - hrp.Position).Magnitude

                if distance < bestDistance then
                    bestModel = model
                    bestDistance = distance
                    bestIncome = data.income
                end
            end
        end
    end

    return bestModel, bestDistance, bestIncome
end

--==================================================
-- PATHFINDING
--==================================================

local function moveToTarget(targetPosition)
    local character, humanoid, hrp = getCharacter()

    if not humanoid or not hrp then
        return false
    end

    local oldSpeed = humanoid.WalkSpeed

    if State.originalWalkSpeed == nil then
        State.originalWalkSpeed = oldSpeed
    end

    humanoid.WalkSpeed = CONFIG.PATH_SPEED

    local path = PathfindingService:CreatePath({
        AgentRadius = 2,
        AgentHeight = 5,
        AgentCanJump = true,
        AgentCanClimb = true,
        WaypointSpacing = 4,
    })

    local success = pcall(function()
        path:ComputeAsync(
            hrp.Position,
            targetPosition
        )
    end)

    if not success
        or path.Status ~= Enum.PathStatus.Success then

        humanoid:MoveTo(targetPosition)
        task.wait(0.5)

        return false
    end

    local waypoints = path:GetWaypoints()

    for _, waypoint in ipairs(waypoints) do
        if not State.autoCollect then
            break
        end

        if waypoint.Action == Enum.PathWaypointAction.Jump then
            humanoid.Jump = true
        end

        humanoid:MoveTo(waypoint.Position)

        local reached = humanoid.MoveToFinished:Wait()

        if not reached then
            break
        end
    end

    return true
end

--==================================================
-- COLLECT
--==================================================

local function tryCollect(model)
    if not model or not model.Parent then
        return
    end

    local character, humanoid, hrp = getCharacter()

    if not character or not humanoid or not hrp then
        return
    end

    local root = getRootPart(model)

    if not root then
        return
    end

    local distance =
        (root.Position - hrp.Position).Magnitude

    if distance > CONFIG.MAX_TARGET_DISTANCE then
        return
    end

    -- Acercarse mediante pathfinding
    if distance > CONFIG.AUTOCOLLECT_RANGE then
        moveToTarget(root.Position)
        task.wait(0.2)
    end

    -- Comprobar distancia real otra vez
    if not hrp.Parent or not root.Parent then
        return
    end

    distance =
        (root.Position - hrp.Position).Magnitude

    if distance > CONFIG.AUTOCOLLECT_RANGE then
        return
    end

    -- ProximityPrompts
    for _, descendant in ipairs(model:GetDescendants()) do
        if descendant:IsA("ProximityPrompt") then
            pcall(function()
                descendant.HoldDuration = 0

                if typeof(fireproximityprompt) == "function" then
                    fireproximityprompt(descendant)
                end
            end)
        end
    end

    -- ClickDetectors
    for _, descendant in ipairs(model:GetDescendants()) do
        if descendant:IsA("ClickDetector") then
            pcall(function()
                if typeof(fireclickdetector) == "function" then
                    fireclickdetector(descendant)
                end
            end)
        end
    end
end

local function restoreWalkSpeed()
    local character = LocalPlayer.Character

    if not character then
        return
    end

    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    if humanoid and State.originalWalkSpeed then
        humanoid.WalkSpeed = State.originalWalkSpeed
    end
end

local function autoCollectLoop()
    while State.autoCollect do
        local model, distance, income =
            getNearestHigh()

        if model and distance then
            if distance <= CONFIG.MAX_TARGET_DISTANCE then
                pcall(function()
                    tryCollect(model)
                end)
            end
        end

        task.wait(0.8)
    end

    restoreWalkSpeed()
end

--==================================================
-- SERVER FINDER
--==================================================

local function getPublicServers(placeId)
    local servers = {}
    local cursor = nil

    for page = 1, CONFIG.MAX_SERVER_PAGES do
        local url =
            string.format(
                "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=%d",
                placeId,
                CONFIG.SERVER_PAGE_LIMIT
            )

        if cursor and cursor ~= "" then
            url = url .. "&cursor=" ..
                HttpService:UrlEncode(cursor)
        end

        local success, response = pcall(function()
            local raw = game:HttpGet(url)
            return HttpService:JSONDecode(raw)
        end)

        if not success or not response then
            break
        end

        if response.data then
            for _, server in ipairs(response.data) do
                if server.id
                    and server.id ~= game.JobId
                    and server.playing
                    and server.maxPlayers
                    and server.playing < server.maxPlayers
                    and not State.visitedServers[server.id] then

                    table.insert(servers, server)
                end
            end
        end

        cursor = response.nextPageCursor

        if not cursor or cursor == "" then
            break
        end

        task.wait(0.1)
    end

    return servers
end

local function hopToServer(jobId)
    if not jobId or jobId == "" then
        return false
    end

    local now = os.clock()

    if now - State.lastHop < CONFIG.HOP_COOLDOWN then
        return false
    end

    State.lastHop = now
    State.visitedServers[jobId] = true

    updateStatus("Teleportando a otro servidor...")

    local success = pcall(function()
        TeleportService:TeleportToPlaceInstance(
            game.PlaceId,
            jobId,
            LocalPlayer
        )
    end)

    if not success then
        updateStatus("Error al iniciar el teleport.")
        return false
    end

    return true
end

local function chooseServer(servers)
    if #servers == 0 then
        return nil
    end

    -- Preferimos servidores menos llenos
    table.sort(servers, function(a, b)
        local freeA = (a.maxPlayers or 0) - (a.playing or 0)
        local freeB = (b.maxPlayers or 0) - (b.playing or 0)

        return freeA > freeB
    end)

    -- Elegir entre los primeros candidatos
    local amount = math.min(10, #servers)
    return servers[math.random(1, amount)]
end

local function autoFinderLoop()
    while State.autoFinder do
        local highCount = scanWorkspace()

        if highCount > 0 then
            updateStatus(
                string.format(
                    "ENCONTRADO: %d Brainrot(s) >= 50M/s",
                    highCount
                )
            )

            State.autoFinder = false
            break
        end

        updateStatus(
            "No hay >=50M/s. Buscando otro servidor..."
        )

        local servers =
            getPublicServers(game.PlaceId)

        if #servers == 0 then
            updateStatus(
                "No hay servidores nuevos. Limpiando historial..."
            )

            -- Si ya hemos visitado demasiados,
            -- permitimos volver a utilizarlos.
            State.visitedServers = {}

            task.wait(3)
        else
            local server = chooseServer(servers)

            if server then
                State.currentServer = server.id

                hopToServer(server.id)

                -- Roblox normalmente cambia de servidor
                -- y el script vuelve a ejecutarse allí.
                task.wait(CONFIG.HOP_COOLDOWN + 2)
            else
                task.wait(2)
            end
        end
    end
end

