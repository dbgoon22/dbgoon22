                updateStatus(
                    string.format(
                        "Scan: %d | >=50M/s: %d | Nodes: %d",
                        total,
                        highCount,
                        nodes
                    )
                )
            end
        end

        task.wait(CONFIG.SCAN_INTERVAL)
    end
end)

