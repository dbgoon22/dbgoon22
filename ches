-- Variables de control
local isRunning = false
local serversChecked = 0
local serversFound = 0

-- Función para obtener la lista de servidores
local function getServers()
    local url = "https://games.roblox.com/v1/games/" .. PLACE_ID .. "/servers/Public?sortOrder=Desc&limit=100"
    local response = game:HttpGet(url)
    return HttpService:JSONDecode(response)
end

-- Función para verificar si un servidor tiene brainrots de alto valor
local function checkServerForBrainrots(serverId)
    -- Esta función simula la verificación de brainrots en un servidor
    -- En un script real, necesitarías conectarte temporalmente al servidor para verificar
    
    -- Simulación aleatoria para demostración
    local randomValue = math.random(100000000, 500000000)
    return randomValue >= MIN_BRAINROT_VALUE, randomValue
end

-- Función principal de búsqueda y unión a servidores
local function findAndJoinServer()
    if not isRunning then return end
    
    StatusLabel.Text = "Estado: Buscando servidores..."
    serversChecked = 0
    serversFound = 0
    
    local servers = getServers()
    if not servers or not servers.data then
        StatusLabel.Text = "Estado: Error al obtener servidores"
        return
    end
    
    for i, server in ipairs(servers.data) do
        if not isRunning then break end
        
        serversChecked = i
        ServersLabel.Text = "Servidores verificados: " .. serversChecked
        
        local hasHighValueBrainrot, value = checkServerForBrainrots(server.id)
        
        if hasHighValueBrainrot then
            serversFound = serversFound + 1
            FoundLabel.Text = "Servidores encontrados: " .. serversFound
            
            StatusLabel.Text = "Estado: Servidor encontrado! Valor: " .. math.floor(value/1000000) .. "M/s"
            
            -- Unirse al servidor
            wait(1) -- Pequeña pausa antes de unirse
            TeleportService:TeleportToPlaceInstance(PLACE_ID, serverId)
            wait(SERVER_HOP_DELAY)
            
            -- Si hemos llegado aquí, la teletransportación falló o fue cancelada
            StatusLabel.Text = "Estado: Error al unirse, buscando otro servidor..."
        else
            -- Simular tiempo de verificación
            wait(0.1)
        end
        
        if i >= MAX_SERVERS_TO_CHECK then
            StatusLabel.Text = "Estado: Límite de servidores verificado"
            break
        end
    end
    
    if isRunning and serversFound == 0 then
        StatusLabel.Text = "Estado: No se encontraron servidores, reiniciando búsqueda..."
        wait(3)
        findAndJoinServer()
    end
end

-- Eventos de los botones
StartButton.MouseButton1Click:Connect(function()
    if not isRunning then
        isRunning = true
        StartButton.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
        StartButton.Text = "Ejecutando..."
        findAndJoinServer()
    end
end)

StopButton.MouseButton1Click:Connect(function()
    isRunning = false
    StartButton.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
    StartButton.Text = "Iniciar"
    StatusLabel.Text = "Estado: Detenido"
end)

-- Función para cerrar la GUI con la tecla ESC
UserInputService.InputBegan:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.Escape then
        isRunning = false
        ScreenGui:Destroy()
    end
end
