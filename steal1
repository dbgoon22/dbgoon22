local function setBase()
    if autoStealActive then
        return
    end

    local character = player.Character

    if not character then
        return
    end

    local hrp = character:FindFirstChild("HumanoidRootPart")

    if not hrp then
        return
    end

    savedBasePosition =
        hrp.Position + Vector3.new(0, 2, 0)

    SetBaseBtn.Text = "Base Saved ✓"

    task.delay(1, function()
        if SetBaseBtn then
            SetBaseBtn.Text = "Set Base Position"
        end
    end)
end

------------------------------------------------------------
-- FLOAT TO BASE
------------------------------------------------------------

local function floatToBase()
    if not savedBasePosition then
        createNotification(
            "Error",
            "Primero guarda una posición de base.",
            3
        )
        return
    end

    floatActive = true

    local character = player.Character

    if not character then
        floatActive = false
        return
    end

    local hrp = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")

    if not hrp or not humanoid then
        floatActive = false
        return
    end

    humanoid:ChangeState(Enum.HumanoidStateType.Freefall)

    FloatBtn.Text = "Floating..."

    local startTime = tick()
    local speed = 40
    local minDistanceToStop = 3

    if floatConnection then
        floatConnection:Disconnect()
    end

    floatConnection = RunService.Heartbeat:Connect(function()
        if not floatActive
            or not hrp
            or not hrp.Parent then

            floatActive = false

            if floatConnection then
                floatConnection:Disconnect()
                floatConnection = nil
            end

            FloatBtn.Text = "Float to Base"
            return
        end

        local currentPos = hrp.Position

        local targetPos = Vector3.new(
            savedBasePosition.X,
            savedBasePosition.Y,
            savedBasePosition.Z
        )

        local directionVector = targetPos - currentPos
        local distance = directionVector.Magnitude

        if distance < minDistanceToStop then
            floatActive = false
            hrp.Velocity = Vector3.new(0, 0, 0)

            floatConnection:Disconnect()
            floatConnection = nil

            FloatBtn.Text = "Float to Base"
            return
        end

        if tick() - startTime > 15 then
            floatActive = false
            hrp.Velocity = Vector3.new(0, 0, 0)

            floatConnection:Disconnect()
            floatConnection = nil

            FloatBtn.Text = "Float to Base"
            return
        end

        local direction = directionVector.Unit

        hrp.Velocity = direction * speed
    end)
end

------------------------------------------------------------
-- AUTO STEAL
------------------------------------------------------------

local function toggleAutoSteal()
    if autoStealCooldown then
        return
    end

    if not savedBasePosition then
        createNotification(
            "Error",
            "Primero guarda la posición de tu base.",
            3
        )
        return
    end

    autoStealActive = not autoStealActive

    AutoStealBtn.Text =
        "Auto Steal: " ..
        (autoStealActive and "ON" or "OFF")

    AutoStealBtn.BackgroundColor3 =
        autoStealActive
        and Color3.fromRGB(50, 120, 50)
        or Color3.fromRGB(70, 70, 70)

    if autoStealConnection then
        autoStealConnection:Disconnect()
        autoStealConnection = nil
    end

    if not autoStealActive then
        if autoStealTimer then
            task.cancel(autoStealTimer)
            autoStealTimer = nil
        end

        autoStealCooldown = false
        return
    end

    autoStealCooldown = true

    disableAllFunctions()

    local character = player.Character

    if not character then
        autoStealActive = false
        AutoStealBtn.Text = "Auto Steal: OFF"
        AutoStealBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
        autoStealCooldown = false
        return
    end

    local hrp = character:FindFirstChild("HumanoidRootPart")

    if not hrp then
        autoStealActive = false
        AutoStealBtn.Text = "Auto Steal: OFF"
        AutoStealBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
        autoStealCooldown = false
        return
    end

    savedHeight = hrp.Position.Y

    -- Subir temporalmente
    local targetPosition =
        hrp.Position + Vector3.new(0, 200, 0)

    hrp.CFrame = CFrame.new(targetPosition)

    task.wait(1)

    -- Moverse hacia la base desde arriba
    local originalBase = savedBasePosition

    savedBasePosition = Vector3.new(
        originalBase.X,
        hrp.Position.Y,
        originalBase.Z
    )

    floatToBase()

    autoStealTimer = task.delay(15, function()
        if autoStealActive then
            autoStealActive = false
            floatActive = false

            if floatConnection then
                floatConnection:Disconnect()
                floatConnection = nil
            end
        end
    end)

    while floatActive do
        task.wait()
    end

    if hrp and hrp.Parent then
        local currentPos = hrp.Position

        local finalPosition = Vector3.new(
            currentPos.X,
            savedHeight,
            currentPos.Z
        )

        hrp.CFrame = CFrame.new(finalPosition)
    end

    savedBasePosition = originalBase

    autoStealActive = false

    AutoStealBtn.Text = "Auto Steal: OFF"
    AutoStealBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 70)

    autoStealCooldown = false
    autoStealTimer = nil
end

