--  LÓGICA
-- ══════════════════════════════════════

local function getChar()
    return player.Character or player.CharacterAdded:Wait()
end

local function getHumanoid()
    local char = getChar()
    return char:FindFirstChildOfClass("Humanoid")
end

-- Aplicar velocidad
SpeedBtn.MouseButton1Click:Connect(function()
    local val = tonumber(SpeedSlider.Text)
    if val and val > 0 and val <= 500 then
        local hum = getHumanoid()
        if hum then
            hum.WalkSpeed = val
            SpeedStatus.Text = "Activo: " .. val
            SpeedStatus.TextColor3 = Color3.fromRGB(100, 220, 130)
        end
    else
        SpeedStatus.Text = "1-500"
        SpeedStatus.TextColor3 = Color3.fromRGB(255, 80, 80)
    end
end)

-- Aplicar salto
JumpBtn.MouseButton1Click:Connect(function()
    local val = tonumber(JumpSlider.Text)
    if val and val > 0 and val <= 1000 then
        local hum = getHumanoid()
        if hum then
            hum.JumpPower = val
            JumpStatus.Text = "Activo: " .. val
            JumpStatus.TextColor3 = Color3.fromRGB(100, 220, 130)
        end
    else
        JumpStatus.Text = "1-1000"
        JumpStatus.TextColor3 = Color3.fromRGB(255, 80, 80)
    end
end)

-- Mantener stats al respawnear
player.CharacterAdded:Connect(function(char)
    local hum = char:WaitForChild("Humanoid")
    local spd = tonumber(SpeedSlider.Text)
    local jmp = tonumber(JumpSlider.Text)
    if spd then hum.WalkSpeed = spd end
    if jmp then hum.JumpPower = jmp end
end)

-- Toggle Y
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.Y then
        gui_visible = not gui_visible
        MainFrame.Visible = gui_visible
    end
end)
