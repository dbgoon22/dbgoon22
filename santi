-- helpers
----------------------------------------------------------------
local function setStatus(txt, color)
    Status.Text = txt
    if color then Status.TextColor3 = color end
end

local function addRecent(jobId)
    table.insert(recentJobs, 1, jobId)
    if #recentJobs > MAX_RECENT then table.remove(recentJobs) end
end

local function isRecent(jobId)
    for _, id in ipairs(recentJobs) do
        if id == jobId then return true end
    end
    return false
end

local VALUE_NAMES = {
    "PricePerSecond", "Value", "Income", "Generation", "CashPerSecond",
    "MoneyPerSecond", "Earn", "Rate", "IncomePerSecond", "Cash", "Money", "Gen"
}

local function hasIncomeSignal(obj)
    for _, name in ipairs(VALUE_NAMES) do
        local v = obj:FindFirstChild(name, true)
        if v and (v:IsA("NumberValue") or v:IsA("IntValue") or v:IsA("StringValue")) then
            return true
        end
    end
    for _, d in ipairs(obj:GetDescendants()) do
        if d:IsA("BillboardGui") or d:IsA("TextLabel") then
            local t = string.lower(tostring(d.Text or ""))
            if t:find("/s") or t:find("m/s") or t:find("k/s") or t:find("b/s") or t:find("/sec") then
                return true
            end
        end
    end
    return false
end

local function exactOrStrictMatch(name)
    local lower = string.lower(name)
    if TARGET_SET[lower] then return TARGET_SET[lower] end
    for key, original in pairs(TARGET_SET) do
        if #key >= 6 and lower:find(key, 1, true) then
            return original
        end
    end
    return nil
end

local function collectCandidates()
    local roots = {}
    -- estructura real de SAB: Bases / Plots / player bases
    for _, name in ipairs({"Bases", "Plots", "Brains", "Animals", "Units", "Brainrots", "Pets"}) do
        local f = workspace:FindFirstChild(name)
        if f then table.insert(roots, f) end
    end
    -- también bases individuales de jugadores
    for _, plr in ipairs(Players:GetPlayers()) do
        local base = workspace:FindFirstChild(plr.Name) or workspace:FindFirstChild(plr.Name .. "'s Base")
        if base then table.insert(roots, base) end
    end
    if #roots == 0 then
        table.insert(roots, workspace)
    end
    return roots
end

local function scanServer()
    local found, seen = {}, {}

    local function consider(obj)
        if not (obj:IsA("Model") or obj:IsA("BasePart") or obj:IsA("Folder")) then return end
        local match = exactOrStrictMatch(obj.Name)
        if not match or seen[match] then return end

        local inBase = false
        local p = obj.Parent
        while p and p ~= workspace do
            local pn = string.lower(p.Name)
            if pn:find("base") or pn:find("plot") or pn:find("podium") or pn:find("slot") or pn:find("stand") or pn:find("floor") then
                inBase = true
                break
            end
            p = p.Parent
        end

        if hasIncomeSignal(obj) or inBase then
            seen[match] = true
            table.insert(found, match)
        end
    end

    for _, root in ipairs(collectCandidates()) do
        for _, obj in ipairs(root:GetDescendants()) do
            consider(obj)
        end
        for _, child in ipairs(root:GetChildren()) do
            consider(child)
        end
    end
    return found
end

-- quick bot check after join: muchos jugadores con displayName default / bajo movimiento = farm
local function looksLikeBotServer()
    local count = 0
    local botScore = 0
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            count += 1
            local name = string.lower(plr.DisplayName or plr.Name)
            -- patrones típicos de bots en SAB
            if name:find("player") or name:find("user") or name:match("^%w+%d+$") then
                botScore += 1
            end
            local char = plr.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum and hum.MoveDirection.Magnitude < 0.05 then
                    botScore += 0.4
                end
            end
        end
    end
    if count == 0 then return true end
    return (botScore / count) > 0.65
end

----------------------------------------------------------------
-- server list (correcto para max 8)
----------------------------------------------------------------
local function getServers(maxPages)
    maxPages = maxPages or 10
    local servers = {}
    local cursor = ""
    local pages = 0

    while pages < maxPages do
        pages += 1
        local url = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Desc&limit=100"
        if cursor ~= "" then
            url = url .. "&cursor=" .. HttpService:UrlEncode(cursor)
        end

        local ok, data = pcall(function()
            return HttpService:JSONDecode(game:HttpGet(url))
        end)

        if not ok or type(data) ~= "table" or not data.data then break end

        for _, s in ipairs(data.data) do
            if s.playing and s.maxPlayers and s.id
                and s.playing >= MIN_PLAYERS
                and s.playing < MAX_PLAYERS
                and s.id ~= game.JobId
                and not isRecent(s.id)
            then
                table.insert(servers, {
                    id = s.id,
                    playing = s.playing,
                    max = s.maxPlayers or MAX_PLAYERS
                })
            end
        end

        if not data.nextPageCursor or data.nextPageCursor == "" then break end
        cursor = data.nextPageCursor
        task.wait(0.1)
    end

    -- score: 5-7 es la zona real. 3-4 es aceptable. full se descarta ya.
    table.sort(servers, function(a, b)
        local function score(s)
            if s.playing >= PREFER_MIN and s.playing <= PREFER_MAX then
                return 1000 + s.playing
            end
            return s.playing * 10
        end
        return score(a) > score(b)
    end)

    return servers
end

