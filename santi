local function waitForLoad(timeout)
    timeout = timeout or 18
    local t0 = tick()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    if not char:WaitForChild("HumanoidRootPart", 9) then return false end

    while tick() - t0 < timeout do
        local has = workspace:FindFirstChild("Bases")
            or workspace:FindFirstChild("Plots")
            or #workspace:GetChildren() > 12
        if has then
            task.wait(2.8)
            return true
        end
        task.wait(0.3)
    end
    return false
end

local function hop()
    if hopping then return end
    hopping = true
    setStatus("Buscando servidores reales (3-7 jugadores)...", Color3.fromRGB(255, 200, 80))

    local servers = getServers(10)
    if #servers == 0 then
        setStatus("Sin servidores válidos. Reintento en 5s...", Color3.fromRGB(255, 120, 120))
        hopping = false
        task.wait(5)
        return
    end

    local target = servers[1]
    setStatus(string.format("Hop → %d/%d jugadores", target.playing, target.max), Color3.fromRGB(255, 200, 80))
    addRecent(target.id)

    local ok, err = pcall(function()
        TeleportService:TeleportToPlaceInstance(PlaceId, target.id, LocalPlayer)
    end)
    if not ok then
        setStatus("Teleport falló: " .. tostring(err), Color3.fromRGB(255, 100, 100))
        task.wait(2)
        pcall(function()
            TeleportService:TeleportToPlaceInstance(PlaceId, target.id, LocalPlayer)
        end)
    end
    hopping = false
end

local function checkCurrentServer()
    if not waitForLoad(16) then
        setStatus("Carga incompleta → hop", Color3.fromRGB(255, 160, 80))
        return false
    end

    -- anti-bot post-join
    if looksLikeBotServer() then
        setStatus("Server de bots detectado → saltando", Color3.fromRGB(255, 140, 80))
        return false
    end

    local found = scanServer()
    if #found > 0 then
        foundSomething = true
        autoJoin = false
        AutoBtn.Text = "Auto Join: OFF"
        AutoBtn.BackgroundColor3 = Color3.fromRGB(36, 36, 44)

        local list = table.concat(found, ", ")
        setStatus("¡ENCONTRADO!\n" .. list, Color3.fromRGB(80, 255, 130))

        local notif = Instance.new("TextLabel")
        notif.Size = UDim2.new(0, 420, 0, 70)
        notif.Position = UDim2.new(0.5, -210, 0.12, 0)
        notif.BackgroundColor3 = Color3.fromRGB(16, 50, 26)
        notif.Text = "BRAINROT DETECTADO\n" .. list
        notif.TextColor3 = Color3.fromRGB(110, 255, 140)
        notif.Font = Enum.Font.GothamBold
        notif.TextSize = 15
        notif.TextWrapped = true
        notif.Parent = ScreenGui
        Instance.new("UICorner", notif).CornerRadius = UDim.new(0, 8)
        task.delay(12, function() if notif then notif:Destroy() end end)
        return true
    end
    return false
end

