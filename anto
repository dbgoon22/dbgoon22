local function addFoundServer(jobId, maxVal, players, maxPlayers)
    for _, s in ipairs(getgenv().SAB_Finder.FoundServers) do
        if s.id == jobId then
            s.maxVal = math.max(s.maxVal, maxVal)
            return
        end
    end
    table.insert(getgenv().SAB_Finder.FoundServers, {
        id = jobId,
        maxVal = maxVal,
        players = players or 0,
        maxPlayers = maxPlayers or 8
    })
    table.sort(getgenv().SAB_Finder.FoundServers, function(a, b) return a.maxVal > b.maxVal end)
    refreshListUI()
end

-- AutoJoin loop: scan current → if 100M+ keep & list; else hop
local hopIndex = 1
local serverCache = {}

autoBtn.MouseButton1Click:Connect(function()
    getgenv().SAB_Finder.AutoJoin = not getgenv().SAB_Finder.AutoJoin
    autoBtn.Text = "Finder AutoJoin: " .. (getgenv().SAB_Finder.AutoJoin and "ON" or "OFF")
    autoBtn.BackgroundColor3 = getgenv().SAB_Finder.AutoJoin and Color3.fromRGB(40, 120, 60) or Color3.fromRGB(50, 50, 70)
    if getgenv().SAB_Finder.AutoJoin then
        status.Text = "escaneando + hopping..."
        task.spawn(function()
            while getgenv().SAB_Finder.AutoJoin do
                local maxV, hits = scanCurrentServer()
                if maxV >= MIN_VALUE then
                    status.Text = "HIT " .. formatVal(maxV) .. "/s en este server"
                    addFoundServer(game.JobId, maxV, #Players:GetPlayers(), 8)
                    -- se queda; no hop
                    task.wait(3)
                else
                    status.Text = "sin 100M+ aquí → hop"
                    if #serverCache == 0 or hopIndex > #serverCache then
                        serverCache = fetchPublicServers()
                        hopIndex = 1
                        if #serverCache == 0 then
                            status.Text = "sin servers públicos, reintento..."
                            task.wait(4)
                        end
                    end
                    if serverCache[hopIndex] then
                        local target = serverCache[hopIndex]
                        hopIndex += 1
                        pcall(function()
                            TS:TeleportToPlaceInstance(PLACE_ID, target.id, LP)
                        end)
                        task.wait(6) -- wait teleport / load
                    else
                        task.wait(2)
                    end
                end
                task.wait(0.5)
            end
            status.Text = "AutoJoin off"
        end)
    end
end)

