local function formatVal(n)
    if n >= 1e9 then return string.format("%.2fB", n / 1e9) end
    if n >= 1e6 then return string.format("%.1fM", n / 1e6) end
    if n >= 1e3 then return string.format("%.0fK", n / 1e3) end
    return tostring(n)
end

-- parse income from NumberValue / StringValue / Billboard / Name
local function extractValue(obj)
    local v = 0
    local function tryNum(x)
        if typeof(x) == "number" then return x end
        if typeof(x) == "string" then
            local s = x:lower():gsub(",", ""):gsub("%$", ""):gsub("/s", ""):gsub("%s", "")
            local mul = 1
            if s:find("b") then mul = 1e9; s = s:gsub("b", "") end
            if s:find("m") then mul = 1e6; s = s:gsub("m", "") end
            if s:find("k") then mul = 1e3; s = s:gsub("k", "") end
            local n = tonumber(s)
            return n and n * mul or 0
        end
        return 0
    end

    for _, d in ipairs(obj:GetDescendants()) do
        if d:IsA("NumberValue") or d:IsA("IntValue") then
            local n = d.Value
            if n >= MIN_VALUE then return n end
            if n > v then v = n end
        elseif d:IsA("StringValue") then
            local n = tryNum(d.Value)
            if n >= MIN_VALUE then return n end
            if n > v then v = n end
        elseif d:IsA("TextLabel") or d:IsA("TextButton") then
            local n = tryNum(d.Text)
            if n >= MIN_VALUE then return n end
            if n > v then v = n end
        end
    end
    -- fallback: name / attribute
    local attr = obj:GetAttribute("Income") or obj:GetAttribute("Value") or obj:GetAttribute("Generation")
    if attr then
        local n = tryNum(attr)
        if n > v then v = n end
    end
    return v
end

local function scanCurrentServer()
    local maxV = 0
    local found = {}
    local roots = {}
    for _, name in ipairs({"Plots", "Bases", "PlotsFolder", "PlayerPlots"}) do
        local f = workspace:FindFirstChild(name)
        if f then table.insert(roots, f) end
    end
    if #roots == 0 then
        for _, c in ipairs(workspace:GetChildren()) do
            if c:IsA("Folder") or c:IsA("Model") then
                if c:FindFirstChild("AnimalPodiums") or c.Name:lower():find("plot") or c.Name:lower():find("base") then
                    table.insert(roots, c)
                end
            end
        end
    end

    for _, root in ipairs(roots) do
        for _, plot in ipairs(root:GetChildren()) do
            local pods = plot:FindFirstChild("AnimalPodiums") or plot:FindFirstChild("Podiums") or plot
            for _, pod in ipairs(pods:GetChildren()) do
                local val = extractValue(pod)
                if val >= MIN_VALUE then
                    maxV = math.max(maxV, val)
                    table.insert(found, {obj = pod, value = val, plot = plot.Name})
                end
            end
            -- también modelos sueltos con Value
            for _, d in ipairs(plot:GetDescendants()) do
                if d:IsA("Model") and (d:FindFirstChild("Value") or d:FindFirstChild("Income") or d:FindFirstChild("Generation")) then
                    local val = extractValue(d)
                    if val >= MIN_VALUE then
                        maxV = math.max(maxV, val)
                        table.insert(found, {obj = d, value = val, plot = plot.Name})
                    end
                end
            end
        end
    end
    return maxV, found
end

local function fetchPublicServers()
    local list = {}
    local cursor = ""
    local pages = 0
    while pages < 5 do
        local url = ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100"):format(PLACE_ID)
        if cursor ~= "" then url = url .. "&cursor=" .. cursor end
        local ok, body = pcall(function()
            return game:HttpGet(url)
        end)
        if not ok or not body then break end
        local data = HS:JSONDecode(body)
        if not data or not data.data then break end
        for _, s in ipairs(data.data) do
            if s.id ~= game.JobId and s.playing < (s.maxPlayers or 8) then
                table.insert(list, {
                    id = s.id,
                    players = s.playing or 0,
                    maxPlayers = s.maxPlayers or 8,
                    ping = s.ping or 0
                })
            end
        end
        cursor = data.nextPageCursor
        if not cursor or cursor == "" then break end
        pages += 1
        task.wait(0.15)
    end
    return list
end

